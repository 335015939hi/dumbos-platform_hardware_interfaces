      "lineNbr": 79,
      "author": {
        "id": 1074459
      },
      "writtenOn": "2016-10-13T23:32:14Z",
      "side": 1,
      "message": "Ah. That\u0027s much cleaner. I didn\u0027t know about std::tie.",
      "parentUuid": "3c193e0f_9a10a966",
      "range": {
        "startLine": 79,
        "startChar": 34,
        "endLine": 79,
        "endChar": 38
