package android.hardware.biometrics.fingerprint@2.2;

import android.hardware.biometrics.fingerprint@2.1;

interface IBiometricsFingerprint extends @2.1::IBiometricsFingerprint{
    /**
    * sendCommand:
    * send customized command with extras to hal vendor
    * @param command the command early agreement with vendor
    * @param extras the param early agreement with vendor
    *
    * @return ret is a value of vendor defined.
    */
    @callflow(next={"authenticate", "preEnroll", "enumerate", "remove", "cancel", "enroll", "postEnroll"})
    sendCommand ( uint32_t command, uint32_t extras) generates (uint32_t ret);
};
