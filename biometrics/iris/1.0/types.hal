package android.hardware.biometrics.iris@1.0;

/**
 * Request status indicates whether the request is accepted by the vendor
 * implementation or not. These values are taken from the errno set,
 * except for the SYS_UNKNOWN
 */
enum RequestStatus : int32_t {
  SYS_UNKNOWN = 1,
  SYS_OK = 0,
  SYS_ENOENT = -2,
  SYS_EINTR = -4,
  SYS_EIO = -5,
  SYS_EAGAIN = -11,
  SYS_ENOMEM = -12,
  SYS_EACCES = -13,
  SYS_EFAULT = -14,
  SYS_EBUSY = -16,
  SYS_EINVAL = -22,
  SYS_ENOSPC = -28,
  SYS_ETIMEDOUT = -110,
};

/**
 * Iris errors are meant to tell the framework to terminate the current
 * operation and ask for the user to correct the situation. These will almost
 * always result in messaging and user interaction to correct the problem.
 *
 * For example, ERROR_CANCELED should follow any acquisition message that
 * results in a situation where the current operation can't continue without
 * user interaction. For example, if the sensor is covered during enrollment
 * and no further enrollment progress can be made, send ACQUIRED_TOO_DARK
 * followed by ERROR_CANCELED.
 */
enum IrisError : int32_t {
  /** Used for testing, no error returned */
  ERROR_NO_ERROR = 0,
  /** The hardware has an error that can't be resolved. */
  ERROR_HW_UNAVAILABLE = 1,
  /** Bad data; operation can't continue */
  ERROR_UNABLE_TO_PROCESS = 2,
  /** The operation has timed out waiting for user input. */
  ERROR_TIMEOUT = 3,
  /** No space available to store a template */
  ERROR_NO_SPACE = 4,
  /** The current operation has been canceled */
  ERROR_CANCELED = 5,
  /** Unable to remove a template */
  ERROR_UNABLE_TO_REMOVE = 6,
  /** The hardware is in lockout due to too many attempts */
  ERROR_LOCKOUT = 7,
  /** Vendor-specific error message */
  ERROR_VENDOR = 8
};

/**
 * Iris acquisition info is meant as feedback for the current operation.
 * Anything but ACQUIRED_GOOD, ACQUIRED_DETECTED_ONE_EYE and
 * ACQUIRED_DETECTED_TWO_EYES must be shown to the user as feedback on how to
 * take action on the current operation. For example, ACQUIRED_TOO_DARK may
 * be used to tell the user to not cover the sensor or the light source.
 * If this causes the current operation to fail, an additional ERROR_CANCELED
 * must be sent to stop the operation in progress (e.g. enrollment).
 * In general, these messages will result in a "Try again" message.
 */
enum IrisAcquiredInfo : int32_t {
  ACQUIRED_GOOD = 0,
  /** image doesn't contain enough detail for recognition */
  ACQUIRED_INSUFFICIENT = 1,
  /** too much ambient light (e.g. sunlight) */
  ACQUIRED_TOO_BRIGHT = 2,
  /** illumination light obscured */
  ACQUIRED_TOO_DARK = 3,
  /** move further to capture good image */
  ACQUIRED_TOO_CLOSE = 4,
  /** move closer to capture good image */
  ACQUIRED_TOO_FAR = 5,
  /** face is visible, but the eyes can't be found. open eyes to capture good
   * image */
  ACQUIRED_EYES_CLOSED = 6,
  /** eyes are visible, but doesn't contain enough detail. open eyes wider to
   * capture good image */
  ACQUIRED_EYES_PARTIALLY_OBSCURED = 7,
  /** current operation is completed with one eye, ACQUIRED_GOOD must be sent
   * after this */
  ACQUIRED_DETECTED_ONE_EYE = 8,
  /** current operation is completed with two eye, ACQUIRED_GOOD must be sent
   * after this */
  ACQUIRED_DETECTED_TWO_EYES = 9,
  /** more than two irises found (i.e. someone else in the field of view,
   * reflections, etc.) */
  ACQUIRED_DETECTED_TOO_MANY_EYES = 10,
  /** vendor-specific acquisition messages */
  ACQUIRED_VENDOR = 11
};

struct IrisId {
  /** Group ID */
  uint32_t gid;
  /** Iris template ID */
  uint32_t id;
};

struct IrisEnroll {
  /** Template ID */
  IrisId iris;
  /**
   * percentRemaining starts at an arbitrary number like 100 or 1000 and
   * decrement to 0, possibly non-uniformly if substantial progress is made. As
   * long as the iris(es) are visible and progress is being made to completion,
   * the number is expected to decrement so an enrollment UI can show a visible
   * progress indicator. It will stop if the iris(es) go out of view or don't
   * have sufficient detail - in which case ACQUIRED or ERROR messages should
   * be sent, indicating an action the user needs to take. */
  uint32_t percentRemaining;
  /** Vendor specific message. Used for user guidance */
  uint64_t msg;
};

struct IrisIterator {
  /** Template ID */
  IrisId iris;
  /** How many templates remain to iterate through */
  uint32_t remainingTemplates;
};

typedef IrisIterator IrisEnumerated;
typedef IrisIterator IrisRemoved;

struct IrisAcquired {
  /** information about the image */
  IrisAcquiredInfo acquiredInfo;
};

struct IrisAuthenticated {
  /** Matched template ID */
  IrisId iris;
  /** Authentication result from the keymaster */
  uint8_t[69] hat;
};

/** Run time type identification for the notify() call payload. */
enum IrisMsgType : int32_t {
  ERROR = -1,
  ACQUIRED = 1,
  TEMPLATE_ENROLLING = 3,
  TEMPLATE_REMOVED = 4,
  AUTHENTICATED = 5,
  TEMPLATE_ENUMERATING = 6,
};

