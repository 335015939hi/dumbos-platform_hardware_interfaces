package android.hardware.biometrics.iris@1.0;

/* This HAL interface communicates asynchronous results from the
   iris driver in response to user actions on the iris sensor
*/
interface IBiometricsIrisClientCallback {
    /**
     * Sent when one enrollment step is complete.
     * @param deviceId the instance of this iris device
     * @param irisId the iris templetate being enrolled
     * @param groupId the groupid for the template being enrolled
     * @param remaining the number of remaining steps before enrolllment is complete
     */
    oneway onEnrollResult(uint64_t deviceId, uint32_t irisId, uint32_t groupId, uint32_t remaining);

    /**
     * Sent when a iris image is acquired by the sensor
     * @param deviceId the instance of this iris device
     * @param acquiredInfo a message about the quality of the acquired image
     * @param vendorCode a vendor-specific message about the quality of the image. Only
     *        valid when acquiredInfo == ACQUIRED_VENDOR
     */
    oneway onAcquired(uint64_t deviceId, IrisAcquiredInfo acquiredInfo, int32_t vendorCode);

    /**
     * Sent when a iris is authenticated
     * @param deviceId the instance of this iris device
     * @param irisId the iris templetate that was authenticated
     * @param groupId the groupid for the template that was authenticated
     * @param token the hardware authentication token to pass to Keystore.addAuthToken()
     */
    oneway onAuthenticated(uint64_t deviceId, uint32_t irisId, uint32_t groupId, vec<uint8_t> token);

    /**
     * Sent when a iris error occurs
     * @param deviceId the instance of this iris device
     * @param error a message about the error that occurred
     * @param vendorCode a vendor-speicifc error message. Only valid
     *        when error == ERROR_VENDOR
     */
    oneway onError(uint64_t deviceId, IrisError error, int32_t vendorCode);

    /**
     * Sent when one template is removed
     * @param deviceId the instance of this iris device
     * @param irisId the iris templetate being removed
     * @param groupId the groupid for the template being removed
     * @param remaining the number of remaining templates that will be removed.
     */
    oneway onRemoved(uint64_t deviceId, uint32_t irisId, uint32_t groupId, uint32_t remaining);

    /**
     * Sent when one iris template is enumerated
     * @param deviceId the instance of this iris device
     * @param irisId the iris for this templetate
     * @param groupId the groupid for this template
     * @param remaining the number of remaining steps before enumeration is complete
     */
    oneway onEnumerate(uint64_t deviceId, uint32_t irisId, uint32_t groupId, uint32_t remaining);
};
