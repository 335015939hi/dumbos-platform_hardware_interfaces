package android.hardware.biometrics.face_authentication@1.0;

/* This HAL interface communicates asynchronous results from the face authentication
   driver in response to user actions in front the face authentication sensor
*/
interface IBiometricsFaceClientCallback {
    /**
     * Sent when one enrollment step is complete.
     * @param deviceId the instance of this face device
     * @param enroll information about current enrollment request
     */
    oneway onEnrollResult(uint64_t deviceId, FaceEnroll enrollResult);


    /**
     * Sent when a face image is acquired by the sensor
     * @param deviceId the instance of this face authentication device
     * @param acquiredInfo a message about the quality of the acquired image
     * @param vendorCode a vendor-specific message about the quality of the image. Only
     *        valid when acquiredInfo == ACQUIRED_VENDOR
     */
    oneway onAcquired(uint64_t deviceId, FaceAcquiredInfo acquiredInfo, int32_t vendorCode);

    /**
     * Sent when a face is authenticated
     * @param deviceId the instance of this face authentication device
     * @param success indication on whether this authentication was successful
     * @param token the hardware authentication token to pass to Keystore.addAuthToken()
     */
    oneway onAuthenticated(uint64_t deviceId, bool success, vec<uint8_t> token);

    /**
     * Sent when a face error occurs
     * @param deviceId the instance of this face device
     * @param error a message about the error that occurred
     * @param vendorCode a vendor-speicifc error message. Only valid
     *        when error == ERROR_VENDOR
     */
    oneway onError(uint64_t deviceId, FaceError error, int32_t vendorCode);

    /**
     * Sent when one template is removed
     * @param deviceId the instance of this face authentication device
     */
    oneway onRemoved(uint64_t deviceId);
};
