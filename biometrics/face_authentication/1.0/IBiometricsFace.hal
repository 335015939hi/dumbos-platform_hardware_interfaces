package android.hardware.biometrics.face_authentication@1.0;

import IBiometricsFaceClientCallback;

interface IBiometricsFace {
  /**
   * Set notification callback:
   * Registers a user function that must receive notifications from the HAL
   * This call must block if the HAL state machine is in busy state until HAL
   * leaves the busy state.
   *
   * @return deviceId is a unique handle for this face authentication device
   */
  @callflow(next={"setActiveUser"})
  @entry
  setCallback(IBiometricsFaceClientCallback clientCallback)
      generates (uint64_t deviceId);

  /**
   * Face pre-enroll enroll request:
   * Generates a unique token to upper layers to indicate the start of
   * an enrollment transaction. pre-enroll and post-enroll specify
   * a pin/password cleared time window where enrollment is allowed.
   * Pre-enroll only generates a challenge, a full hardwareAuthToken is
   * generated by trustzone after verifying a pin/password/swipe. This is to
   * ensure adding a face template was preceded by some kind of
   * credential confirmation (e.g. device password).
   *
   * @return 0 if function failed, a uint64_t of challenge otherwise.
   */
  @callflow(next={"enroll", "postEnroll"})
  preEnroll() generates (uint64_t authChallenge);

  /**
   * Face enroll request:
   * Switches the HAL state machine to collect and store a new face
   * template. Switches back as soon as enroll is complete, signalled by
   * (faceMsg.type == FACE_TEMPLATE_ENROLLING &&
   *  faceMsg.data.enroll.samplesRemaining == 0)
   * or after timeoutSec seconds.
   * The face template must be assigned to the user's uid.
   *
   * @param hat a valid Hardware Authentication Token (HAT), generated
   * as a result of a preEnroll() call.
   * @param uid a framework defined face user id.
   * @param timeoutSec a timeout in seconds.
   *
   * @return debugErrno is a value the framework logs in case it is not 0.
   *
   * A notify() function may be called with a more detailed error structure.
   */
  @callflow(next={"cancel", "enroll", "postEnroll", "remove"})
  enroll(uint8_t[69] hat, uint32_t uid, uint32_t timeoutSec)
      generates (RequestStatus debugErrno);

  /**
   * Finishes the enroll operation and invalidates the preEnroll() generated
   * challenge. This must be called at the end of a face enrollment
   * session to indicate that a face was enrolled.
   *
   * @return debugErrno is a value the framework logs in case it is not 0.
   */
  @callflow(next={"authenticate", "setActiveUser", "remove"})
  postEnroll() generates (RequestStatus debugErrno);

  /**
   * getAuthenticatorId:
   * Returns a token associated with the current face.
   *
   * @return getAuthenticatorIdRet current authenticator id, 0 if function
   * failed.
   */
  @callflow(next={"authenticate"})
  getAuthenticatorId() generates (uint64_t AuthenticatorId);

  /**
   * Cancel pending enroll or authenticate, sending FACE_ERROR_CANCELED
   * to all running clients. Switches the HAL state machine back to the idle
   * state. Unlike enrollDone() doesn't invalidate the preEnroll() challenge.
   *
   * @return debugErrno is a value the framework logs in case it is not 0.
   */
  @callflow(next={"authenticate", "enroll", "remove",
    "setActiveUser"})
  cancel() generates (RequestStatus debugErrno);

  /**
   * Face remove request:
   * Deletes face template.
   * Works only within the path set by setActiveUser().
   * notify() must be called with:
   * faceMsg.type == FACE_TEMPLATE_REMOVED
   * faceMsg.data.removed.face indicating the template id deleted
   *
   * @param uid user id must match the last group (user) set by setActiveUser().
   *
   * @return debugErrno is a value the framework logs in case it is not 0.
   */
  @callflow(next={"authenticate", "cancel", "getAuthenticatorId", "setActiveUser"})
  remove(uint32_t uid) generates (RequestStatus debugErrno);

  /**
   * Restricts the HAL operation to a face belonging to a provided user.
   * The caller must provide a path to a storage location within the
   * user's data directory.
   *
   * @param uid the face user id.
   * @param storePath filesystem path to the template storage directory.
   *
   * @return debugErrno is a value the framework logs in case it is not 0.
   */
  @callflow(next={"authenticate", "preEnroll", "remove"})
  setActiveUser(uint32_t uid, string storePath)
      generates (RequestStatus debugErrno);

  /**
   * Authenticates an operation identified by operationId
   *
   * @param operationId operation id.
   * @param uid face user id.
   *
   * @return debugErrno is a value the framework logs in case it is not 0.
   */
  @callflow(next={"cancel", "preEnroll", "remove"})
  authenticate(uint64_t operationId, uint32_t uid)
      generates (RequestStatus debugErrno);
};
