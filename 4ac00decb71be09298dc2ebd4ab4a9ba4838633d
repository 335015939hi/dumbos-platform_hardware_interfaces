      "writtenOn": "2016-10-06T16:22:18Z",
      "side": 1,
      "message": "Are we guaranteed uniqueness (or is that a requirement)?\n\nI.e. is it possible that \u0027wlan0\u0027 will be both a STA and something else?",
      "range": {
        "startLine": 242,
        "startChar": 14,
        "endLine": 242,
        "endChar": 27
      },
      "revId": "4ac00decb71be09298dc2ebd4ab4a9ba4838633d",
