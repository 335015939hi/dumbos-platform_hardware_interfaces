      "writtenOn": "2016-10-11T23:32:14Z",
      "side": 1,
      "message": "Yep. failure will trigger |IWifiEventCallback.onFailure| at which point all the objects are considered invalid.",
      "parentUuid": "9f7dbc55_53847b47",
      "range": {
        "startLine": 172,
        "startChar": 28,
        "endLine": 172,
