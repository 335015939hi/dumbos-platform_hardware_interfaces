apex_key {
    name: "com.android.vibrator.default.key",
    public_key: "com.android.vibrator.default.avbpubkey",
    private_key: "com.android.vibrator.default.pem",
}

android_app_certificate {
    name: "com.android.vibrator.default.certificate",
    certificate: "com.android.vibrator.default",
}

prebuilt_etc {
    name: "android.hardware.vibrator-service.example.rc",
    src: "android.hardware.vibrator-service.example.rc",
    installable: false,
}

apex {
    name: "com.android.vibrator.default",
    manifest: "apex_manifest.json",
    key: "com.android.vibrator.default.key",
    certificate: ":com.android.vibrator.default.certificate",
    file_contexts: "file_contexts",
    use_vndk_as_stable: true,
    updatable: false,

    // Install the apex in /vendor/apex
    proprietary: true,

    // BEGIN of apex payloads
    binaries: [
        // /bin
        "android.hardware.vibrator-service.example",
    ],
    prebuilts: [
        // /etc
        "android.hardware.vibrator-service.example.rc",
    ],
    // END of apex payloads

    // BEGIN of companion files
    // vintf manifest fragments, which is installed in /vendor/etc/vintf.
    // TODO(b/130058564): should we put vintf framgments within the apex?
    vintf_fragments: [
        "android.hardware.vibrator-service.example.xml",
    ],
    // END of companion files
}
