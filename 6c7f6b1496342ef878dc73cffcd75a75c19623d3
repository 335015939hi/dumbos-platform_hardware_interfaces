        "id": 1942645
      },
      "writtenOn": "2024-11-08T18:47:24Z",
      "side": 1,
      "message": "No, it will be a limited number of clients (KM, authenticators, etc.). Are you OK with using the name `KEYMINT_SHARED_HMAC_KEY` for this key @paulcrowley@google.com @swillden@google.com @armellel@google.com?",
      "parentUuid": "d4c10bd8_e1320914",
      "revId": "6c7f6b1496342ef878dc73cffcd75a75c19623d3",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
