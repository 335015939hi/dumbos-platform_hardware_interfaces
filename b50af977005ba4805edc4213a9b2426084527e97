    {
      "key": {
        "uuid": "9da28751_9c51071d",
        "filename": "radio/1.5/types.hal",
        "patchSetId": 4
      },
      "lineNbr": 430,
      "author": {
        "id": 1060151
      },
      "writtenOn": "2020-01-07T17:57:53Z",
      "side": 1,
      "message": "CS_SERVICE is whether you are allowed to register / be in-service on a cell. This is most traditional barring type, where you are just not allowed to use a cell.\n\nCS_VOICE is barring for placing voice calls.",
      "parentUuid": "2266f712_fc857abd",
      "range": {
        "startLine": 430,
        "startChar": 0,
        "endLine": 430,
        "endChar": 13
      },
      "revId": "b50af977005ba4805edc4213a9b2426084527e97",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
