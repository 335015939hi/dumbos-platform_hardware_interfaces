      "writtenOn": "2020-01-07T17:36:00Z",
      "side": 1,
      "message": "What\u0027s the difference between CS_VOICE and CS_SERVICE?",
      "range": {
        "startLine": 430,
        "startChar": 0,
        "endLine": 430,
        "endChar": 13
      },
      "revId": "b50af977005ba4805edc4213a9b2426084527e97",
