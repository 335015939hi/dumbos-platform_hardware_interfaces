      "writtenOn": "2022-11-15T00:57:23Z",
      "side": 1,
      "message": "This is added from RKPv3, but generateKeys (or `generateEcdsaP256KeyPair`) is an already existent API which may be not feasible for it.\nShall we have some kind of VSR/HAL version check before running this test?",
      "range": {
        "startLine": 257,
        "startChar": 29,
        "endLine": 257,
        "endChar": 50
      },
      "revId": "bba2020d7191a1070bcc0e2d19b19399599cd68e",
