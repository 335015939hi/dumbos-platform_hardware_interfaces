cc_binary {
    name: "android.hardware.manager@1.0-service",
    srcs: [
        "ServiceManager.cpp",
        "service.cpp"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    shared_libs: [
        "libhidl",
        "liblog",
        "libselinux",
        "libhwbinder",
        "libcutils",
        "libutils",
    ],
    export_shared_lib_headers: ["libhwbinder"],
    product_variables: {
        binder32bit: {
            cflags: ["-DBINDER_IPC_32BIT=1"],
        },
    },
}
