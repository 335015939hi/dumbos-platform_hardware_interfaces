package android.hardware.manager@1.0;

import IDummy;

interface IServiceManager {
    /**
     * Retrieve an existing service, blocking for a few seconds
     * if it doesn't yet exist.
     */
    HIDL_INTERNAL_getService(string name, Version version)
        generates (IDummy service);

    /**
     * Retrieve an existing service, non-blocking.
     */
    HIDL_INTERNAL_checkService(string name, Version version)
        generates (IDummy service);

    /**
     * Register a service. Function 'INTERFACE::registerAsService' should be used
     * instead of this to register services.
     */
    HIDL_INTERNAL_addService(string name, IDummy service, Version version);

    // TODO:
    // HIDL_INTERNAL_removeService
    // listServices(string prefix, <type> class, ) generates vec string
};