package android.hardware.net.tetheroffload.config@1.0;


/**
 * Interface used for configuring the hardware management process
 */
interface IOffloadConfig {
  /**
   * Query the configuration needed by the management process
   */
  getDesiredConfig() generates (ConfigResult config);

  /**
   * Provide a bound file descriptor for use in the management process
   *
   * @param fd    File descriptor which has been bound to group
   * @param group Group which the fd is bound to
   */
  addHandle(handle fd, uint32_t group) generates (BoolResult success);
};
