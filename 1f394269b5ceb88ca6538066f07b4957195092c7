      },
      "writtenOn": "2024-12-27T12:26:35Z",
      "side": 1,
      "message": "Yes, then is it a good idea to change the function name audio_utils_compute_power_mono() to audio_utils_compute_power() and do the same for energy function?",
      "parentUuid": "68c6c56b_8ccebfff",
      "range": {
        "startLine": 409,
        "startChar": 0,
        "endLine": 419,
        "endChar": 88
      },
      "revId": "1f394269b5ceb88ca6538066f07b4957195092c7",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "3d44c004_510c00ad",
        "filename": "audio/aidl/vts/VtsHalDynamicsProcessingTest.cpp",
