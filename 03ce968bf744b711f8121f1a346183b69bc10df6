      },
      "writtenOn": "2023-10-09T10:21:19Z",
      "side": 1,
      "message": "Isn\u0027t this going to change soon when we read the xml config file for all module types?",
      "range": {
        "startLine": 85,
        "startChar": 7,
        "endLine": 85,
        "endChar": 57
      },
      "revId": "03ce968bf744b711f8121f1a346183b69bc10df6",
