      "writtenOn": "2023-10-09T10:21:19Z",
      "side": 1,
      "message": "should we do this if AT LEAST ONE OF the routable mix ports has a dynamic profile?",
      "range": {
        "startLine": 548,
        "startChar": 61,
        "endLine": 548,
        "endChar": 83
      },
      "revId": "03ce968bf744b711f8121f1a346183b69bc10df6",
