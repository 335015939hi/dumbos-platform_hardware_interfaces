      "lineNbr": 245,
      "author": {
        "id": 1150374
      },
      "writtenOn": "2023-06-21T23:47:13Z",
      "side": 1,
      "message": "not all access to mState is under mutex lock. For instance getState() is used for logging and does not use lock. Only Callbacks controlResultHandler, sessionChangeHandler, condWaitState are locking and updating the state, others are updating with out lock.",
      "parentUuid": "45b46475_3fdee46d",
      "range": {
        "startLine": 245,
        "startChar": 0,
        "endLine": 245,
        "endChar": 49
