      },
      "writtenOn": "2023-06-21T20:11:25Z",
      "side": 1,
      "message": "Should this method and `readData` use `ssize_t` (https://man7.org/linux/man-pages/man7/system_data_types.7.html) to be able to report errors? How are they currently reported?",
      "range": {
        "startLine": 138,
        "startChar": 12,
        "endLine": 138,
        "endChar": 18
      },
      "revId": "63ab1465f8c6b6b4d727a50b167d2dc534b30af4",
