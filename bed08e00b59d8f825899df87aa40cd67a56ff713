      "writtenOn": "2021-03-12T10:27:19Z",
      "side": 1,
      "message": "Should this be in the Lc3Parameters or the LeAudioCodecConfiguration? From my view, this is more like the LE channel property, and is vary similar to MTU. Should we merge the MTU and this blocksPerSdu to a single parameter?",
      "range": {
        "startLine": 77,
        "startChar": 0,
        "endLine": 78,
        "endChar": 25
      },
      "revId": "bed08e00b59d8f825899df87aa40cd67a56ff713",
