cc_test {
    name: "VtsHalMediaOmxV1_0TargetComponentTest",
    defaults: ["VtsHalMediaOmxV1_0Defaults"],
    srcs: ["VtsHalMediaOmxV1_0TargetComponentTest.cpp"],

    arch: {
        arm64: {
            // Fix OMX API issue between 32/64 bit processes
            cflags: ["-DUSE_64BITMEDIA"],
        },
        arm: {
            // Force OMX_PTR to be 8 bytes aligned to work with 64 bit components
            cflags: ["-DHAVE_OMX_ALIGNMENT"],
        },
    },
}

