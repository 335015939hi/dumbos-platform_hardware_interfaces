cc_binary {
    name: "android.hardware.keymint-provisioner-service.example",
    relative_install_path: "hw",
    vintf_fragments: ["remotely_provisioned_component.xml"],
    vendor: true,
    cflags: [
        "-O0",
        "-g",
    ],
    static_libs: [
        "android.hardware.keymint-ndk_platform",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcppbor",
        "libcrypto",
        "liblog",
    ],
    srcs: [
        "service.cpp",
        "RemotelyProvisionedComponent.cpp",
    ],
}

cc_library {
    name: "libremote_provisioner",
    cflags: [
        "-O0",
        "-g",
    ],
    static_libs: [
        "android.hardware.keymint-ndk_platform",
        "lib_keymint_remote_prov_support",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libcppbor",
        "libcppcose",
        "libcrypto",
        "liblog",
    ],
    export_include_dirs: ["."],
    export_static_lib_headers: ["android.hardware.keymint-ndk_platform"],
    srcs: [
        "RemotelyProvisionedComponent.cpp",
    ],
}
