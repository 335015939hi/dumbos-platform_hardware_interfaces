cc_binary {
    name: "android.hardware.keymint-provisioner-service.example",
    relative_install_path: "hw",
    vintf_fragments: ["remotely_provisioned_component.xml"],
    vendor: true,
    static_libs: [
        "android.hardware.keymint-ndk_platform",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcppbor",
        "libcrypto",
        "liblog",
        "libremote_provisioner",
    ],
    srcs: [
        "service.cpp",
    ],
}

cc_library {
    name: "libremote_provisioner",
    vendor_available: true,
    static_libs: [
        "android.hardware.keymint-ndk_platform",
        "lib_keymint_remote_prov_support",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libcppbor",
        "libcppcose",
        "libcrypto",
        "liblog",
    ],
    export_include_dirs: [
        ".",
    ],
    export_static_lib_headers: [
        "android.hardware.keymint-ndk_platform",
    ],
    srcs: [
        "RemotelyProvisionedComponent.cpp",
    ],
}
