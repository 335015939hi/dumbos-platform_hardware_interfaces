package android.hardware.data.ipa@1.0;

import ITetheringOffloadCallback;


/**
 * @TODO describe the HAL
 */
interface IOffloadControl {
  /**
   */
  getCapabilities(string upstream, string downstream) generates (BoolResult capable);

  /**
   */
  initOffload(OffloadHandles fds, ITetheringOffloadCallback cb) generates (BoolResult success);

  /**
   */
  stopOffload() generates (BoolResult success);

  /**
   */
  setLocalPrefixes(vec<string> prefixes) generates (BoolResult success);

  /**
   */
  getForwardedStats(string upstream) generates (OffloadStatistics stats);

  /**
   */
  setDataLimit(string upstream, uint64_t limit) generates (BoolResult success);

  /**
   */
  setUpstreamParameters(string iface, string v4Addr, string v4Gw, vec<string> v6Gws) generates (BoolResult success);

  /**
   */
  addDownstream(string iface, string prefix) generates (BoolResult success);

  /**
   */
  removeDownstream(string iface, string prefix) generates (BoolResult success);
};

