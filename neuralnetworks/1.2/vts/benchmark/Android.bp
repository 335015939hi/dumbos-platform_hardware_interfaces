cc_benchmark {
    name: "BurstBenchmark",
    srcs: [
        "BurstBenchmark.cpp",
        "Callbacks.cpp",
        "add_float_model.cpp",
        "add_float_request.cpp",
        "mobilenet_quantized_model.cpp",
        "mobilenet_quantized_request.cpp",
        "mobilenet_float_model.cpp",
        "mobilenet_float_request.cpp",
    ],
    defaults: ["VtsHalTargetTestDefaults"],
    shared_libs: [
        "libfmq",
        "libutils",
        "android.hardware.neuralnetworks@1.0",
        "android.hardware.neuralnetworks@1.1",
        "android.hardware.neuralnetworks@1.2",
        "libhidlmemory",
    ],
    static_libs: [
        "android.hidl.allocator@1.0",
        "libneuralnetworks_utils",
    ],
    header_libs: [
        "libneuralnetworks_headers",
    ],
}

cc_test {
    name: "BurstFunctional",
    srcs: [
        "BurstFunctional.cpp",
        "Callbacks.cpp",
        "add_float_model.cpp",
        "add_float_request.cpp",
        "mobilenet_quantized_model.cpp",
        "mobilenet_quantized_request.cpp",
        "mobilenet_float_model.cpp",
        "mobilenet_float_request.cpp",
    ],
    defaults: ["VtsHalTargetTestDefaults"],
    shared_libs: [
        "libfmq",
        "libutils",
        "android.hardware.neuralnetworks@1.0",
        "android.hardware.neuralnetworks@1.1",
        "android.hardware.neuralnetworks@1.2",
        "libhidlmemory",
    ],
    static_libs: [
        "android.hidl.allocator@1.0",
        "libneuralnetworks_utils",
    ],
    header_libs: [
        "libneuralnetworks_headers",
    ],
}
