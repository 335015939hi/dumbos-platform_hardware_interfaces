package android.hardware.neuralnetworks@1.2;

import @1.0::ErrorStatus;

/**
 * Context object for ref-counting purposes.
 *
 * The side that allocates this object must define a destructor to release the
 * resources of the corresponding FastMessageQueue.
 *
 * The side that recieves this object must register a death recipient to
 * properly handle the case when the sending side of the FastMessageQueue
 * is invalidated either because the object is released or the process has died.
 */
interface IFmqContextToken {
     /**
      * Lifetime-managed FMQ object.
      */
     struct ExecutionBurstChannel {
         /**
          * Descriptor for the FMQ-based channel.
          */
         fmq_sync<ErrorStatus> fmq;

         /**
          * Context object for ref-counting purposes.
          */
         IFmqContextToken context;
     };
};
