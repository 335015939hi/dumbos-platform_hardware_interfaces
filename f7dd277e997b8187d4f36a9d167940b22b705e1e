    {
      "unresolved": false,
      "key": {
        "uuid": "83bafec2_efab68fd",
        "filename": "bluetooth/socket/aidl/android/hardware/bluetooth/socket/LeCocCapabilities.aidl",
        "patchSetId": 13
      },
      "lineNbr": 39,
      "author": {
        "id": 1959861
      },
      "writtenOn": "2024-10-22T22:52:36Z",
      "side": 1,
      "message": "MPS is better aligned to the LE ACL packet length, and that\u0027s what Android host stack sets. LE ACL packet length is typically 251 bytes, which shouldn\u0027t be a burden on MCU memory allocation, so we\u0027ve removed it from the values ​​that MCU can set. Please refer the previous comments - \n\nhttps://android-review.git.corp.google.com/c/platform/hardware/interfaces/+/3303007/comment/84c60006_6e44c853/",
      "parentUuid": "a94a8942_20d644d3",
      "revId": "f7dd277e997b8187d4f36a9d167940b22b705e1e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
