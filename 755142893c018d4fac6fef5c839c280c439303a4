    {
      "key": {
        "uuid": "d85b5aea_c3fb6a53",
        "filename": "radio/1.2/IRadioResponse.hal",
        "patchSetId": 15
      },
      "lineNbr": 101,
      "author": {
        "id": 1060151
      },
      "writtenOn": "2018-01-15T21:26:39Z",
      "side": 1,
      "message": "It must be supported by devices that support 1.2, and it must be supported for all RANs. Here\u0027s the rationale: LCe is exposed directly as an API in connectivity; the entire point is to reduce or eliminate the need for apps caring about radio technologies: we want them to use data services through the abstraction of connectivity rather than looking at RAT+RSSI (which is a terrible way to guess bandwidth, especially when each app will roll its own behavior). It\u0027s unrealistic to ask apps to use a new mechanism if they get inconsistent API behavior on different RANs. Basically, we are creating an abstraction, and it\u0027s not useful if it\u0027s obviously leaky.",
      "parentUuid": "80e3e523_b4c59f04",
      "revId": "755142893c018d4fac6fef5c839c280c439303a4",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
