    {
      "key": {
        "uuid": "c9f403c9_6e025363",
        "filename": "radio/1.2/types.hal",
        "patchSetId": 15
      },
      "lineNbr": 346,
      "author": {
        "id": 1120458
      },
      "writtenOn": "2018-01-16T19:09:18Z",
      "side": 1,
      "message": "in this case, why not just let it be 0-128? Why add a restriction?\n\nAlso, if it is implementation defined, is it just shown to users? Should the framework only compare these relative to each other?",
      "range": {
        "startLine": 346,
        "startChar": 27,
        "endLine": 346,
        "endChar": 79
      },
      "revId": "755142893c018d4fac6fef5c839c280c439303a4",
