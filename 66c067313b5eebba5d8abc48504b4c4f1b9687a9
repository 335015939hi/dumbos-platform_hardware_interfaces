      },
      "lineNbr": 130,
      "author": {
        "id": 1141163
      },
      "writtenOn": "2020-08-06T22:32:47Z",
      "side": 1,
      "message": "As per the RFC, its a 32 bit value (like opaque string) so i am afraid of having signed bit which might change actual value when a larger SPI is used",
      "parentUuid": "8cc54151_8bd33788",
      "range": {
        "startLine": 130,
        "startChar": 9,
