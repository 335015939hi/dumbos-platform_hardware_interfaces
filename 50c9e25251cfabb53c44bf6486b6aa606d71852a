      "writtenOn": "2019-10-18T04:48:58Z",
      "side": 1,
      "message": "Do we need synchronization for accessing this variable?",
      "revId": "50c9e25251cfabb53c44bf6486b6aa606d71852a",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
