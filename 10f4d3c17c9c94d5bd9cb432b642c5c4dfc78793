      "message": "Done",
      "parentUuid": "9d231bb7_5a7bfb4d",
      "range": {
        "startLine": 58,
        "startChar": 0,
        "endLine": 58,
        "endChar": 20
      },
      "revId": "10f4d3c17c9c94d5bd9cb432b642c5c4dfc78793",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
