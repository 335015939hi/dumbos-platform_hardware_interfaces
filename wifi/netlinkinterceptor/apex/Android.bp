package {
    default_applicable_licenses: ["hardware_interfaces_license"],
}

apex {
    name: "com.android.hardware.nlinterceptor",
    vendor: true,
    manifest: "apex_manifest.json",
    file_contexts: "apex_file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    binaries: [
        "android.hardware.net.nlinterceptor-service.default",
    ],
    prebuilts: [
        "nlinterceptor-service.rc",
        "nlinterceptor-service.xml",
    ],
}

prebuilt_etc {
    name: "nlinterceptor-service.rc",
    src: "nlinterceptor.rc",
    installable: false,
}

prebuilt_etc {
    name: "nlinterceptor-service.xml",
    src: "nlinterceptor.xml",
    sub_dir: "vintf",
    installable: false,
}
