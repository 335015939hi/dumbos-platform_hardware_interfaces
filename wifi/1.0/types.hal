package android.hardware.wifi@1.0;

enum CommandFailureReason: uint32_t {
  UNKNOWN,
  DUPLICATE_COMMAND_ID,
  NOT_SUPPORTED,
  NOT_AVAILABLE,
  INVALID_ARGS,
  DRIVER_ERROR_OTHER,
  FIRMWARE_ERROR_OTHER,
  SCAN_INVALID_CHANNEL
};

/**
 * Generic structure to return information about a failure.
 */
struct FailureReason {
  CommandFailureReason reason;

  /**
   * A vendor specific error message from the vendor to provide more
   * information beyond the reason code.
   */
  string description;
};

/**
 * Enum values indicating the status of any supplicant operation.
 */
enum SupplicantCommandStatusCodes : uint32_t {
  SUCCESS,
  FAILURE_UNKNOWN,
  FAILURE_ARGS_INVALID,
  FAILURE_IFACE_INVALID,
  FAILURE_IFACE_UNKOWN,
  FAILURE_IFACE_EXISTS,
  FAILURE_IFACE_DISABLED,
  FAILURE_IFACE_NOT_DISCONNECTED,
  FAILURE_NETWORK_INVALID,
  FAILURE_NETWORK_UNKOWN
};

/**
 * Generic structure to return the status of any supplicant operation.
 */
struct SupplicantCommandStatus {
  SupplicantCommandStatusCodes code;
  /**
   * A vendor specific error message to provide more information beyond the
   * status code.
   */
  string description;
};
