package android.hardware.wifi@1.0;

import IWifiChip;
import IWifiEventCallback;

/**
 * This is the root of the HAL module and is the interface returned when
 * loading an implementation of the Wi-Fi HAL. There should only be one
 * module loaded in the system.
 */
interface IWifi {
  /**
   * Requests notifications of significant events on this chip. Multiple
   * calls to this will register multiple callbacks each of which will
   * receive all events.
   */
  @entry
  @callflow(next={"*"})
  oneway registerEventCallback(IWifiEventCallback callback);

  /**
   * Perform any setup that is required to make use of the module. If the
   * module is already started then this will be a noop. The on_start callback
   * will be called when the setup completes or if the HAL is already
   * started. If the setup fails then on_start_failure will be called.
   */
  @entry
  @callflow(next={"register_event_callback", "stop", "get_chip"})
  oneway start(uint32_t cmd_id);

  /**
   * Tear down any state, ongoing commands, etc. If the module is already
   * stopped then this will be a noop. If the HAL is already stopped or it
   * succeeds then on_stop will be called. If the teardown fails on_failure or
   * on_unrecoverable_failure will be called.
   *
   * Calling stop then start should be a way of resetting state in the HAL,
   * driver, firmware.
   */
  @exit
  @callflow(next={"register_event_callback", "start"})
  oneway stop(uint32_t cmd_id);

  @callflow(next={"register_event_callback", "stop", "get_chip"})
  getChip() generates (IWifiChip chip);
};
