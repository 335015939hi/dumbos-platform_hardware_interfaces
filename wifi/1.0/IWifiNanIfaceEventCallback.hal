package android.hardware.wifi@1.0;

/**
 * NAN Response and Event Callbacks.
 */
interface IWifiNanIfaceEventCallback {
  /**
   * NotifyResponse invoked to notify the status of the Request.
   */
  oneway notifyResponse(CommandId id, ResponseMsg rspData);

  /**
   * Callbacks for the various asynchornous NAN Events.
   */
  oneway eventPublishTerminated(PublishTerminatedInd event);

  oneway eventMatch(MatchInd event);

  oneway eventMatchExpired(MatchExpiredInd event);

  oneway eventSubscribeTerminated(SubscribeTerminatedInd event);

  oneway eventFollowup(FollowupInd event);

  oneway eventDiscEngEvent(DiscEngEventInd event);

  oneway eventDisabled(DisabledInd event);

  oneway eventBeaconSdfPayload(BeaconSdfPayloadInd event);

  oneway eventDataRequest(DataPathRequestInd event);

  oneway eventDataConfirm(DataPathConfirmInd event);

  oneway eventDataEnd(DataPathEndInd event);

  oneway eventTransmitFollowup(TransmitFollowupInd event);
};
