package android.hardware.configstore@1.1;

// TODO: Should these imports go into types.hal?
import @1.0::OptionalBool;
import @1.0::OptionalUInt64;

interface IChargerConfigs {

    // TARGET_HEALTHD_DRAW_SPLIT_SCREEN
    // -D HEALTHD_DRAW_SPLIT_SCREEN
    // default=0
    // TODO: Maybe use uint32 or a smaller type
    drawSplitScreen() generates(OptionalUInt64 value);

    // TARGET_HEALTHD_DRAW_SPLIT_OFFSET
    // -D HEALTHD_DRAW_SPLIT_OFFSET
    // default=0
    // TODO: Maybe use uint32 or a smaller type
    drawSplitOffset() generates(OptionalUInt64 value);

    // BOARD_CHARGER_DISABLE_INIT_BLANK
    // -D CHARGER_DISABLE_INIT_BLANK
    disableInitBlank() generates(OptionalBool value);

    // BOARD_CHARGER_ENABLE_SUSPEND
    // -D CHARGER_ENABLE_SUSPEND
    enableSuspend() generates(OptionalBool value);

};
