aidl_interface {
    name: "android.hardware.tetheroffload.control",
    vendor_available: true,
    host_supported: true,
    owner: "google",
    srcs: ["android/hardware/tetheroffload/control/*.aidl"],
    stability: "vintf",
    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            sdk_version: "module_current",
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],

}

cc_library {
    name: "android.hardware.tetheroffload.control-translate-cpp",
    srcs: ["translate/android/hardware/tetheroffload/control/translate-cpp.cpp"],
    shared_libs: [
        "libbinder",
        "libhidlbase",
        "android.hardware.tetheroffload.control-V1-cpp",
        "libutils",
        "android.hardware.tetheroffload.control@1.0",
        "android.hardware.tetheroffload.control@1.1",
    ],
    export_include_dirs: ["include"],
}

cc_library {
    name: "android.hardware.tetheroffload.control-translate-ndk",
    vendor_available: true,
    srcs: ["translate/android/hardware/tetheroffload/control/translate-ndk.cpp"],
    shared_libs: [
        "libbinder_ndk",
        "libhidlbase",
        "android.hardware.tetheroffload.control-V1-ndk",
        "android.hardware.tetheroffload.control@1.0",
        "android.hardware.tetheroffload.control@1.1",
    ],
    export_include_dirs: ["include"],
}

java_library {
    name: "android.hardware.tetheroffload.control-translate-java",
    srcs: ["translate/android/hardware/tetheroffload/control/Translate.java"],
    libs: [
        "android.hardware.tetheroffload.control-V1-java",
        "android.hardware.tetheroffload.control-V1.0-java",
        "android.hardware.tetheroffload.control-V1.1-java",
    ],
    sdk_version: "module_current",
}
