      },
      "lineNbr": 33,
      "author": {
        "id": 1004017
      },
      "writtenOn": "2018-02-06T03:19:41Z",
      "side": 1,
      "message": "On devices with multiple scanners (e.g. local, remote), deviceId can be used to differentiate between the two. This is a parallel API to what we did with fingerprint and for the same reason.",
      "parentUuid": "479d15d2_15ce1f32",
      "range": {
        "startLine": 33,
        "startChar": 26,
        "endLine": 33,
        "endChar": 34
