package android.hardware.key_agreement@1.0;

/**
 * HmacSharingParameters holds the data used in the process of establishing a shared HMAC between
 * multiple IKeyAgreementParty instances.
 */
struct HmacSharingParameters {
    /**
     * Either empty or contains a persistent value that is associated with the pre-shared key
     * agreement key.  It is either empty or 32 bytes in length.
     */
    vec<uint8_t> seed;

    /**
     * A 32-byte value which is guaranteed to be different during each boot session.  Probabilistic
     * uniqueness (i.e. randomly-chosen value) is acceptable.
     */
    uint8_t[32] nonce;
};

