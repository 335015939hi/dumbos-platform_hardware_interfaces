      "writtenOn": "2023-07-05T16:34:52Z",
      "side": 1,
      "message": "I would recommend making a local copy of `mBtDeviceProxies` and releasing the lock afterwards. Data transfer may take a long time, we don\u0027t want to be holding the lock during it.",
      "range": {
        "startLine": 123,
        "startChar": 0,
        "endLine": 123,
        "endChar": 41
      },
      "revId": "4a3fe569c12d41ecce111fb656f619839d1db2a3",
