    },
    {
      "unresolved": true,
      "key": {
        "uuid": "983a7578_37fe14ae",
        "filename": "audio/aidl/default/bluetooth/StreamBluetooth.cpp",
        "patchSetId": 47
      },
      "lineNbr": 123,
      "author": {
        "id": 1150374
      },
      "writtenOn": "2023-07-05T20:39:54Z",
      "side": 1,
      "message": "mikhail, this lock is serving 2 purposes, this is guarding mConnectedDevices list. While transfers are happening we dont intend to update device list. Once a transfer call is finished then lock can be acquired by binder thread, update the list and mark mIsInitialized to false to disallow further calls to proxy and wait for reinitialization.\n\nNot only that, while this lock is acquired further calls to proxy is not allowed. This keeps methods of DevicePortProxy thread safe. \n\nThis is to avoid multiple mutexes and worry about order of acquire/release.",
      "parentUuid": "5d3c2efe_8f5f5847",
      "range": {
        "startLine": 123,
        "startChar": 0,
        "endLine": 123,
        "endChar": 41
      },
      "revId": "4a3fe569c12d41ecce111fb656f619839d1db2a3",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
