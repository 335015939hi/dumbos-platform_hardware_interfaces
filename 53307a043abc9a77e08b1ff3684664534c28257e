      "writtenOn": "2024-01-05T23:01:40Z",
      "side": 1,
      "message": "Other way around I believe.\nWe can\u0027t freeze an interface without installing this first because it\u0027s going to start being used on `next` once it\u0027s frozen.",
      "parentUuid": "1b7fcf52_65d0a138",
      "range": {
        "startLine": 109,
        "startChar": 0,
        "endLine": 109,
        "endChar": 42
      },
