        "id": 1884477
      },
      "writtenOn": "2024-11-27T01:02:33Z",
      "side": 1,
      "message": "Closing since this is not a strong requirement, but note that ATT is unlikely to use the same APIs, this is absolutely not a concern here.",
      "parentUuid": "73c4aaf8_4d6fc4f9",
      "range": {
        "startLine": 33,
        "startChar": 8,
        "endLine": 33,
