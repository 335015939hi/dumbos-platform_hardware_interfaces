      "writtenOn": "2022-11-17T23:36:24Z",
      "side": 1,
      "message": "I\u0027m changing these helper functions to `inline`, seems more convenience",
      "parentUuid": "521c152e_eb618487",
      "range": {
        "startLine": 114,
        "startChar": 0,
        "endLine": 114,
