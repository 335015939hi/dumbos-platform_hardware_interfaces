      "writtenOn": "2022-11-17T02:18:52Z",
      "side": 1,
      "message": "Please make sure that a call to any helper which ASSERTs inside is wrapped into ASSERT_NO_FATAL_FAILURE. See go/gunitadvanced#propagating-fatal-failures.",
      "range": {
