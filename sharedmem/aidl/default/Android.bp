cc_binary {
    name: "android.hardware.sharedmem-service.apex",
    stem: "android.hardware.sharedmem-service.example",
    relative_install_path: "hw",
    vendor: true,

    stl: "c++_static",
    static_libs: [
        "libbase",
        "android.hardware.sharedmem-V1-ndk",
    ],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "libcutils",
    ],
    srcs: [
        "main.cpp",
        "sharedmem.cpp",
    ],
    installable: false, // installed in APEX
}

prebuilt_etc {
    name: "sharedmem-default-apex.rc",
    src: "sharedmem-default-apex.rc",
    installable: false,
}

prebuilt_etc {
    name: "sharedmem-default.xml",
    src: "sharedmem-default.xml",
    sub_dir: "vintf",
    installable: false,
}

apex {
    name: "com.android.hardware.sharedmem",
    file_contexts: "apex_file_contexts",
    manifest: "apex_manifest.json",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    vendor: true,

    binaries: [
        "android.hardware.sharedmem-service.apex",
    ],
    prebuilts: [
        "sharedmem-default-apex.rc",
        "sharedmem-default.xml",
    ],
}
