    {
      "unresolved": false,
      "key": {
        "uuid": "8219b6a9_b314ea2f",
        "filename": "health/aidl/android/hardware/health/IHealth.aidl",
        "patchSetId": 14
      },
      "lineNbr": 96,
      "author": {
        "id": 1121838
      },
      "writtenOn": "2021-10-21T23:55:58Z",
      "side": 1,
      "message": "They are all in HealthInfo.\n\ngetHealthInfo is heavy-weighted and these are light-weighted. \n\nAlso, these are supposed to report the most-recent value for just that field, and getHealthInfo needs to update all information, then report it.\n\nThe HAL is the conversion from the 2.1 HAL, so I try to keep it aligned with the 2.1 HAL as much as possible. Technically, the framework already records HealthInfo from callbacks, so the framework can tell apps these values from the recorded HealthInfo. However, to the apps, these values may be outdated (as old as 600 seconds when not charging, if using the default HAL). So, these are a way for apps / the framework to read the realtime values, without fetching the whole struct.\n\nThe app API is at BatteryManager:\n\nhttps://cs.android.com/android/platform/superproject/+/master:frameworks/base/core/java/android/os/BatteryManager.java;l\u003d220;drc\u003d5d123b67756dffcfdebdb936ab2de2b29c799321",
      "parentUuid": "9f3759f4_84acac55",
      "range": {
        "startLine": 96,
        "startChar": 8,
        "endLine": 96,
        "endChar": 27
      },
      "revId": "74738049dc52de92adb29c94c245501ca3411fcc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
