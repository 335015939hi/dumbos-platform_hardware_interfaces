    {
      "key": {
        "uuid": "4e3269ac_dcf93a48",
        "filename": "keymint/aidl/vts/functional/KeyMintAidlTestBase.cpp",
        "patchSetId": 27
      },
      "lineNbr": 75,
      "author": {
        "id": 1092085
      },
      "writtenOn": "2020-09-15T17:13:36Z",
      "side": 1,
      "message": "This is testing the behavior of the AIDL code, and I would not make any assumptions about this when an error is returned. Yes, the current code does not touch the output parameters in that case, but are you sure that this is actually defined and can be relied upon? I think you should simply not touch output parameters in case of error. Otherwise the test will fail for no good reason if the AIDL behavior should change.",
      "parentUuid": "b4396a57_a2597575",
      "range": {
        "startLine": 72,
        "startChar": 4,
