    {
      "key": {
        "uuid": "dac98f0d_6fdd2388",
        "filename": "keymint/aidl/vts/functional/KeyMintAidlTestBase.cpp",
        "patchSetId": 27
      },
      "lineNbr": 179,
      "author": {
        "id": 1092085
      },
      "writtenOn": "2020-09-15T17:13:36Z",
      "side": 1,
      "message": "That is because you are writing a service, so all that you can return are service specific errors. Other errors may occur during marshaling of malformed data or during transactions in the kernel driver. Those errors are not intentional - caused by bugs or uncommon system states, such as out-of-memory, but they must be handled, because if you don\u0027t, you are accessing malformed data which can, in the worst case, lead to vulnerabilities.\n\nHere in the test scenario it will only make you life harder during debugging, because you assume the transaction was successful and then wonder why you didn\u0027t get the expected data.\n\nNo action required, just ack please.",
      "parentUuid": "7186d7e5_46e3f244",
      "range": {
        "startLine": 179,
        "startChar": 34,
        "endLine": 179,
        "endChar": 67
      },
      "revId": "87210349393148aaf6b4075070fe54d4e7bbee51",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
