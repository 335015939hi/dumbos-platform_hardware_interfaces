      "writtenOn": "2020-09-04T05:52:55Z",
      "side": 1,
      "message": "How about making this field @nullable instead?\n\nIn fact, pretty much all off the parameters to finish are optional and could be made @nullable.",
      "range": {
        "startLine": 234,
        "startChar": 47,
        "endLine": 235,
        "endChar": 64
      },
      "revId": "87210349393148aaf6b4075070fe54d4e7bbee51",
