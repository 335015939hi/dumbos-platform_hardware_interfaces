      "writtenOn": "2019-08-27T22:33:30Z",
      "side": 1,
      "message": "What is the mechanism for OEMs to extend these get/set calls with our own metadata?",
      "range": {
        "startLine": 36,
        "startChar": 24,
        "endLine": 36,
        "endChar": 38
      },
      "revId": "4e8054dac6e39851a1ac9d205424d3496ed29029",
