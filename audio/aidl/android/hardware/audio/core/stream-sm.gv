// To render: dot -Tpng stream-sm.gv -o stream-sm.png
digraph stream_state_machine {
    node [shape=doublecircle style=filled fillcolor=black width=0.5] I;
    node [shape=point width=0.5] F;
    node [shape=oval width=1];
    node [fillcolor=lightgreen] IDLE;
    node [fillcolor=lightgreen] STANDBY;
    node [fillcolor=tomato] CLOSED;
    node [style=dashed] TRANSFER;
    node [style=dashed] DRAIN;
    node [fillcolor=lightblue style=filled];
    I -> IDLE;
    IDLE -> CLOSED [label="→IStream*.close"];
    IDLE -> STANDBY [label="STANDBY"];
    IDLE -> READY [label="START"];
    IDLE -> IDLE [label="FLUSH"];
    STANDBY -> READY [label="START"];
    STANDBY -> CLOSED [label="→IStream*.close"];
    STANDBY -> STANDBY [label="FLUSH"];
    READY -> TRANSFER [label="BURST"];
    TRANSFER -> READY [label="←IStreamCallback.onTransferReady"];
    TRANSFER -> ERROR [label="←IStreamCallback.onError"];
    READY -> PAUSED [label="PAUSE"];
    READY -> DRAIN [label="DRAIN"];
    DRAIN -> IDLE [label="←IStreamCallback.onDrainReady"];
    DRAIN -> ERROR [label="←IStreamCallback.onError"];
    PAUSED -> READY [label="START"];
    PAUSED -> DRAIN [label="DRAIN"];
    PAUSED -> IDLE [label="FLUSH"];
    ERROR -> CLOSED [label="→IStream*.close"];
    CLOSED -> F;
}
