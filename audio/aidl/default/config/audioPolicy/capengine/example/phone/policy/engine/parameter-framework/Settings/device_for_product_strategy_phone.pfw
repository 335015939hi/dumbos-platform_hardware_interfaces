					bluetooth_a2dp_speaker = 0
					hdmi = 0
					anlg_dock_headset = 0
					dgtl_dock_headset = 0
					usb_accessory = 0
					usb_device = 0
					telephony_tx = 0
					line = 1
					speaker = 0

			conf: UsbDevice
				#
				# Fallback BT Sco devices in case of FORCE_BT_SCO
				# or FORCE_NONE
				#
				AvailableOutputDevices Includes USB_DEVICE
				ANY
					ForceUseForCommunication Is BT_SCO
					ForceUseForCommunication Is NONE
					ALL
						ForceUseForCommunication Is SPEAKER
						#
						# In case of Force Speaker, priority between device and accessory are
						# inverted compared to Force None or Bt Sco
						#
						AvailableOutputDevices Excludes USB_ACCESSORY
						TelephonyMode IsNot IN_CALL
						TelephonyMode IsNot IN_COMMUNICATION

				component: /Policy/policy/product_strategies/phone/selected_output_devices/mask
					earpiece = 0
					wired_headset = 0
					wired_headphone = 0
					bluetooth_sco = 0
