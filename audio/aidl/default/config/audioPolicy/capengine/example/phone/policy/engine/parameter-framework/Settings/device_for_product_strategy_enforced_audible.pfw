				component: /Policy/policy/product_strategies/STRATEGY_ENFORCED_AUDIBLE/selected_output_devices/mask
					remote_submix = 0
					earpiece = 0
					wired_headset = 0
					wired_headphone = 0
					bluetooth_sco = 0
					bluetooth_sco_headset = 0
					bluetooth_sco_carkit = 0
					bluetooth_a2dp = 0
					bluetooth_a2dp_headphones = 0
					bluetooth_a2dp_speaker = 0
					hdmi = 0
