xsd_config {
    name: "audio_policy_engine_conf_V1_0",
    srcs: ["audio_policy_engine_configuration.xsd"],
    package_name: "audio.policy.V1_0",
}

genrule {
    name: "audio_policy_engine_conf_V1_0_xsd",
    srcs: ["audio_policy_engine_configuration.xsd"],
    out: [
        "audio_policy_engine_configuration_V1_0.xsd",
    ],
    cmd: "cp -f $(in) $(genDir)/audio_policy_engine_configuration_V1_0.xsd",
}
