
xsd_config {
    name: "audio_policy_configuration_V4_0",
    srcs: ["audio_policy_configuration.xsd"],
    package_name: "audio.policy.configuration.V4_0",
}

genrule {
    name: "audio_policy_configuration_V4_0_xsd",
    srcs: ["audio_policy_configuration.xsd"],
    out: [
        "audio_policy_configuration_V4_0.xsd",
    ],
    cmd: "cp -f $(in) $(genDir)/audio_policy_configuration_V4_0.xsd",
}
