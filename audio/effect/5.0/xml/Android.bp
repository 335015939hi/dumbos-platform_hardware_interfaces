
xsd_config {
    name: "audio_effects_conf_V5_0",
    srcs: ["audio_effects_conf.xsd"],
    package_name: "audio.effects.V5_0",
}

genrule {
    name: "audio_effects_conf_V5_0_xsd",
    srcs: ["audio_effects_conf.xsd"],
    out: [
        "audio_effects_conf_V5_0.xsd",
    ],
    cmd: "cp -f $(in) $(genDir)/audio_effects_conf_V5_0.xsd",
}
