package android.hardware.audio.audiogain@7.0;

import types;

/**
 * This callback interface defines a set of asynchronous operations used
 * to inform or notify subscribed clients of various audio gain changes
 * form the audio HAL.
 */
interface IAudioGainCallback {

    /**
     * This method gets called when AudioHAL changes Audio Gain.
     * This change may occur:
     * - when ADAS sound is played
     * - when Media is ducked by Navigation Announcments
     * - ...
     * @param reasonsMask value to set.
     *        Combination of |ReasonMask| values, describing  why Audio Gain has changed.
     * @param gains Vector of AudioGainConfigExt,
     *   extending android.hardware.audio.common@7.0::AudioGainConfig.
     *   It allows to get the gain index/values for the given ports.
     *   See android.hardware.audio.common@7.0::AudioGainConfig for more details.
     *   AudioHAL must at least provide:
     *      -android.hardware.audio.common@7.0::AudioGainConfig.index: computed attenuated index,
     *          in the range of the associated volume group.
     *          By convention, index = Constants::FACTORY_RESET would be interpreted as a factory
     *          reset, requesting the client to apply default volumes.
     *      -android.hardware.audio.common@7.0::AudioGainConfig.values[0]: gain in millibels,
     *          corresponding to the first channel.
     */
    oneway onChanged(bitfield<ReasonMask> reasonsMask, vec<AudioGainConfigExt> gains);
};
