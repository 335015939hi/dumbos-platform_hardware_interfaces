cc_defaults {
    name: "android.hardware.audio.audiogain-impl_default",
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "AudioGain.cpp",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "libhidlmemory",
        "liblog",
        "libutils",
        "android.hardware.audio.common-util",
        "android.hidl.memory@1.0",
        "android.hardware.audio.audiogain@6.0",
        "android.hardware.audio@6.0",
    ],
    header_libs: [
        "android.hardware.audio.common.util@all-versions",
        "libaudio_system_headers",
        "libaudioclient_headers",
        "libhardware_headers",
        "libmedia_headers",
    ],
    export_include_dirs: [
        "include",
    ],
}

cc_library_shared {
    name: "android.hardware.audio.audiogain@6.0-impl",
    defaults: ["android.hardware.audio.audiogain-impl_default"],
    shared_libs: [
        "android.hardware.audio.common@6.0",
        "android.hardware.audio.common@6.0-util",
    ],
    cflags: [
        "-DMAJOR_VERSION=6",
        "-DMINOR_VERSION=0",
        "-include common/all-versions/VersionMacro.h",
    ],
}
