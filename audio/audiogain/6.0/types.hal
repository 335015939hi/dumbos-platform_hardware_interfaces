package android.hardware.audio.audiogain@6.0;

import android.hardware.audio.common@6.0;
import android.hardware.audio.common@6.0::types;

enum Result : int32_t {
    OK,
    NOT_INITIALIZED,
    INVALID_ARGUMENTS,
    INVALID_STATE,
    /**
     * Methods marked as "Optional method" must return this result value
     * if the operation is not supported by HAL.
     */
    NOT_SUPPORTED
};

/**
 * Enum to identify the reason(s) of AudioGain changed event
 */
enum Reason : uint32_t {
    CYBER_MUTE          = 0x1,
    REMOTE_MUTE_ORDER   = 0x2,
    TCU_MUTE_ORDER      = 0x4,
    ADAS_DUCKING        = 0x8,
    NAV_DUCKING         = 0x10,
    THERMAL             = 0x20,
    OTHER               = 0x80000000,
};


enum Constants : int32_t { FACTORY_RESET  = -1 };

/**
 * Extension of Audio Gain configuration structure used to get gain values of an audio port
 * identified by its unique id.
 * See audio/common/6.0/types.hal
 */
struct AudioGainConfigExt {
    AudioPortHandle id;
    AudioGainConfig gain;
};
