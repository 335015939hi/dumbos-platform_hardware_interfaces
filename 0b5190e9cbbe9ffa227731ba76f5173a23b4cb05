        "id": 1043663
      },
      "writtenOn": "2020-12-04T23:07:23Z",
      "side": 1,
      "message": "It\u0027d be good to test that if SHA1 is not specified, it doesn\u0027t work.  I could see implementations accidentally always allowing SHA1.",
      "range": {
        "startLine": 2122,
        "startChar": 33,
        "endLine": 2122,
        "endChar": 65
      },
      "revId": "0b5190e9cbbe9ffa227731ba76f5173a23b4cb05",
