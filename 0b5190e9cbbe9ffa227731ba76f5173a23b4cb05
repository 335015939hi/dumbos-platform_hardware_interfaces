    },
    {
      "unresolved": false,
      "key": {
        "uuid": "4279d7e0_1192e192",
        "filename": "keymint/aidl/vts/functional/keyMint1Test.cpp",
        "patchSetId": 1
      },
      "lineNbr": 2122,
      "author": {
        "id": 1647128
      },
      "writtenOn": "2020-12-09T00:28:49Z",
      "side": 1,
      "message": "There are two cases with SHA1:\nIf key characteristics does not have TAG_RSA_OAEP_MGF_DIGEST tag then implementations must always allow SHA1 by default - backward compatibility. This is already being tested by Oaep tests.\n\nAlternatively, if key characteristics have TAG_RSA_OAEP_MGF_DIGEST tag then begin must have compatible values. This test case tests this case with SHA256 MGF1 digest i.e. SHA1 is not specified in key characteristics. \n\nI have changed the test case a little and provide SHA1 as MGF1 digest in Begin. This will ensure that implementations accidentally does not support SHA1 if not specified in key characteristics.",
      "parentUuid": "da5c2c4c_5fb1bc5f",
      "range": {
        "startLine": 2122,
        "startChar": 33,
        "endLine": 2122,
        "endChar": 65
      },
      "revId": "0b5190e9cbbe9ffa227731ba76f5173a23b4cb05",
