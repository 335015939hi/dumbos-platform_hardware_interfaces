package android.hardware.radio@1.5;

import @1.0::PcoDataInfo;
import @1.4::SetupDataCallResult;

struct DedicatedBearerInfo {
    /**
     * ID of the bearer (3GPP 24.301 9.3.2)
     */
    int32_t id;

    /**
     * EPS QoS data associated with this bearer. Formatted
     * according to 3GPP
     * 24.301 9.9.4.3
     */
    vec<uint8_t> epsQos;

    /**
     * PCO data associated with the dedicated bearer
     */
    vec<PcoDataInfo> carrierPco;

    /**
     * Traffic flow template. Defined in 3GPP 24.301
     * 9.9.4.16.
     */
    vec<uint8_t> tft;
};

struct SetupDataCallResult {
    @1.4::SetupDataCallResult base;

    /**
     * List of dedicated bearers associated with this pdn
     */
    vec<DedicatedBearerInfo> dedicatedBearers;
};
