package android.hardware.radio@1.5;

import @1.4::IRadio;

/**
 * This interface is used by telephony and telecom to talk to cellular radio.
 * All the functions have minimum one parameter:
 * serial: which corresponds to serial no. of request. Serial numbers must only be memorized for the
 * duration of a method call. If clients provide colliding serials (including passing the same
 * serial to different methods), multiple responses (one for each method call) must still be served.
 * setResponseFunctions must work with @1.4::IRadioResponse and @1.4::IRadioIndication.
 */
interface IRadio extends @1.4::IRadio {

    /**
     * Get abbreviated dialing numbers records from the SIM card
     * after recevied the indication notified by adnInitDone()
     *
     * The ADN records must be recevied via adnRecordsReceived()
     *
     * @param serial Serial number of request
     *
     * Response callback is IRadioResponse.getAdnRecordResponse()
     */
    oneway getAdnRecords(int32_t serial);

    /**
     * Update abbreviated dialing numbers records to the SIM card
     *
     * If the index of recordInfo is 0, the ADN could be added.
     *
     * If all of the fields in the recordInfo is empty except the index,
     * the ADN of the index could be deleted.
     *
     * @param serial Serial number of request
     * @param recordInfo PhonebookRecordInfo
     *
     * Response callback is IRadioResponse.updateAdnRecordResponse()
     */
    oneway updateAdnRecord(int32_t serial, PhonebookRecordInfo recordInfo);
};
