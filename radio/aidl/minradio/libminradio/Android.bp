package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_interfaces_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_interfaces_license"],
}

cc_library {
    name: "android.hardware.radio-library.minradio",
    relative_install_path: "hw",
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-DANDROID_UTILS_REF_BASE_DISABLE_IMPLICIT_CONSTRUCTION",
        "-Wno-unused-parameter", // TODO: remove later
    ],
    shared_libs: [
        "android.hardware.radio.config-V2-ndk",
        "android.hardware.radio.data-V2-ndk",
        "android.hardware.radio.modem-V2-ndk",
        "android.hardware.radio.network-V2-ndk",
        "android.hardware.radio.sim-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "libutils",
    ],
    srcs: [
        "config/RadioConfig.cpp",
        "data/RadioData.cpp",
        "modem/RadioModem.cpp",
        "network/RadioNetwork.cpp",
        "response.cpp",
        "sim/RadioSim.cpp",
        "sim/structs.cpp",
    ],
    export_include_dirs: ["include"],
}
