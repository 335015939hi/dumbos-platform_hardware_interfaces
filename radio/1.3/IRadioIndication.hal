package android.hardware.radio@1.3;

import @1.0::RadioIndicationType;
import @1.2::IRadioIndication;

/**
 * Interface declaring unsolicited radio indications.
 */
interface IRadioIndication extends @1.2::IRadioIndication {
    /**
     * Report current list of emergency numbers
     *
     * Each emergency number (@1.3::EmergencyNumber) in the emergency number list contains a
     * dialing number, one or more service category(s), and mobile country code, and source(s)
     * that indicate where it comes from.
     *
     * Radio must collect all sources of the emergency number to build the indication. For example,
     * network operator signals, sim card information, modem/oem configuration, always-available
     * emergency numbers and sim-absence emergency numbers, etc.
     *
     * 112, 911 are always available. Besides, 000, 08, 110, 999, 118 and 119 should be available
     * when sim is not present.
     *
     * The reported emergency number list should not have duplicate @1.3::EmergencyNumber. Please
     * refer the document of @1.3::EmergencyNumber to construct each emergency number to report.
     *
     * Reference: 3GPP TS 22.101 version 9.1.0 Release 9
     *
     * @param type Type of radio indication
     * @param emergencyNumberList Current list of emergency numbers known to radio.
     */
    oneway currentEmergencyNumberList(RadioIndicationType type,
            vec<EmergencyNumber> emergencyNumberList);
};
