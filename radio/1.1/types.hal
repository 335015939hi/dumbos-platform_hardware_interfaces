enum ScanType : int32_t {
    ONE_SHOT = 0,
    PERIODIC = 1,
};

enum ScanStatus : int32_t {
    PARTIAL = 1,
    COMPLETE = 2,
};

enum KeepaliveType : int32_t {
    NATT_IPV4 = 0,
    NATT_IPV6 = 1,
};

enum KeepaliveStatusCode : int32_t {
    ACTIVE,
    INACTIVE,
    PENDING,
};

struct RadioAccessSpecifier {
    RadioAccessNetworks radioAccessNetwork;
    vec<GeranBands> geranBands;
    vec<UtranBands> utranBands;
    vec<EutranBands> eutranBands;
    vec<int32_t> channels;
};

struct NetworkScanRequest {
    ScanType type;
    int32_t interval;
    vec<RadioAccessSpecifier> specifiers;
};

struct NetworkScanResult {
    ScanStatus status;
    RadioError error;
    vec<CellInfo> networkInfos;
};

struct KeepaliveRequest {
    KeepaliveType type;
    vec<uint8_t> sourceAddress;
    int32_t sourcePort;
    vec<uint8_t> destinationAddress;
    int32_t destinationPort;
    int32_t maxKeepaliveIntervalMillis;
    int32_t cid;
};

struct KeepaliveStatus {
    int32_t sessionHandle;
    KeepaliveStatusCode code;
};

struct ImsiEncryptionInfo {
    string mcc;
    string mnc;
    vec<uint8_t> carrierKey;
    string keyIdentifier;
    int64_t expirationTime;
};
