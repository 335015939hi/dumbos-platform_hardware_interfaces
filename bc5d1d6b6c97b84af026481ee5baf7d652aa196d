        "id": 1042638
      },
      "writtenOn": "2023-04-25T21:23:18Z",
      "side": 1,
      "message": "I hope we can leave channel transformations to the framework. Even downmixing stereo to mono may create sample overflows for integer formats. I would prefer not to make the HAL code more complex than actually needed.",
      "range": {
        "startLine": 34,
        "startChar": 0,
        "endLine": 34,
        "endChar": 50
      },
      "revId": "bc5d1d6b6c97b84af026481ee5baf7d652aa196d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
