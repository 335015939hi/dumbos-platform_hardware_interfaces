      "author": {
        "id": 1042638
      },
      "writtenOn": "2023-04-25T21:23:18Z",
      "side": 1,
      "message": "Since the size of the frame depends on the channel count we need to specify which channel mask is used to calculate it.",
      "range": {
        "startLine": 37,
        "startChar": 0,
        "endLine": 37,
        "endChar": 82
      },
      "revId": "bc5d1d6b6c97b84af026481ee5baf7d652aa196d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
