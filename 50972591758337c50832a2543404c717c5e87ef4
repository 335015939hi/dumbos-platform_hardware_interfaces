      "writtenOn": "2018-02-28T18:37:50Z",
      "side": 1,
      "message": "These are presence check algorithms, which are used to check if the NFC tag is still present in the field. If the tag has been lost, then a full polling cycle starts again instead of polling for only the tag type.",
      "parentUuid": "dd537f55_8efbdc88",
      "range": {
        "startLine": 48,
        "startChar": 4,
        "endLine": 56,
        "endChar": 35
