nst ::android::Parcel* _aidl_parcel) override final;\n  ::android::status_t writeToParcel(::android::Parcel* _aidl_parcel) const override final;\n};  // class KeyParameter\n\n}  // namespace keymaster\n\n}  // namespace hardware\n\n}  // namespace android",
