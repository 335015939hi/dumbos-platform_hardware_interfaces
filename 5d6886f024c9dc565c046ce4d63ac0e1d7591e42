      },
      "writtenOn": "2017-03-20T23:01:29Z",
      "side": 1,
      "message": "Should we do this after VendorInterface::Shutdown?\n\nIs there a downside to calling unlinkToDeath very last?",
      "range": {
        "startLine": 112,
        "startChar": 0,
        "endLine": 112,
        "endChar": 31
      },
      "revId": "5d6886f024c9dc565c046ce4d63ac0e1d7591e42",
