package android.hardware.keymaster.capability@1.0;

/**
 * IKeymasterCapabilityExchange provides a mechanism for reducing the power of a KeymasterCapability.
 */
interface IKeymasterCapabilityExchange {

    /**
     *
     */
    createCapability() generates (KeymasterCapability newCapability);

    /**
     *
     */
    createEdge(vec<KeymasterCapability> source, KeymasterCapability dest)
        generates (vec<uint8_t> edge);

    /**
     *
     */
    exchange(vec<KeymasterCapability> source, vec<uint8_t> edge)
         generates (KeymasterCapability dest);
};
