package android.hardware.keymaster.capability@1.0;

/**
 * Authentication type, used by some KeymasterCapabilities to specify the mechanism used to
 * authentiate the user, and in Keymaster KeyCharacteristics to specify the allowable mechanisms for
 * authenticating to activate a key.
 */
enum AuthenticationType : uint32_t {
    NOT_APPLICABLE = 0,
    PASSWORD = 1 << 0,
    FINGERPRINT = 1 << 1,
    FACE = 1 << 2,
    IRIS = 1 << 3,

    // Additional entries must be powers of 2.
    ANY = 0xFFFFFFFF,
};

/**
 * An KeymasterCapability is a secure token used to unlock some secure operation, usually in
 * Keymaster.
 *
 * KeymasterCapabilities are produced by secure environment applications, notably GateKeeper and
 * Fingerprint, and consumed by the Keymaster secure environment application.  Other uses are
 * possible and may be added in the future.  It is up to the caller to determine which of the
 * generated KeymasterCapabilities is appropriate for a given key operation.
 *
 * Backward compatibility note: KeymasterCapabilities represent a new, more flexible replacement for
 * the hw_auth_token_t (and it's slightly HIDL-ized variation, HardwareAuthToken).  See the support
 * library for translation utilities.
 */
struct KeymasterCapability {
    /**
     * A challenge value that's used to bind a ICapability to a specific context and to prove
     * freshness.  Zero if unusued.
     */
    uint64_t challenge;

    /**
     * An ID is an abstract reference to the resource that a given capability unlocks.  One
     * ICapability may unlock multiple resources, so multiple IDs may be present.
     */
    vec<uint64_t> ids;

    /**
     * The type of authentication, if any.
     */
    AuthenticationType authenticationType;

    /**
     * timestamp indicates when the capability was created (e.g. authentication occurred), in
     * milliseconds since device boot.
     */
    uint64_t timestamp;

    /**
     * secure_token contains a secure blob that incorporates the above fields and contains zero or
     * more encrypted secrets which are used to decrypt resources to which this capability provides
     * access.
     *
     * The content of this field is a deliberately opaque implementation detail, for flexibility of
     * implementations and for extensibility.  All HALs that generate and consume capabilities on a
     * device must agree on secure_token contents.
     */
    vec<uint8_t> secure_token;
};


