      "lineNbr": 44,
      "author": {
        "id": 1043663
      },
      "writtenOn": "2019-10-14T21:06:22Z",
      "side": 1,
      "message": "We\u0027ll have to think hard about how to do this at the higher layers, but it\u0027s simple enough to do here, so done.",
      "parentUuid": "7998eef2_83b477e3",
      "revId": "8729a9486575e35b62108a832b47fee23c2ea60f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
