package android.hardware.gnss.measurement_corrections@1.1;

import @1.0::IMeasurementCorrections;

/**
 * Interface for measurement corrections support.
 */
interface IMeasurementCorrections extends @1.0::IMeasurementCorrections {
    /**
     * Injects OSR differential corrections to be used by the HAL to improve
     * the GNSS location output.
     *
     * @param corrections The computed corrections to be used by the HAL.
     *
     * @return success Whether the HAL can accept & use these corrections.
     */
    setOsrDiffCorrections(OsrDiffCorrections corrections) generates (bool success);

    /**
     * Injects a reference station. Multiple stations with different ids (see
     * referenceStationId field) can be injected.
     *
     * @param station The reference station.
     */
     setReferenceStation(ReferenceStation station);
};
