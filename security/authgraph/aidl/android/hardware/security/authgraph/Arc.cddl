Arc = [                            ; COSE_Encrypt0
    protected : bstr .cbor ArcProtectedHeaders,
    unprotected : {
        5 : bstr .size 12          ; IV
    },
    ciphertext : bstr    ; Enc(K, bstr .cbor Payload, encoded ArcEncStruct)
]

ArcProtectedHeaders = {
           1 : 3,                  ; Algorithm: AES-GCM mode w/ 256-bit key, 128-bit tag
    ? -70001 : [{ + Permission }], ; One or more Permissions
    ? -70002 : [{ + Limitation }], ; One or more Limitations
      -70003 : int,   ; Timestamp in milliseconds since some starting point (generally
                      ; the most recent device boot) which all of the applications within
                      ; the secure domain must agree upon
    ? -70004 : bstr .size 16,      ; Nonce used in key exchange methods
      -70006 : int,                ; Version of the CBOR structure of the encrypted payload.
}

; Permissions indicate what an arc can be used with. Permissions are added to an arc during the
; `create()` primitive operation and are propagated during `mint` and `snap` primitive operations.
Permission = &(
    -4770552 : CertChain, ; "source_id" - in the operations performed by a source, the source adds
                          ; its own certificate chain to the permissions of an arc.

    -4770553 : CertChain, ; "sink_id" - in the operations performed by a sink, the sink adds its
                          ; own certificate chain to the permissions of an arc.

    -4770554 : Policy,    ; "source_policy" - in the operations performed by a source, the source
                          ;  adds its own identity verification policy to the permissions of an arc.

    -4770555 : Policy,    ; "sink_policy" - in the operations performed by a sink, the sink adds
                          ; its own identity verification policy to the permissions of an arc.

    -4770556 : [ +Policy ]    ; "minting_allowed" - dsefines the set of policies based on which
                              ; the payload key is allowed to be minted.

    -4770557 : bool           ; "deleted_on_biometric_change" - A Boolean value that
                              ; indicates whether an authorization key issued from a biometric TA is
                              ; invalidated on new biometric enrollment or removal of all
                              ; biometrics.

    -4770558 : int        ; "secure user id" - secure user id
)

; Limitations indicate what restrictions are applied on the usage of an arc. Permissions are added
; to an arc during the `create` primitive operation and are propagated during `snap` primitive
; operation.
Limitation = &(
    -4770554 : bstr,      ; "challenge" - is added to an arc that transfers an auth key to a channel
                          ; key, in order to ensure the freshness of the authentication.
                          ; A challenge is issued by a sink (e.g. Keymint TA, Biometric TAs).
)

CertChain = bstr .cbor ExplicitKeyDiceCertChain ; see ExplicitKeyDiceCertChain.cddl

Policy = bstr .cbor DicePolicy ; see DicePolicy.cddl

Payload = &(
    SecretKey_Tagged,
    Arc_Tagged,
    ; Any other payload types should also be defined as tags, with unassigned tag numbers taken from
    ; https://www.iana.org/assignments/cbor-tags/cbor-tags.xhtml
)

SecretKey_Tagged = #6.6(SecretKey) ; SecretKey = COSE_Key - see the  SecretKey definition below
Arc_Tagged = #6.16(Arc)            ; Arc = COSE_Encrypt0 - see the Arc definition above

SecretKey = &(                     ; One of the payload types of an Arc is a secret key
        SymmetricKey,
        ECPrivateKey,
)

ECPrivateKey = &(    ; Private key of a key pair generated for key agreement
    PrivateKeyX25519,
    PrivateKeyP256,
)

PrivateKeyX25519 = {                  ; COSE_Key
    1 : 1,                            ; Key type : Octet Key Pair
    3 : -25,                          ; Algorithm: ECDH ES w/ HKDF 256 - generate key directly
    4 : [7],                          ; Key_ops: [derive key]
   -1 : 4                             ; Curve: X25519
   -4 : bstr                          ; private key
}

PrivateKeyP256 = {            ; COSE_Key
    1 : 2,                    ; Key type : EC2
    3 : -25,                  ; Algorithm: ECDH ES w/ HKDF 256 - generate key directly
    4 : [7],                  ; Key_ops: [derive key]
   -1 : 1,                    ; Curve: P-256
 ? -2 : bstr,                 ; x coordinate
 ? -3 : bstr,                 ; y coordinate
   -4 : bstr,                 ; private key
}

SymmetricKey = {              ; COSE_Key - For symmetric key encryption
    1 : 4,                    ; Key type : Symmetric
    3 : 3,                    ; Algorithm : AES-GCM mode w/ 256-bit key, 128-bit tag
    4 : [ 4 ],                ; Key_ops: [decrypt]
   -4 : bstr .size 32,        ; Key value
}

ArcEncStruct = [              ; COSE_Enc_structure
    context   : "Encrypt0",
    protected : bstr .cbor ArcProtectedHeaders,
    external_aad : bstr .size 0,
]
