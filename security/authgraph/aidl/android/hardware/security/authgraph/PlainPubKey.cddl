; P-256 public key for key agreement.
PlainPubKey = [ ; COSE_Key [RFC9052 s7]
    1 : 2,                       ; Key type : EC2
    ; TODO: check what algorithm should be here
    3 : -27,                     ; Algorithm : ECDH-SS + HKDF-256
    -1 : 1,                      ; Curve: P256
    -2 : bstr,                   ; X coordinate, big-endian
    -3 : bstr                    ; Y coordinate, big-endian
]
