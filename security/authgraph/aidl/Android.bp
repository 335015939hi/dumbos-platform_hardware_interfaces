aidl_interface {
    name: "android.hardware.security.authgraph",
    vendor_available: true,
    srcs: [
        "android/hardware/security/authgraph/*.aidl",
    ],
    stability: "vintf",
    frozen: false,
    backend: {
        java: {
            platform_apis: true,
        },
        ndk: {
            apps_enabled: false,
        },
        rust: {
            enabled: true,
        },
    },
}
