package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_interfaces_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_interfaces_license"],
}

aidl_interface {
    name: "android.security.identity.direct_access",
    vendor_available: true,
    srcs: [
        "android/security/identity/direct_access/*.aidl",
    ],
    imports: [
        "android.hardware.keymaster-V3",
        "android.hardware.security.rkp-V3",
        "android.hardware.identity-V5",
    ],
    stability: "vintf",
    frozen: false,
    backend: {
        java: {
            platform_apis: true,
        },
        ndk: {
            apps_enabled: false,
        },
    },
}

// cc_defaults that includes the latest Identity AIDL library.
// Modules that depend on Identity directly can include this cc_defaults to
// avoid managing dependency versions explicitly.
cc_defaults {
    name: "identity_direct_use_latest_hal_aidl_ndk_static",
    static_libs: [
        "android.security.identity.direct_access-V1-ndk",
    ],
}

cc_defaults {
    name: "identity_direct_use_latest_hal_aidl_ndk_shared",
    shared_libs: [
        "android.security.identity.direct_access-V1-ndk",
    ],
}

cc_defaults {
    name: "identity_direct_use_latest_hal_aidl_cpp_static",
    static_libs: [
        "android.security.identity.direct_access-V1-cpp",
    ],
}
