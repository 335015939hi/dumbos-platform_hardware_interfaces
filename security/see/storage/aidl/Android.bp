package {
    default_applicable_licenses: ["hardware_interfaces_license"],
}

aidl_interface {
    name: "android.hardware.security.see.storage",
    srcs: [
        "android/hardware/security/see/storage/*.aidl",
        "android/hardware/security/see/storage/result/*.aidl",
    ],
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
        rust: {
            enabled: true,
        },
    },
}
