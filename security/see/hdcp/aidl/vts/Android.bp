package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_interfaces_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_trusty",
}

rust_test {
    name: "VtsAidlHdcpNonExistentTest",
    srcs: ["src/host_test.rs"],
    require_root: true,
    test_suites: [
        "general-tests",
        "vts",
    ],
    rustlibs: [
        "libbinder_rs",
    ],
}

rust_defaults {
    name: "hdcp.defaults",
    crate_name: "vm",
    defaults: ["avf_build_flags_rust"],
    edition: "2021",
    prefer_rlib: true,
    rustlibs: [
        "libanyhow",
        "libbinder_rs",
        // "librpcbinder_rs",
        "libcfg_if",
        "liblog_rust",
    ],
}

rust_test {
    name: "VtsAidlHdcpAuthControlTest",
    defaults: ["hdcp.defaults"],
    srcs: ["src/vm_test.rs"],
    require_root: true,
    test_suites: [
        "general-tests",
        "vts",
    ],
    rustlibs: [
        "android.hardware.security.see.hdcp-rust",
        "android.hardware.drm-V1-rust",
    ],
}

sh_test {
    name: "VtsHalHdcpAuthControlTargetTest",
    src: ":empty_file",
    data: [":TrustyTestVM_UnitTests"],
    test_suites: [
        "general-tests",
        "vts",
    ],
    test_config_template: "AndroidTest.xml",
    enabled: false,
    arch: {
        x86_64: {
            enabled: true,
        },
    },
}
