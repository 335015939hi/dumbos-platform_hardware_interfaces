      "writtenOn": "2021-03-24T03:34:42Z",
      "side": 1,
      "message": "No, sorry. This data is used in the certificate signing request that goes to the server. After verification of the bundle against the known public key for the device on the server side, the server can use this DeviceInfo data structure to make decisions about whether or not the CSRs *should* be signed.\n\nPatch level with respect to wrapping the actual keys on device just applies to the private key blob returned in the generate key call in IRemotelyProvisionedComponent HAL, and the upgrading of these keys so that they stay usable is handled like any other KM key.",
      "parentUuid": "491bc763_f2ba414a",
      "range": {
        "startLine": 21,
        "startChar": 74,
        "endLine": 23,
        "endChar": 47
      },
      "revId": "ac60f8ae3edfad0601ac4d15f1007d16e4c6216e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
