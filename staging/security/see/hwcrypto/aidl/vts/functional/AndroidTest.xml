    <configuration description="Runs VtsHalHWCryptoKeyTargetTest">
    <object type="module_controller" class="com.android.tradefed.testtype.suite.module.CommandSuccessModuleController" >
        <!-- Skip the test when trusty VM is not enabled. -->
        <option name="run-command" value="getprop ro.hardware.security.trusty_vm.system | grep -v true" />
    </object>
    <!-- Target Preparers - Run Shell Commands -->
    <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
        <option name="cleanup" value="true" />
        <option name="push" value="trusty-ut-ctrl.sh->/data/local/tmp/trusty-ut-ctrl.sh" />
    </target_preparer>
    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer" />

    <test class="com.android.tradefed.testtype.binary.ExecutableTargetTest" >
        <option name="parse-gtest" value="true" />
        <option name="test-command-line" key="com.android.trusty.rust.hwcryptohalserver.test" value="/data/local/tmp/trusty-ut-ctrl.sh com.android.trusty.rust.hwcryptohalserver.test"/>
        <option name="test-command-line" key="com.android.trusty.rust.hwcryptohal_common.test" value="/data/local/tmp/trusty-ut-ctrl.sh com.android.trusty.rust.hwcryptohal_common.test"/>
    </test>
    </configuration>
