package android.hardware.health@2.0;

import android.hardware.health@1.0::BatteryStatus;
import android.hardware.health@1.0::Result;

import IHealthInfoCallback;

/**
 * IHealth manages health info and posts events on registered callbacks.
 */
interface IHealth {

    /**
     * Register a callback for any health info events.
     *
     * Clients may explicitly call {@link unregisterCallback} to unregister it.
     *
     * @param callback the callback to register.
     * @return result SUCCESS if successful,
     *                UNKNOWN for other errors.
     */
    registerCallback(IHealthInfoCallback callback)
          generates (Result result);

    /**
     * Explicitly unregister a callback that is previously registered through
     * {@link registerCallback}.
     *
     * @param callback the callback to unregister
     * @return result SUCCESS if successful,
     *                UNKNOWN if callback is not registered previously
     *                UNKNOWN for other errors.
     */
    unregisterCallback(IHealthInfoCallback callback)
            generates (Result result);

    /**
     * Get a property as an integer value.
     *
     * This function must return the same value as
     * {@code getRawProperty((int32_t)id, ...)} except that the returned value
     * is parsed as an integer.
     *
     * @param id the property to get
     * @return result SUCCESS if successful,
     *                NOT_SUPPORTED if device does not have this property
     *                     (e.g. the file that the service retrieve this
     *                     property is not present).
     *                UNKNOWN for other errors.
     * @return value value of the property, or INT64_MIN if not successful.
     */
    getProperty(PropertyId id) generates (Result result, int64_t value);

    /**
     * Get a raw property as a string value.
     *
     * If id is one of the values in {@link PropertyId}, {@code value} must
     * be the string representation of the integer value returned by
     * {@code getProperty((PropertyId)id, ...)}.
     *
     * @param id the property to get
     * @return result SUCCESS if successful,
     *                NOT_SUPPORTED if device does not have this property
     *                     (e.g. the file that the service retrieve this
     *                     property is not present).
     *                UNKNOWN for other errors.
     * @return value value of the property, or empty string if not successful.
     */
    getRawProperty(int32_t id) generates (Result result, string value);

    /**
     * Schedule update.
     *
     * @return result SUCCESS if successful or other values of {@link Result}
     *                on any error.
     */
    update() generates (Result result);
};
