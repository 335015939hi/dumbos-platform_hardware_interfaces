        "filename": "radio/1.6/IRadio.hal",
        "patchSetId": 18
      },
      "lineNbr": 507,
      "author": {
        "id": 1002609
      },
      "writtenOn": "2021-03-10T02:43:13Z",
      "side": 1,
      "message": "I\u0027m willing to forego the extra token..  What I really want is a response that just goes just to the caller of getPhonebookRecords, but that\u0027s hard to do today.  We can resolve the token issue in the future - perhaps when we go to AIDL.\n\nI think we should also add \"Sim\" to the name: getSimPhonebookRecords",
      "parentUuid": "e560aff0_40b601df",
      "range": {
        "startLine": 507,
        "startChar": 39,
        "endLine": 507,
        "endChar": 45
      },
      "revId": "29bd6a45f5f46c53a5082e83035d9ffc9a0160c3",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
