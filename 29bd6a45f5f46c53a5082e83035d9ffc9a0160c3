    },
    {
      "unresolved": false,
      "key": {
        "uuid": "5a41e506_eaeb65a2",
        "filename": "radio/1.6/IRadioIndication.hal",
        "patchSetId": 18
      },
      "lineNbr": 142,
      "author": {
        "id": 1156349
      },
      "writtenOn": "2021-03-09T10:22:31Z",
      "side": 1,
      "message": "About the token argument, we already replied it here https://android-review.googlesource.com/c/platform/hardware/interfaces/+/1441011/18/radio/1.6/IRadio.hal#507, personally we want to leave it.\n\nFor pbReceivedStatus, RIL doesn\u0027t have the error status. For continues/done, it still relates to the math comment above. In summary, the math check is needed, the only qn is who should handle it, RIL or telephony. Either is doable. We could follow your final decision 😊.",
      "parentUuid": "3a55a9ac_8aaae7b1",
      "range": {
        "startLine": 142,
        "startChar": 36,
        "endLine": 142,
        "endChar": 55
      },
