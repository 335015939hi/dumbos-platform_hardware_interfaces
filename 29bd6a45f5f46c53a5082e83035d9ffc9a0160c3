      "key": {
        "uuid": "984199da_03b6bdd8",
        "filename": "radio/1.6/IRadioIndication.hal",
        "patchSetId": 18
      },
      "lineNbr": 139,
      "author": {
        "id": 1002609
      },
      "writtenOn": "2021-03-10T02:43:13Z",
      "side": 1,
      "message": "I think we should call this simPhonebookRecordsRecieved.\n\nI still think we should have a status indicator: ok, error, final.\n\nI don\u0027t want the interface between the vendor code and the AP dependent on the number remaining fixed between the beginning of the chunked transfer and the end.  If the QMI implementation requires the RIL do math, that\u0027s QC specific and shouldn\u0027t leak across the RIL.",
      "parentUuid": "459b92a7_aa5a6168",
      "range": {
        "startLine": 139,
        "startChar": 0,
        "endLine": 139,
        "endChar": 99
      },
