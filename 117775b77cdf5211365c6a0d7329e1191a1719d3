      "writtenOn": "2018-01-04T23:02:25Z",
      "side": 1,
      "message": "It seems like NONE and IDLE_CAMPED are similar to the registered field in CellInfo. Can we remove these altogether and just have PRIMARY/SECONDARY?",
      "range": {
        "startLine": 68,
        "startChar": 4,
        "endLine": 75,
        "endChar": 16
      },
      "revId": "117775b77cdf5211365c6a0d7329e1191a1719d3",
