        "id": 1042638
      },
      "writtenOn": "2023-01-18T23:43:28Z",
      "side": 1,
      "message": "This seems to be a bit expensive to copy considering all the collections that it holds. I would consider either using a reference here, which would imply that owner of Config must also own the converter, or use shared_ptr for managing the instance of the converter.",
      "range": {
        "startLine": 30,
        "startChar": 20,
        "endLine": 30,
        "endChar": 71
      },
      "revId": "7438b1918bf6ae9724ac759c370daac3eebd7961",
