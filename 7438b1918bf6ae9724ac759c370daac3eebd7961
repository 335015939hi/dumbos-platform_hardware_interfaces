    },
    {
      "unresolved": true,
      "key": {
        "uuid": "50deb2ee_e7b1fa54",
        "filename": "audio/aidl/default/include/core-impl/Module.h",
        "patchSetId": 10
      },
      "lineNbr": 47,
      "author": {
        "id": 1042638
      },
      "writtenOn": "2023-01-18T23:43:28Z",
      "side": 1,
      "message": "Note that this makes a copy from the value referenced by `config`. If you intended to use a move constructor, you need to use `std::move(config)` here.",
      "range": {
        "startLine": 47,
        "startChar": 86,
        "endLine": 47,
        "endChar": 92
      },
      "revId": "7438b1918bf6ae9724ac759c370daac3eebd7961",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
