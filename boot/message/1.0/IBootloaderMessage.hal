package android.hardware.boot.message@1.0;

interface IBootloaderMessage {
    /**
     * Reads the bootloader message from storage.
     *
     * @return result Result of the operation. If the operation fails, the result.errorMessage must
     * be populated with the human-readable error message.
     * @return message If the operation succeeds, constructs and returns the Message struct with
     * stored value.
     */
    readBootloaderMessage() generates (CommandResult result, Message message);

    /**
     * Writes the bootloader message into storage.
     *
     * @param message The Message struct to write to the storage.
     *
     * @return result Result of the operation. If the operation fails, the result.errorMessage must
     * be populated with the human-readable error message.
     */
    writeBootloaderMessage(Message message) generates (CommandResult result);

    /**
     * Overwrites the command and recovery fields of the bootloader message in the storage.
     *
     * @param options A list of command line arguments passed to the recovery in strings. Each
     * option should be understood by the getopt function. Then recovery field is constructed based
     * the provided options.
     * @param clear_fields Whether the Message fields other than command and recovery should be
     * cleared, i.e. False if the value in these fields should be preserved.
     *
     * @return result Result of the operation. If the operation fails, the result.errorMessage must
     * be populated with the human-readable error message.
     */
    updateBootloaderMessageWithRecoveryOptions(vec<string> options, bool clear_fields)
        generates (CommandResult result);

    /**
     * Reads the wipe package from storage.
     *
     * @param package_size The size in bytes of the wipe package to read.
     *
     * @return result Result of the operation. If the operation fails, the result.errorMessage must
     * be populated with the human-readable error message.
     * @return package_data If the operation succeeds, it's filled with the contents of the wipe
     * package.
     */
    readWipePackage(uint32_t package_size)
        generates (CommandResult result, vec<uint8_t> package_data);

    /**
     * Writes the wipe package to storage.
     *
     * @param package_data The content of the wipe package to write. The package must has the format
     * of a A/B wipe package. Specifically, it should be a zip file containing the OTA certificates,
     * the metadata, and optionally a list of partitions to wipe.
     *
     * @return result Result of the operation. If the operation fails, the result.errorMessage must
     * be populated with the human-readable error message.
     */
    writeWipePackage(vec<uint8_t> package_data) generates (CommandResult result);
};
