        "uuid": "b0ec5eee_25a4814e",
        "filename": "security/keymint/aidl/android/hardware/security/keymint/ProtectedData.aidl",
        "patchSetId": 4
      },
      "lineNbr": 154,
      "author": {
        "id": 1115498
      },
      "writtenOn": "2022-04-27T17:49:37Z",
      "side": 1,
      "message": "Authority hash should be required.",
      "range": {
        "startLine": 154,
        "startChar": 15,
        "endLine": 154,
        "endChar": 16
      },
      "revId": "12abac21ccec397b59f9724d12d7088f5208c6c4",
