      "message": "Done",
      "parentUuid": "f5a3b3cd_ba5c3758",
      "range": {
        "startLine": 148,
        "startChar": 0,
        "endLine": 149,
        "endChar": 83
      },
      "revId": "12abac21ccec397b59f9724d12d7088f5208c6c4",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
