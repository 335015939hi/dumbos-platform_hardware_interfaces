      },
      "writtenOn": "2022-04-27T17:49:37Z",
      "side": 1,
      "message": "Each of these fields within the Descriptor map is optional, depending on if they make sense for a given stage. If none are applicable for a given stage, `Configuration Descriptor` may be an empty map.",
      "range": {
        "startLine": 150,
        "startChar": 0,
        "endLine": 152,
        "endChar": 69
      },
