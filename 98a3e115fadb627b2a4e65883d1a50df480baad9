    {
      "key": {
        "uuid": "f07c1c23_9b3fc94c",
        "filename": "health/2.0/vts/functional/VtsHalHealthV2_0TargetTest.cpp",
        "patchSetId": 3
      },
      "lineNbr": 412,
      "author": {
        "id": 1121838
      },
      "writtenOn": "2020-01-30T23:02:11Z",
      "side": 1,
      "message": "I was meant to check that if batteryPresent \u003d false, batteryCurrent must be 0.\n\nAlthough, why can\u0027t we require them to report 0 when batteryStatus is UNKNOWN? I thought it can only be UNKNOWN if batteryPresent is false.",
      "parentUuid": "46adcd53_d4ef65f4",
      "revId": "98a3e115fadb627b2a4e65883d1a50df480baad9",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
