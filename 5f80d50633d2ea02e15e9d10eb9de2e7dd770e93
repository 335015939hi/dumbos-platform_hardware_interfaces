      },
      "lineNbr": 56,
      "author": {
        "id": 1956242
      },
      "writtenOn": "2022-10-18T22:13:19Z",
      "side": 1,
      "message": "Because we are using std::vector to represent instead of a fixed size array, and it\u0027s possible framework size to do something like: setParameter({1 /* band index */, 0 /* gain level */}) to set a specific band only.",
      "parentUuid": "65b56585_bad3e04c",
      "range": {
        "startLine": 56,
        "startChar": 0,
        "endLine": 56,
        "endChar": 40
      },
