package android.hardware.credential@1.0;

/***
 * ICredentialStore provides an interface to a secure store for user identity documents.  This HAL
 * is deliberately fairly general and abstract.  To the extent possible, specification of the
 * message formats and semantics of communication with EID verification devices and issuing
 * authorities (IAs) is out of scope for this HAL.  It provides the interface with secure storage
 * but an EID-specific Android application will be required to implement the presentation and
 * verification protocols and processes appropriate for the specific credential type.
 *
 * The design of this HAL makes few assumptions about the underlying secure hardware.  In particular
 * it does not assume that the secure hardware has any storage beyond that needed for a persistent,
 * hardware-bound AES-256 key.  However, it also enables the use of secure hardware that does have
 * storage, specifically to enable "direct access".  Most often, Credentials will be accessed
 * through this HAL and through the Android system layer above it, but that requires that the
 * Android device be powered up and fully functional.  It is desirable to allow Credential usage in
 * the case where the Android device's battery is too low to boot the Android operating system.  In
 * this case, direct access to the secure hardware via NFC can allow data retrieval.  The caller can
 * specify when name/value pairs are created that they should be "directly accessible", meaning
 * accessible in low power mode, which implies that low power-accessible name/value pairs must be
 * stored in secure hardware, which further implies that the number and size of low power-available
 * values will be limited, so callers should use this feature sparingly.  Definition of how data is
 * retrieved in low power mode is explicitly out of scope for this HAL specification; it's up to the
 * relevant EID standards to define.
 *
 * Multiple Credentials can be created.  Each Credential contains:
 *
 * - A set of name/value pairs.  Names and values are unstructured byte sequences of arbitrary
 *   length.  Each name/value pair also has an associated set of access profile IDs, which define
 *   the policy for retrieving.  In addition, each name/value pair has a digest specification, which
 *   describes how the value is digested for signing.
 *
 * - A set of access control profiles, each with a profile ID and a specification of the
 *   conditions which satisfy the profile's requirements.
 *
 * - An issuing authority (IA) public key, which is used to authenticate the IA.
 *
 * - An assymmetric key pair which is used to authenticate the Credential to the IA.
 *
 * - A set of zero or more named Reader authentication public keys, which are used to authenticate
 *   an authorized reader to the Credential.
 *
 * - A set of named signing keys, which are used to sign collections of values.
 *
 * - An optional credential type string.  This is a hint to secure hardware that may offer access to
 *   the same Credential data through an alternative interface.
 *
 * Cryptographic notation:  Throughout this HAL, cryptographic operations are specified in detail.
 * To avoid repeating the definition of the notation, it's specified here.  It is assumed that the
 * reader is familiar with standard cryptographic algorithms and constructs.
 *
 *     AES-GCM(K, N, D, A) represents AES-GCM encryption with key 'K', nonce 'N', additional
 *         authenticated data 'A' and data 'D'.  The nonce is usually specified as 'R', meaning 12
 *         random bytes.  The nonce is prepended to the ciphertext. The GCM tag is 16 bytes,
 *         appended to the ciphertext.
 *
 *    || represents concatenation
 *
 *    {} represents an empty input; 0 bytes of data.
 *
 *    HBK represents a device-unique, hardware-bound AES-256 key which exists only in secure
 *        hardware, except for "test" EIDStores (see createStore, below).  For test EIDStores, an
 *        all-zero value is used in place of the HBK.
 *
 * Data encoding notation: Various fields need to be encoded as precisely-specified byte arrays.
 * Where existing standards define appropriate encodings, those are used.  For example, X.509
 * certificates.  Where new encodings are needed, CBOR is used.  CBOR maps are described in JSON
 * notation with string keys and values expressed as a data type and either a description of the
 * contents or a label that is further defined below the map.  Fields in these maps must always be
 * in the order specified, and integers must always be encoded in the smallest possible CBOR
 * representation.  For example:
 *
 * {
 *    "field1" : (byte string) field1,
 *    "field2" : (unsigned integer) field2,
 * }
 *
 * Following the map structure, the semantics and content of each field will be described.
 *
 * TODO(swillden): Decide if we need to add cryptographic algorithm agility across the board (seems
 * like a good idea) and whether we need to support multiple algorithms now (prefer to avoid).
 * Right now this HAL uses AES-GCM for all encryption and data authentication, ECDSA for all signing
 * and ECDH for all key agreement.  The curve or curves need to be specified as well.
 */
interface ICredentialStore {

    /**
     * createCredential creates a new Credential.  When a Credential is created, two cryptographic
     * keys are created: CredentialSecret, an AES key used to secure the externalized Credential
     * contents, and CredentialKeyPair, an EC key pair used to authenticate the store to the IA.  In
     * addition, all of the Credential data content is imported and a certificate for the
     * CredentialKeyPair and a signature produced with the CredentialKeyPair are created.  These
     * latter values may be checked by an issuing authority to verify that the data was imported
     * into secure hardware and that it was imported unmodified.
     *
     * @param iaKeyCertificate is an X.509 certificate containing the IA public key.  If the key
     *     usage attributes specify that the key is a CA signing key, then keys with certificates
     *     signed by this key are also authorized to authenticate as the IA.
     *
     * @param credentialType is an optional name (may be an empty string) that identifies the type
     *     of credential being created, e.g. org.iso.18013 (ISO 18013 is the ISO driving license
     *     standard).  It serves as a hint to secure hardware that may offer the Credential data
     *     through another interface.
     *
     * @param entries contains the data to provision.
     *
     * @param issuerSignature is a signature provided by the issuer, all of the individual data
     *     element digests and possibly other data included.  Issuers may want to use the RFC 3369
     *     SignedData type to structure the contents of this argument.  However, ICredentialStore
     *     implementations treat it as an opqaue blob.
     *
     * @param testCredential indicates if this is a test store.  Test credentials must use an
     *     all-zeros hardware-bound key (HBK; see storeDescriptor below) and must set the test bit
     *     in the credentialCertificate.
     *
     * @return error returns ... TODO(swillden): enumerate possible error codes.
     *
     * @return credentialBlob is an encrypted byte array that contains data used to secure the
     *     credential.  It contains:
     *
     *         {
     *             "credentialData", (byte string) AES-GCM(HBK, R, credentialKeys, iaKeyCertificate)
     *             "iaKeyCertificate", (byte string) X.509 certificate of IA public key
     *         }
     *
     *         where CredentialKeys is the following CBOR map:
     *
     *         {
     *              "storageKey" : (byte string) 256-bit AES key
     *              "credentialPrivKey" : (byte string) EC private key, in PKCS#8 format.
     *         }
     *
     * @return entryBlobs is a vector of byte vectors, one for each entry in the credential.
     *
     * @return credentialAttestation is a signed data structure that proves to the IA that the
     *     credential was imported into the secure hardware without alteration or error.  The IA
     *     uses credentialAttestation and credentialKeyCert to decide if it trusts the imported
     *     Credential.  If the IA trusts the Credential, it should certify signing keys from the
     *     credential.  The credentialAttestation contains:
     *
     *         {
     *             "signedData" : (map) signedData,
     *             "credentialCert" : (byte string) credentialCert,
     *             "signature" : (byte string) signature over signedData withh credentialPrivKey.
     *         }
     *
     *     where credentialCert contains an X.509 certificate for credentialKey, signed by the
     *     Keymaster attestation key (see IKeymasterDevice HAL).
     *
     *     signedData contains:
     *
     *         {
     *             "iaKeyCertificate" : (byte string) iaKeyCertificate,
     *             "credentialType" : (string) credentialType,
     *             "accessControlProfiles" : (array of maps) accessControlProfiles,
     *             "entries" : (array of maps) entries,
     *             "issuerSignature" : (byte string) issuerSignature,
     *             "testCredential" : (unsigned integer) 0 if testCredential is false, 1 if true
     *         }
     *
     *     where each accessControlProfile is encoded as:
     *
     *      {
     *          "id": (unsigned integer) id,
     *          "readerAuthPubKey" : (byte string) readerAuthPubKey,
     *          "userAuthenticationId": (byte string) userAuthenticationId,
     *          "timeout": (unsigned integer) timeout
     *      }
     *
     *      and each entry is encoded as:
     *
     *      {
     *          "name" : (binary string) name,
     *          "value" : (binary string) value,
     *          "issuerSignature" : (binary string) issuerSignature,
     *          "accessControlProfiles" : (array of unsigned integers) accessControlProfileIds,
     *      }
     */
    createCredential(vec<uint8_t> iaKeyCertificate, string credentialType,
		     vec<AccessControlProfile> accessControlProfiles, vec<EntryConfiguration> entries,
		     vec<uint8_t> issuerSignature, bool testCredential)
	generates (ErrorCode error, CredentialBlob credentialBlob,
		   vec<SecureAccessControlProfile> accessControlProfiles, vec<SecureEntry> entries,
		   vec<uint8_t> credentialAttestation);

    /**
     * getCredential retrieves an ICredential HIDL interface which allows use of a stored
     * Credential.
     *
     * @param credentialBlob is an encrypted byte array that contains data used to secure the
     *     credential.  See the return argument of the same name in createCredential().
     *
     * @return credential is an ICredential HIDL interface that provides operations on the
     *     Credential.
     */
    getCredential(vec<uint8_t> credentialBlob)
	generates (ErrorCode error, ICredential credential);
}
