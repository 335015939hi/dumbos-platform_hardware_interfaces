      "unresolved": true
    },
    {
      "key": {
        "uuid": "8f0fab51_8072bd75",
        "filename": "fastboot/1.1/IFastboot.hal",
        "patchSetId": 6
      },
      "lineNbr": 32,
      "author": {
        "id": 1483435
