      "writtenOn": "2022-11-01T21:34:50Z",
      "side": 1,
      "message": "Can we use this opportunity to increase the number of bits for buffer usage ? The limited number of bits has long been a concern.",
      "range": {
        "startLine": 59,
        "startChar": 16,
        "endLine": 59,
        "endChar": 21
      },
      "revId": "dad0139a0635c14293a74581179e16f0574a4670",
