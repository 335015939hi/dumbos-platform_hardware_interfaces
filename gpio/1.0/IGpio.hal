package android.hardware.gpio@1.0;

interface IGpio {
    /**
     * Get a string vector of gpio names specified by the device.
     *
     * @return gpios array of gpio names.
     */
    listGpio() generates (vec<string> gpioList);

    /**
     * Write a value to a gpio.
     *
     * @param gpioName name of gpio as returned by listGpio();
     * @param value value (HIGH, LOW) to write to the gpio.
     * @return status result of applying state transformation.
     */
    writeGpio(string gpioName, Value value) generates (Status status);

    /**
     * Read a value from a gpio.
     *
     * @param gpioName name of gpio as returned by listGpio().
     * @return value value (HIGH, LOW, UNKNOWN_GPIO) of gpio with gpioName.
     */
    readGpio(string gpioName) generates (Value value);

    /**
     * Set the direction (IN, OUT) of a gpio.
     *
     * @param gpioName name of gpio as returned by listGpio().
     * @param direction direction of the gpio (IN, OUT).
     * @return status result of applying state transformation.
     */
    setDirectionGpio(string gpioName, Direction direction)
            generates (Status status);

    /**
     * Get the direction (IN, OUT) of a gpio.
     *
     * @param gpioName name of gpio as returned by listGpio().
     * @return direction direction of the gpio (IN, OUT).
     */
    getDirectionGpio(string gpioName) generates (Direction direction);

};
