package android.hardware.dumpstate@1.0;

enum StdoutMode : uint32_t {
    /* Don't change stdout. */
    NORMAL_STDOUT      = 0,
    /* Redirect stdout to `stderr`. */
    REDIRECT_TO_STDERR = 1
};

/*
 * Options that change the behavior of a command.
 */
struct CommandOptions {
  /* How long dumpstate should wait for the command completion in milliseconds. */
  uint32_t timeoutMs;

  /* If true, command will always run, even when dumpstate is runing on dry-run mode. */
  bool always;

  /* Whether the command should be running as 'su root'
     NOTE: There is no guarantee 'su' is available; in fact, most likely it's not unless the device
     is using an userbuild or eng build. */
  bool asRoot;

  /* Defines what should happen with the stdout stream of a command. */
  StdoutMode stdoutMode;

  /* Optional message logged on logcat before the command runs. */
  string loggingMessage;
};
