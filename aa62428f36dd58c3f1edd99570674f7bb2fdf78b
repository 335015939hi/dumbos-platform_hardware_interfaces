      "writtenOn": "2022-11-30T22:18:29Z",
      "side": 1,
      "message": "These constants must be defined in the AIDL file (hardware/interfaces/audio/aidl/android/hardware/audio/effect/BassBoost.aidl). Thanks for revealing this issue with the interface definition!",
      "range": {
        "startLine": 48,
        "startChar": 0,
        "endLine": 49,
