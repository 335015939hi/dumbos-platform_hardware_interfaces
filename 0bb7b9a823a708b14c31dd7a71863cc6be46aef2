      "parentUuid": "90c122cf_a1c5a55d",
      "range": {
        "startLine": 250,
        "startChar": 28,
        "endLine": 250,
        "endChar": 40
      },
      "revId": "0bb7b9a823a708b14c31dd7a71863cc6be46aef2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
