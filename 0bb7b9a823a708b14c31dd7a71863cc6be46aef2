      "author": {
        "id": 1590836
      },
      "writtenOn": "2023-05-19T22:57:35Z",
      "side": 1,
      "message": "Done. \nIt is cached so that we don\u0027t have to find it in the vector on every method call.",
      "parentUuid": "9fe00678_12950fbd",
      "range": {
        "startLine": 119,
        "startChar": 33,
        "endLine": 119,
        "endChar": 45
