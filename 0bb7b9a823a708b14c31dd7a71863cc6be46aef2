    {
      "unresolved": true,
      "key": {
        "uuid": "09f37145_9c240cbf",
        "filename": "audio/aidl/default/remoteSubmix/StreamRemoteSubmix.cpp",
        "patchSetId": 8
      },
      "lineNbr": 294,
      "author": {
        "id": 1042638
      },
      "writtenOn": "2023-05-19T16:19:41Z",
      "side": 1,
      "message": "Nested lock use creates a possibility of a deadlock if another thread is attempting to take the same two locks in a different order (see an example here: https://www.ibm.com/docs/en/order-management-sw/10.0?topic\u003dcaching-sort-order-deadlocks). We must either never hold two locks together, or explicitly declare which one must be taken first, and ensure that all threads take these two locks in the same order.",
      "range": {
        "startLine": 292,
        "startChar": 0,
        "endLine": 294,
        "endChar": 37
      },
      "revId": "0bb7b9a823a708b14c31dd7a71863cc6be46aef2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
