    {
      "unresolved": true,
      "key": {
        "uuid": "90c122cf_a1c5a55d",
        "filename": "audio/aidl/default/remoteSubmix/StreamRemoteSubmix.cpp",
        "patchSetId": 8
      },
      "lineNbr": 250,
      "author": {
        "id": 1042638
      },
      "writtenOn": "2023-05-19T16:19:41Z",
      "side": 1,
      "message": "Note that we are accessing `mSubmixRoute` from a different (non-worker) thread (see `DriverInterface`), which was assigning it (`DriverRemoteSubmix::init`). Thus, `mSubmixRoute` must be marked as `GUARDED_BY(mLock)`, and we must take it here.",
      "range": {
        "startLine": 250,
        "startChar": 28,
        "endLine": 250,
        "endChar": 40
      },
      "revId": "0bb7b9a823a708b14c31dd7a71863cc6be46aef2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
