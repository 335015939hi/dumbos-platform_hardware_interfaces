package android.hardware.identity_credential@1.0;

import android.hardware.keymaster.capability@1.0::CapabilityType;
import android.hardware.keymaster.capability@1.0::KeymasterCapability;

enum SecurityType : uint8_t {
    /**
     * Indicates that the Identity Credential Store is implemented in Android. The implementation
     * runs in a separate process that has restricted access and a narrow attack surface, but an
     * attacker who compromises the Android kernel can obtain the private CredentialKey and bypass
     * the access control requirements specified during provisioning.
     */
    SOFTWARE_ONLY = 0,

    /**
     * Indicates that the Identity Credential store is implemented in a Trusted Execution
     * Environment.  This means it executes on the same CPU or set of CPUs as Android kernel and
     * user code, but in an isolated environment.  To obtain the private CredentialKey or bypass the
     * access control requirements specified during provisioning, an attacker would need to
     * compromise the Trusted Execution Environment; compromising Android, even the kernel, would
     * not be sufficient.  However, because Trusted Execution Environments share resources with the
     * CPU running Android, it is possible that side channel attacks could extract data or secrets.
     * In addition, Trusted Execution Environments are not designed to resist attacks on the
     * physical hardware.
     */
    TRUSTED_EXECUTION_ENVIRONMENT = 1,

    /**
     * Indicates that the Identity Credential store is implemented in a separate CPU from the
     * processor(s) that run Android kernel and user code, but that the security CPU is embedded in
     * the same physical package as the Android processor(s).  Embedded secure CPUs are designed to
     * resist physical hardware attacks.  Barring some egregious implementation error, this sort of
     * implementation is strictly more secure than one that runs in a TRUSTED_EXECUTION_ENVIRONMENT,
     * and has some security advantages and some security disadvantages as compared to a
     * DISCRETE_SECURE_CPU.  This sort of implementation is almost certainly not capable of
     * supporting direct access, though, so credentials will only be usable when the Android device
     * is fully-powered.
     */
    EMBEDDED_SECURE_CPU = 2,

    /**
     * Indicates that the Identity Credential store is implemented in a separate CPU from the
     * processor(s) that run Android and user code, and the CPU is in a discrete, purpose-built
     * package and includes its own internal storage.  Discrete secure CPUs are designed to resist
     * physical hardware attacks.  Barring some egregious implementation error, this sort of
     * implementation is strictly more secure than one that runs in a TRUSTED_EXECUTION_ENVIRONMENT,
     * and has some security advantages and some security disadvantages as compared to a
     * EMBEDDED_SECURE_CPU. This sort of implementation may be capable of supporting direct access.
     */
    DISCRETE_SECURE_CPU = 3,
};

enum Certification : uint8_t {
    /**
     * Indicates that the Identity Credential store implementation has been evaluated for security
     * and certified.  The security hardware was evaluated against the Secure IC Protection Profile
     * (https://www.commoncriteriaportal.org/files/ppfiles/pp0084b_pdf.pdf).  In addition, the
     * firmware was evaluated by a nationally accredited testing laboratory against the "High"
     * attack potential standard defined in Common Criteria Application of Attack Potential to
     * Smartcards (https://www.commoncriteriaportal.org/files/supdocs/CCDB-2013-05-002.pdf).
     */
    CC_EAL_4_PLUS = 0,

    /**
     * Indicates that the Identity Credential store implementation has been evaluated for security
     * and certified.  The security hardware was evaluated against the Secure IC Protection Profile
     * (https://www.commoncriteriaportal.org/files/ppfiles/pp0084b_pdf.pdf), with the protection
     * profile's requirmenents increased to require Common Criteria Evaluation Assurance Level 5.
     * In addition, the firmware was evaluated by a nationally accredited testing laboratory against
     * the "High" attack potential standard defined in Common Criteria Application of Attack
     * Potential to Smartcards
     * (https://www.commoncriteriaportal.org/files/supdocs/CCDB-2013-05-002.pdf).
     */
    CC_EAL_5_PLUS = 1,

    /**
     * Indicates that the Identity Credential store implementation has been evaluated for security
     * and certified.  The security hardware was evaluated against the Secure IC Protection Profile
     * (https://www.commoncriteriaportal.org/files/ppfiles/pp0084b_pdf.pdf), with the protection
     * profile's requirmenents increased to require Common Criteria Evaluation Assurance Level 6.
     * In addition, the firmware was evaluated by a nationally accredited testing laboratory against
     * the "High" attack potential standard defined in Common Criteria Application of Attack
     * Potential to Smartcards
     * (https://www.commoncriteriaportal.org/files/supdocs/CCDB-2013-05-002.pdf).
     */
    CC_EAL_6_PLUS = 2,
};

enum ResultCode : int32_t {
    /**
     * Success.
     */
    OK = 0,

    /**
     * The operation failed. This is used as a generic catch-all for errors that don't belong
     * in other categories, including memory/resource allocation failures and I/O errors.
     */
    FAILED = 1,

    /**
     * The passed data was invalid. This covers both cases where decryption and decoding fails.
     */
    INVALID_DATA = 2,

    /**
     * An access condition was not satisfied.
     */
    ACCESS_DENIED = 3,

    /**
     * The readerSignature field in StartRetrievalArguments was not signed with the
     * public key in readerCertificate from one of the access control profiles.
     */
    READER_SIGNATURE_CHECK_FAILED = 4,

    /**
     * The authToken field in StartRetrievalArguments is not valid.
     */
    INVALID_AUTH_TOKEN = 5,

    /**
     * The requested operation is not supported by the implementation.
     */
    UNSUPPORTED_OPERATION = 6,

    // Error codes above 10000 reserved for implementations.
};

/**
 * An AuditLogEntry is a cryptographically-authenticated record that a credential presentation
 * occurred.
 */
struct AuditLogEntry {
    /**
     * Hash of the data request.  It contains:
     *
     *     SHA-256(ReaderAuthenticationData).
     *
     *  See StartRetrievalArguments.requestData for the definition of ReaderAuthenticationData.
     */
    uint8_t[32] requestHash;

    /**
     * Hash of the response.  It contains:
     *
     *     SHA-256(AuthenticatedData).
     *
     * See IIdentityCredential.finishRetrieval() for the definition of AuthenticatedData.
     */
    uint8_t[32] responseHash;

    /**
     * Signature that authenticates this audit log entry.  Contains:
     *
     *     ECDSA(CredentialKey, AuditLogData)
     *
     *  where
     *
     *      AuditLogData = [
     *          "AuditLogEntry",
     *          requestHash : bstr,
     *          responseHash: bstr,
     *          previousAuditSignatureHash : bstr
     *     ]
     *
     *  requestHash and responseHash are the values above, See IIdentityCredential.finishRetrieval()
     *  for previousAuditSignatureHash.
     */
    vec<uint8_t> signature;
};

/**
 * An EntryValue holds the value of a data entry.
 *
 * Because byte-strings and text-strings may be chunked it is not safe to assume that textString
 * is valid UTF-8 even if the passed in data prior to chunking is valid UTF-8.
 */
safe_union EntryValue {
    uint64_t integer;
    vec<uint8_t> textString;
    vec<uint8_t> byteString;
    bool booleanValue;
};

typedef uint8_t AccessControlProfileId;

struct SecureAccessControlProfile {
    /**
     * id is a numeric identifier that must be unique within the context of a Credential and may be
     * used to reference the profile.
     */
    AccessControlProfileId id;

    /**
     * readerCertificate, if non-empty, specifies a X.509 certificate (or chain of certificates) that
     * must be used to authenticate requests (see the readerSignature field in StartRetrievalArguments).
     */
    vec<uint8_t> readerCertificate;

    /**
     * capabilityId, if non-zero, specifies a 64-bit secure user ID that must be authenticated to
     * allow requests (see the authToken field of StartRetrievalArguments).  Required authentication
     * freshness is specified by timeout below.
     */
    uint64_t capabilityId;

    /**
     * The type of capability.
     */
    CapabilityType capabilityType;

    /**
     * Timeout specifies the amount of time, in seconds, for which a user authentication (see
     * capabilityId above) is valid, if capabilityId is non-empty.  If capbilityId is non-zero and
     * timout is zero then authentication is required for each reader session.  In that case the
     * authToken provided in StartRetrievalArugments must contain a SHA-256 hash of the session
     * transcript (see the requestData parameter of StartRetrievalArguments for how to get the
     * session transcript).
     *
     * If capabilityId is zero, timeout must be zero.
     */
    uint32_t timeout;

    /**
     * The mac is used to authenticate the access control profile.  It contains:
     *
     *      AES-GCM-ENC(storageKey, R, {}, AccessControlProfile)
     *
     *  where AccessControlProfile is the CBOR map:
     *
     *      AccessControlProfile = {
     *          "Id": uint,                  ; 8 bits
     *          ? "ReaderCertificate" : bstr,
     *          ? (
     *              "CapabilityTypes": uint,   ; 32 bits
     *              "CapabilityId" : uint,   ; 64 bits
     *              ? "Timeout": uint,       ; 32 bits
     *          )
     *      }
     */
    vec<uint8_t> mac;
};

struct DirectAccessSigningKeyStatus {
    vec<uint8_t> signingKeyBlob;
    uint16_t usageCount;
};

struct StartRetrievalArguments {
    /**
     * Access control profiles that are required to retrieve the entries that are going to be
     * requested with IIdentityCredential.retrieveEntryValue().  The requirements of the provided
     * profiles must be met by the provided authToken and/or readerSignature. If one or
     * more profiles are invalid the startRetrieval() call fails with INVALID_DATA.
     *
     * At most one of the provided SecureAccessControlProfiles may contain a non-empty
     * readerCertificate.  If more than one is provided, the startRetrieval() call fails with
     * INVALID_DATA.
     */
    vec<SecureAccessControlProfile> accessControlProfiles;

    /**
     * The authentication token that proves the user was authenticated, as required by one or more
     * of the provided accessControlProfiles.
     */
    KeymasterCapability authToken;

    /**
     * If non-empty, contains request data that is signed by the reader.  The content can be defined
     * in the way appropriate for the credential, but there are four requirements that must be met
     * to work with this HAL:
     *
     * 1. The content must be a CBOR-encoded structure.
     * 2. The CBOR structure must be a map.
     * 3. The map must contain a key "SessionTranscript" whose value must be a CBOR data structure
     *    that, somewhere contains a CBOR value of type bytestring, with the value of the ephemeral
     *    key created by createEphemeralKeyPair.
     * 4. The map must contain a key "Request" whose value is an array of maps, defined below.
     *
     * If these requirements are met the startRetrieval() call fails with INVALID_DATA.
     *
     * For example the ISO 18013 Mobile Driving License standard specifies that the data signed
     * by the reader is structured as:
     *
     *     ReaderAuthenticationData = {
     *         "SessionTranscript" : SessionTranscript,
     *         "Request" : [ + DataReq ]
     *     }
     *     SessionTranscript = [
     *         DeviceEngagement,     ; Complicated structure that contains the ephemeral key
     *         bstr                  ; Reader ephemeral public key
     *     ]
     *     DataReq = {
     *         ? "DocType" : DocType,
     *         + Namespace => DataItemNames
     *     }
     *     DocType = tstr
     *     Namespace = tstr
     *     DataItemNames = [ + tstr ]
     */
    vec<uint8_t> requestData;

    /**
     * readerSignature is either empty or contains ECDSA(readerKey, requestData) where
     * the public key for readerKey is available in readerCertificate from one of the access
     * control profiles.
     */
    vec<uint8_t> readerSignature;

    /**
     * requestCounts specifies the number of data items that are going to be requested, per
     * namespace.  The number of elements in the vector must be the number of namespaces for which
     * data items will be requested in retrieveEntryValue() calls, and the values of the elments
     * must be the number of items from each namespace, in order, that will be requested in
     * retrieveEntryValue() calls.
     *
     * Note that it's the caller's responsibility to ensure that the counts correspond to the
     * retrieveEntryValue() calls that will be made, and that every retrieveEntryValue() call
     * will succeed (i.e. that the access control profile checks will succeed).  This means that
     * it's the responsibility of the caller to determine which access control checks will fail
     * and remove the corresponding requests from the counts.
     */
    vec<uint16_t> requestCounts;
};
