package android.hardware.identity_credential@1.0;

import android.hardware.keymaster.capability@1.0::CapabilityType;
import android.hardware.keymaster.capability@1.0::KeymasterCapability;

enum ResultCode : int32_t {
    /**
     * Success.
     */
    OK = 0,

    /**
     * TODO(hoelzl) Define this
     */
    FAILED = 1,

    /**
     * TODO(hoelzl) Define this
     */
    IOERROR = 2,

    /**
     * TODO(hoelzl) Define this
     */
    UNSUPPORTED_OPERATION = 3,

    /**
     * TODO(hoelzl) Define this
     */
    INVALID_DATA = 4,

    /**
     * An access condition was not satisfied.
     */
    RETRIEVAL_DENIED = 5,

    // Error codes above 10000 reserved for implementations.
};

enum KeyType : uint16_t {
    EC_NIST_P_256,
};

struct AuditLogHash {
    uint8_t[32] hashValue;
    uint8_t[12 /* nonce */ + 0 /* ciphertext */ + 16 /* tag */] mac;
};

safe_union EntryValue {
    uint64_t integer;
    string textString;
    vec<uint8_t> byteString;
    bool booleanValue;
};

struct EntryData {
    /**
     * The namespace of the name used to reference the new data entry for retrieval and deletion.
     */
    string nameSpace;

    /**
     * The name used to reference the new data entry for retrieval and deletion.
     */
    string name;

    /**
     * The entry value.
     */
    EntryValue value;

    /**
     * Indicates whether the issuing authority would like this field to be made directly available,
     * if supported by the secure hardware.
     */
    bool directlyAvailable;
};

struct SecureAccessControlProfile {
    /**
     * id is a numeric identifier that must be unique within the context of a Credential and may be
     * used to reference the profile.
     */
    uint8_t id;

    /**
     * readerAuthPubKey, if non-empty, specifies a reader public key that must be used to
     * authenticate requests (see the readerSignature parameter of ICredential.getEntries()).
     */
    vec<uint8_t> readerAuthPubKey;

    /**
     * userAuthenticationId, if non-empty, specifies a 64-bit secure user ID that must be
     * authenticated to allow requests (see the authToken parameter of ICredential.getEntries()).
     * Required authentication freshness is specified by timeout below.
     */
    uint64_t capabilityId;

    /**
     *
     */
    CapabilityType capabilityType;

    /**
     * Timeout specifies the amount of time, in seconds, for which a user authentication (see
     * userAuthenticationId above) is valid, if userAuthenticationId is non-empty.  If timout is
     * zero then authentication is required for each reader session.  In that case the authToken
     * provided to getEntries() must contain a SHA-256 hash of the session transcript (see the
     * sessionTranscript parameter of ICredentials.getEntries).
     *
     * If userAutenticationId is empty, timeout must be zero.
     */
    uint32_t timeout;

    /**
     * The mac is used to authenticate the access control profile.  It contains:
     *
     *      AES-GCM-ENC(storageKey, R, {}, AccessControlProfile)
     *
     *  where AccessControlProfile is the CBOR map:
     *
     *      AccessControlProfile = {
     *          "id": uint,                  ; 8 bits
     *          ? "readerAuthPubKey" : bstr,
     *          ? (
     *              "userAuthTypes": uint,   ; 32 bits
     *              "userSecureId" : uint,   ; 64 bits
     *              ? "timeout": uint,       ; 32 bits
     *          )
     *      }
     */
    vec<uint8_t> mac;
};

struct SecureEntry {
    /**
     * The namespace of the entry.
     */
    string nameSpace;

    /**
     * The name of the entry.
     */
    string name;

    /**
     * Numeric IDs of the access control profiles associated with this entry.  See
     * AccessControlBlob.id.
     */
    vec<uint8_t> accessControlProfileIds;

    /**
     * For directly-available credentials (see EntryData.directlyAvailable), the contents of
     * ``content'' are implementation-defined but must not exceed 32 bytes in length.
     *
     * For other credentials, content contains AES-GCM-ENC(storageKey, R Data, AdditionalData),
     * where:
     *
     *     Data = bstr / tstr / int / bool   ; EntryData.value
     *
     *     AdditionalData = {
     *         "namespace" : tstr,
     *         "name" : tstr,
     *         "accessControlProfileIds" : [ + uint ],
     *     }
     */
    vec<uint8_t> content;
};

struct DirectAccessSigningKeyStatus {
    vec<uint8_t> signingKeyBlob;
    uint16_t usageCount;
};

struct StartRetrievalArguments {
    /**
     * Access control profiles that are required to retrieve the entries that are going to be
     * requested with IIdentityCredential.getEntry.  The requirements of the provided profiles must
     * be met by the provided authToken and/or readerSignature.
     */
    vec<SecureAccessControlProfile> accessControlProfiles;

    /**
     * The authentication token that proves the user was authenticated, as required by one or more
     * of the provided accessControlProfiles
     */
    KeymasterCapability authToken;

    /**
     * If non-empty, contains request data that is signed by the reader.  The content can be defined
     * in the way appropriate for the credential, but there are four requirements that must be met
     * to work with this HAL:
     *
     * 1. The content must be a CBOR-encoded structure.
     * 2. The CBOR structure must be a map.
     * 3. The map must contain a key "DataReq" whose value is an array of maps, defined below.
     * 4. Somewhere other than the "DataReq" key, the structure must contain a CBOR value of
     *    type bytestring, with the value of the ephemeral key created by createEphemeralKeyPair.
     *
     * For example the ISO 18013 Mobile Driving License standard specifies that the data signed
     * by the reader is structured as:
     *
     *     ReaderAuthenticationData = {
     *         "DeviceEngagement" : DeviceEngagement,
     *         "ReaderEPubKey" : bstr,
     *         "DataReq" : DataReq
     *     }
     *     DeviceEngagement = ...    ; Complicated structure that contains the ephemeral key
     *     DataReq = {
     *         ? "DocType" : DocType,
     *         + Namespace => DataItemNames
     *     }
     *     DocType = tstr
     *     Namespace = tstr
     *     DataItemNames = [ + tstr ]
     */
    vec<uint8_t> requestData;

    /**
     * readerSignature is either empty or contains ECDSA(readerAuthPubKey, requestData) where
     * readerAuthPubKey is the reader public key from one of the access control profiles.
     */
    vec<uint8_t> readerSignature;
};
