package android.hardware.identity_credential@1.0;

import android.hardware.keymaster.capability@1.0::CapabilityType;

/**
 * IWritableIdentityCredential is used to personalize a new identity credential.  Credentials cannot
 * be updated or modified after creation; any changes require deletion and re-creation.
 */
interface IWritableIdentityCredential {
    /**
     * Get an attestation certificate which can be used to prove the hardware characteristics to an
     * issuing authority.  Must not be called more than once.
     *
     * @param attestationApplicationId TODO(swillden) document this.
     *
     * @param attestationChallenge TODO(swillden) document this.
     *
     * @return resultCode ...
     *
     * @return certificate is the X.509 certificate for the credentialKey, signed by the Keymaster
     *     attestation certificate, including the Keymaster attestation extension (see
     *     IKeymasterDevice
     *
     */
    getAttestationCertificate(vec<uint8_t> attestationApplicationId,
                              vec<uint8_t> attestationChallenge)
        generates(ResultCode resultCode, vec<uint8_t> certificate);


    /**
     * Start the personalization process.
     *
     * startPersonalization must not be called more than once.
     *
     * @param accessControlProfileCount specifies the number of access control profiles that will be
     *     provisioned with addAccessControlProfile().
     *
     * @param entryCount specifies the number of data entries that will be provisioned with
     *     addEntry.
     *
     * @return resultCode ...
     *
     */
    startPersonalization(uint8_t accessControlProfileCount, vec<uint16_t> entryCounts)
        generates(ResultCode resultCode);

    /**
     * Add an access control profile, which defines the requirements or retrieval of one or more
     * entries.  If both readerAuthPubKey and capabilityId are empty/zero, associated entries are
     * open access, requiring no authentication to read (though the caller is free to require other
     * authentication above this HAL).
     *
     * This method must be called exactly as many times as specified in the startPersonalization()
     * accessControlProfileCount parameter.
     *
     * @param id a numeric identifier that must be unique within the context of a Credential and may
     *     be used to reference the profile.
     *
     * @param readerAuthPubKey if non-empty, specifies a reader public key that must be used to
     *     authenticate requests (see the readerSignature parameter of ICredential.getEntries()).
     *
     * @param capabilityId if non-zero, specifies a 64-bit secure user ID that must be
     * authenticated to allow requests (see the authToken parameter of ICredential.getEntries()).
     * Required authentication freshness is specified by timeout below.
     *
     * @param capabilityType
     *
     * @param timeout specifies the amount of time, in seconds, for which a user authentication (see
     *     userAuthenticationId above) is valid, if userAuthenticationId is non-empty.  If timout is
     *     zero then authentication is required for each reader session.  In that case the authToken
     *     provided to getEntries() must contain a SHA-256 hash of the session transcript (see the
     *     sessionTranscript parameter of ICredentials.getEntries).
     *
     *     If capabilityId is zero, timeout must be zero.
     *
     * @return resultCode ...
     *
     * @return secureAccessControlProfile
     */
    addAccessControlProfile(uint8_t id, vec<uint8_t> readerAuthPubKey, uint64_t capabilityId,
                            CapabilityType capabilityType, uint32_t timeout)
        generates(ResultCode resultCode, SecureAccessControlProfile secureAccessControlProfile);

    /**
     * Begins the process of adding an entry to the credential.  All access control profiles must be
     * added before calling this method.  Entries must be added in namespace "groups", meaning all
     * entries of one namespace must be added before adding entries from another namespace.
     *
     * This method must be called exactly as many times as specified in the startPersonalization()
     * entryCount parameter, and must be followed by one or more calls to addEntryValue().
     *
     * @param accessControlProfileIds specifies the set of access control profiles that can
     *     authorize access to the provisioned element.
     *
     * @param nameSpace, the namespace of the element, e.g. "org.iso.18013"
     *
     * @param name, the name of the element.
     *
     * @param directlyAvailable is true if the entry is to be provisioned for direct access.
     *
     * @param entrySize is the size of the entry value, if it's a text string or a bytes string.
     *    Must be zero if the entry value is an integer or boolean.
     *
     * @return resultCode ...
     */
    beginAddEntry(vec<AccessControlProfileId> accessControlProfiles, string nameSpace,
                  string name, bool directlyAvailable, uint32_t entrySize)
        generates(ResultCode resultCode);

    /**
     * Continues the process of adding an entry, providing a value or part of a value.
     *
     * In the common case, this method will be called only once per entry added.  In the case of
     * text string or byte string values that are larger than the secure environment's GCM chunk
     * size (see IIdentityCredentialStore.getHardwareInformation()), the caller must provide the
     * value in chunks.  All chunks must be exactly gcmChunkSize except the last and the sum of all
     * chunk sizes must equal the value of the beginAddEntry() entrySize argument.
     *
     * For entry values that contain integer, or boolean values, addEntryValue must be called only
     * once.
     *
     * @param value is the entry value, or part of the entry value in the case of a byte string or a
     *     text string that exceeds gcmChunkSize in length.
     *
     * @reaturn resultCode ...
     *
     * @return encryptedContent contains the encrypted and MACed content.  For directly-available
     *     credentials the contents are implementation-defined but must not exceed 32 bytes in
     *     length.
     *
     *     For other credentials, encryptedContent contains:
     *
     *         AES-GCM-ENC(storageKey, R Data, AdditionalData)
     *
     *     where:
     *
     *         Data = bstr / tstr / int / bool   ; value
     *
     *         AdditionalData = {
     *             "namespace" : tstr,
     *             "name" : tstr,
     *             "accessControlProfileIds" : [ + uint ],
     *         }
     */
    addEntryValue(EntryValue value)
        generates(ResultCode resultCode, vec<uint8_t> encryptedContent);

    /**
     * Finishes adding entries and returns a signature that an issuing authority may use to validate
     * that all data was provisioned correctly.
     *
     * After this method is called, the IWritableIdentityCredential is no longer usable.
     *
     * @return resultCode returns ... TODO(swillden): enumerate possible codes.
     *
     * @return credentialBlob is an opaque byte vector which contains encrypted copies of the
     *     secrets used to secure the new credential's data and to authenticate the credential to
     *     the issuing authority.  The credentialBlob contains:
     *
     *         AES-GCM-ENC(HBK, R, CredentialKeys, {})
     *
     *     where HBK is a unique hardware-bound key that has never existed outside of the secure
     *     environment and CredentialKeys is the CBOR-encoded structure (in CDDL notation):
     *
     *         CredentialKeys = [
     *              bstr,   ; storageKey, a 128-bit AES key
     *              bstr    ; credentialPrivKey an EC private key in uncompressed format
     *         ]
     *
     *  TODO(swillden): Add a place to store docType.
     *
     * @return signature proves to the IA that the credential was imported into the secure hardware
     *     without alteration or error.  When the final addEntry call is made (when the number of
     *     provisioned entries equals the value of the startPersonalization() entryCount parameter),
     *     it returns:
     *
     *         ECDSA(credentialPrivKey, SignedData)
     *
     *     Where SignedData is:
     *
     *         SignedData = {
     *                 "docType" : tstr,
     *                 "accessControlProfiles" : [ * AccessControlProfile ],
     *                 "namespaces" : {
     *                      * Namespace => [ + Entry ]
     *                 }
     *                 "testCredential" : bool
     *             }
     *
     *          AccessControlProfile = {
     *              "id": uint,
     *              ? "readerAuthPubKey" : bstr,
     *              ? (
     *                  "capabilityType": uint
     *                   ? "timeout": uint,
     *              )
     *          }
     *
     *          Namespace = tstr
     *
     *          Entry = {
     *              "name" : tstr,
     *              "accessControlProfiles" : [ * uint ],
     *              "value" : bstr / tstr / int / bool,
     *              "directlyAvailable" : bool
     *          }
     */
    finishAddingEntryies()
        generates(ResultCode resultCode, vec<uint8_t> credentialBlob, vec<uint8_t> signature);
};
