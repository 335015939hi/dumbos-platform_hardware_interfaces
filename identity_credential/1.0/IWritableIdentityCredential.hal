package android.hardware.identity_credential@1.0;

/**
 * IWritableIdentityCredential is used to personalize a new identity credential.  Credentials cannot
 * be updated or modified after creation; any changes require deletion and re-creation.
 */
interface IWritableIdentityCredential {
    /**
     * Gets the attestation certificate that the issuing authority can use to validate the security
     * level of the secure hardware.
     *
     * @return certificate is the X.509 certificate for the credentialKey, signed by the Keymaster
     * attestation certificate, including the Keymaster attestation extension (see IKeymasterDevice
     * HAL).
     */
    getAttestationCertificate(vec<uint8_t> attestationApplicationId,
                              vec<uint8_t> attestationChallenge)
        generates(vec<uint8_t> certificate);

    /**
     * Personalize the credential, returning encrypted blobs for storage.  This method may only be
     * called once.  Subsequent calls fail with Error::CANNOT_PROVISION_AGAIN.
     *
     * @return error returns ... TODO(swillden): enumerate possible error codes.
     *
     * @param accessControlProfiles contains the access control profiles to provision
     *
     * @param entries contains the data to provision
     *
     * @return credentialBlob is an encrypted byte array that contains data used to secure the
     *     credential.  It serves to externalize these per-credential secrets so the secure world
     *     does not have to store them internally.
     *
     *     CredentialBlob = {
     *         "credentialData" : bstr    ; AES-GCM-ENC (HBK, R, CredentialKeys, {})
     *     }
     *
     *     CredentialKeys = [
     *          bstr,   ; storageKey, a 256-bit AES key
     *          bstr    ; credentialPrivKey an  EC private key
     *     ]
     *
     *    HBK is a unique hardware-bound AES-256 key that is generated in the secure world and never
     *    exported.  Note that for test credentials, an all-zero value is used so that tests may
     *    validate the content and construction of data protected by the HBK.
     *
     * @return signedData proves to the IA that the credential was imported into the secure hardware
     *     without alteration or error.
     *
     *     SignedData = {
     *             "credentialType" : tstr,
     *             "accessControlProfiles" : [ * AccessControlProfile ],
     *             "entries" : [ * Entry ],
     *             "testCredential" : bool
     *         }
     *
     *      AccessControlProfile = {
     *          "id": uint,
     *          ? "readerAuthPubKey" : bstr,
     *          ? (
     *              "userAuthTypes": uint
     *              ? "timeout": uint,
     *          )
     *      }
     *
     *      Entry = {
     *          "name" : bstr,
     *          "value" : bstr / int,
     *          "issuerSignature" : bstr,
     *          "accessControlProfiles" : [ * uint ],
     *          "directlyAvailable" : bool
     *      }
     */
    personalize(vec<AccessControlProfile> accessControlProfiles, vec<EntryConfiguration> entries)
        generates(Error error, vec<uint8_t> credentialBlob,
                  vec<SecureAccessControlProfile> accessControlProfiles, vec<SecureEntry> entries,
                  vec<uint8_t> signedData);
};
