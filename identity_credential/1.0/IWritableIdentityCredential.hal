package android.hardware.identity_credential@1.0;

import android.hardware.keymaster.capability@1.0::CapabilityType;

/**
 * IWritableIdentityCredential is used to personalize a new identity credential.  Credentials cannot
 * be updated or modified after creation; any changes require deletion and re-creation.
 */
interface IWritableIdentityCredential {
    /**
     * Start the personalization process.  Returns the attestation certificate that the issuing
     * authority can use to validate the security level of the secure hardware as well as the
     * CredentialBlob and the AuditLogHash.
     *
     * startPersonalization must not be called more than once.
     *
     * @param attestationApplicationId TODO(swillden) document this.
     *
     * @param attestationChallenge TODO(swillden) document this.
     *
     * @param accessControlProfileCount specifies the number of access control profiles that will be
     *     provisioned with addAccessControlProfile().
     *
     * @param entryCount specifies the number of data entries that will be provisioned with
     *     addEntry.
     *
     * @return resultCode ...
     *
     * @return certificate is the X.509 certificate for the credentialKey, signed by the Keymaster
     *     attestation certificate, including the Keymaster attestation extension (see
     *     IKeymasterDevice
     *
     * @return credentialBlob is an opaque byte vector which contains encrypted copies of the
     *     secrets used to secure the new credential's data and to authenticate the credential to
     *     the issuing authority.  The credentialBlob contains:
     *
     *         AES-GCM-ENC(HBK, R, CredentialKeys, {})
     *
     *     where HBK is a unique hardware-bound key that has never existed outside of the secure
     *     environment and CredentialKeys is the CBOR-encoded structure (in CDDL notation):
     *
     *         CredentialKeys = [
     *              bstr,   ; storageKey, a 256-bit AES key
     *              bstr    ; credentialPrivKey an EC private key in uncompressed format
     *         ]
     *
     * @return auditLogHash is a structure that contains the initial value of the audit log
     *     blockchain hash.  The initial contents of the auditLogHash fields must be:
     *
     *         hashValue = SHA-256(DataBlock)
     *         macNonce = R
     *         mac = AES-GCM-ENC(storageKey, macNonce, {}, hashValue)
     */
    startPersonalization(vec<uint8_t> attestationApplicationId,
                         vec<uint8_t> attestationChallenge, uint8_t accessControlProfileCount,
                         uint16_t entryCount)
        generates(ResultCode resultCode, vec<uint8_t> certificate, vec<uint8_t> credentialBlob,
                  AuditLogHash auditLogHash);

    /**
     * Add an access control profile, which defines the requirements or retrieval of one or more
     * entries.  If both readerAuthPubKey and capabilityId are empty/zero, associated entries are
     * open access, requiring no authentication to read (though the caller is free to require other
     * authentication above this HAL).
     *
     * This method must be called exactly as many times as specified in the startPersonalization()
     * accessControlProfileCount parameter.
     *
     * @param id a numeric identifier that must be unique within the context of a Credential and may
     *     be used to reference the profile.
     *
     * @param readerAuthPubKey if non-empty, specifies a reader public key that must be used to
     *     authenticate requests (see the readerSignature parameter of ICredential.getEntries()).
     *
     * @param capabilityId if non-zero, specifies a 64-bit secure user ID that must be
     * authenticated to allow requests (see the authToken parameter of ICredential.getEntries()).
     * Required authentication freshness is specified by timeout below.
     *
     * @param capabilityType
     *
     * @param timeout specifies the amount of time, in seconds, for which a user authentication (see
     *     userAuthenticationId above) is valid, if userAuthenticationId is non-empty.  If timout is
     *     zero then authentication is required for each reader session.  In that case the authToken
     *     provided to getEntries() must contain a SHA-256 hash of the session transcript (see the
     *     sessionTranscript parameter of ICredentials.getEntries).
     *
     *     If capabilityId is zero, timeout must be zero.
     *
     * @return resultCode ...
     *
     * @return secureAccessControlProfile
     */
    addAccessControlProfile(uint8_t id, vec<uint8_t> readerAuthPubKey, uint64_t capabilityId,
                            CapabilityType capabilityType, uint32_t timeout)
        generates(ResultCode resultCode, SecureAccessControlProfile secureAccessControlProfile);

    /**
     * Add an entry to the credential.  All access control profiles must be added before calling
     * this method.  Entries must be added in namespace "groups", meaning all entries of one
     * namespace must be added before adding entries from another namespace.
     *
     * This method must be called exactly as many times as specified in the startPersonalization()
     * entryCount parameter.
     *
     * @param entry contains the entry data to be provisioned.
     *
     * @param accessControlProfilesIds contains the set of access control profiles under which this
     *     entry may be retrieved. If empty, the entry will not be retrievable at all.
     *
     * @return resultCode returns ... TODO(swillden): enumerate possible codes.
     *
     * @param accessControlProfiles contains the access control profiles to provision
     *
     * @param entries contains the data to provision
     *
     * @return signature proves to the IA that the credential was imported into the secure hardware
     *     without alteration or error.  For each addEntry call prior to the last, this value must
     *     be empty.  When the final addEntry call is made (when the number of provisioned entries
     *     equals the value of the startPersonalization() entryCount parameter), it returns:
     *
     *         ECDSA(credentialPrivKey, SignedData)
     *
     *     Where SignedData is:
     *
     *         SignedData = {
     *                 "docType" : tstr,
     *                 "accessControlProfiles" : [ * AccessControlProfile ],
     *                 "namespaces" : {
     *                      * Namespace => [ + Entry ]
     *                 }
     *                 "testCredential" : bool
     *             }
     *
     *          AccessControlProfile = {
     *              "id": uint,
     *              ? "readerAuthPubKey" : bstr,
     *              ? (
     *                  "capabilityType": uint
     *                  ? "timeout": uint,
     *              )
     *          }
     *
     *          Namespace = tstr
     *
     *          Entry = {
     *              "name" : tstr,
     *              "accessControlProfiles" : [ * uint ],
     *              "value" : bstr / tstr / int / bool,
     *              "directlyAvailable" : bool
     *          }
     */
    addEntry(EntryData entry, vec<uint8_t> accessControlProfileIds)
        generates(ResultCode resultCode, SecureEntry secureEntry, vec<uint8_t> signedData);
};
