package android.hardware.identity_credential@1.0;

import android.hardware.keymaster.capability@1.0::KeymasterCapability;

interface IIdentityCredential {

    /**
     * TODO(swillden): Document this, and define deletionCertificate content.
     */
    deleteCredential() generates (Error error, vec<uint8_t> deletionCertificate);

    /**
     * Creates an ephemeral EC key pair, for use in establishing a seceure session with a reader.
     * This method returns the private key so the caller can perform an ECDH key agreement operation
     * with the reader.  The reason for generating the key pair in the secure environment is so that
     * the secure environment knows what public key to expect to find in the session transcript.
     *
     * @param keyType specifies the type/size of key pair.
     *
     * @return privateKey contains the generated private key in PKCS#8 format.
     */
    createEphemeralKeyPair(KeyType keyType) generates (vec<uint8_t> privateKey);

    /**
     * Retrieves a set of entries, subject to access control requirements, with an optional
     * signature.
     *
     * This method accepts and returns a lot of data, but it's designed to enable incremental
     * processing, which may be important in tightly constrained secure hardware.  It must do the
     * following (in order):
     *
     * 1.  Determine whether each of the provided accessControlDescriptors is satisfied.  For those
     *     that include a readerAuthPubKey, it must be the case that the readerSignature argument is
     *     a signature over sessionTranscript using the readerAuthPubKey.  For those that include a
     *     userAuthentication, it must be the case that the authToken argument is a valid
     *     KeymasterCapability for id and was created within timeout seconds of the present time.
     *     If any requirement is not met, return Error::<something>.
     *
     * 2.  If signingKeyBlob is non-empty, begin digesting authenticatedData (see below).
     *
     * 3.  For each entryBlob:
     *
     *     (a) check to see if the entryBlob is decryptable.  If not, return Error::<something>.
     *
     *     (b) check to see if the entryBlob contains an accessControlProfileId that matches one of
     *         the accessControlDescriptors.  If not, return Error::<something>.
     *
     *     (c) if signingKeyBlob is non-empty, digest the appropriate part of authenticatedData (see
     *         below).
     *
     *     (d) collect the entryBlob name, value and iaSignature from the entryBlob so they can
     *         eventually be returned (implementation tip: the can be returned from the secure world
     *         and collected in the HAL service implementation; in this way implementations can
     *         trade round trips for requiring less working space in the secure world).
     *
     * 4.  If signingKeyBlob is non-empty, compute a signature on the digest of AuthenticatedData.
     *
     *     AuthenticatedData =  {
     *         "sessionData" : bstr,        ; sessionTranscript argument,
     *         "authFields" : [ * AuthField ]
     *     }
     *
     *     AuthFields = {
     *         "name" : bstr,               ; entry name
     *         "value" : int / bstr         ; entry value
     *     }
     *
     * @param entryBlobs is a vector of entryBlobs (see createEntry()) that contain the data being
     *     requested.  If each entry blob has at least one access control profile that is listed in
     *     accessControlDescriptors and is satisfied, the data in that blob will be returned and,
     *     optionally, signed.
     *
     * @param authToken is a KeymasterCapability which, if non-empty, may be used to satisfy user
     *     authentication requirements in accessControlDescriptors.
     *
     * @param sessionTranscript is a byte vector containing a transcript of the establishment of a
     *     secure session with a Reader.  It's used to validate the Reader's authenticity (if Reader
     *     authetnication is done) and to bind the generated signature (if any) to the session, to
     *     prove freshness to the Reader.  The structure and content of the transcript is up to the
     *     caller.
     *
     * @param readerSignature is either empty or a byte vector containing a CBOR-encoded signature
     *     by a readerAuthKey.
     *
     * @param signingKeyblob is either empty or a signingKeyBlob (see generateSigningKeyPair())
     *     containing the signing key to use to sign authenticatedData.
     *
     * @return error ...
     *
     * @return entries a vector of the entry data retrieved, with static IA signatures.
     *
     * @return signature is a signature over authenticatedData with the key in signingKeyBlob, or
     *     empty if signingKeyBlob was empty.
     */
    getEntries(vec<vec<uint8_t>> accessControlDescriptors, vec<vec<uint8_t>> entryBlobs,
               KeymasterCapability authToken, vec<uint8_t> sessionTranscript,
               vec<uint8_t> readerSignature, vec<uint8_t> signingKeyBlob)
	generates (Error error, vec<EntryData> entries, vec<uint8_t> signature);

    /**
     * @param keyType specifies the type/size of key pair.
     *
     * @return error
     *
     * @return signingKeyBlob contains an encrypted copy of the newly-generated private signing key.
     *
     * @return signingKeyCertificate contains an X.509 certificate for the new signing key, signed
     *     by the credential key.
     */
    generateSigningKeyPair(KeyType keyType)
	generates(Error error, vec<uint8_t> signingKeyBlob, vec<uint8_t> signingKeyCertificate);

    /**
     *
     */
    provisionDirectAccessSigningKeyPairs(vec<uint8_t> signingKeyBlob, vec<uint8_t> signingKeyCertificateChain)
        generates(Error error, int8_t keysNeeded);
};
