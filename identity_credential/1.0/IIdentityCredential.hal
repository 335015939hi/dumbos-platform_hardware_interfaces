package android.hardware.identity_credential@1.0;

interface IIdentityCredential {

    /**
     * TODO(swillden): Document this, and define deletionCertificate content.
     */
    @entry
    deleteCredential() generates (Result result, vec<uint8_t> deletionCertificate);

    /**
     * Creates an ephemeral EC key pair, for use in establishing a seceure session with a reader.
     * This method returns the private key so the caller can perform an ECDH key agreement operation
     * with the reader.  The reason for generating the key pair in the secure environment is so that
     * the secure environment knows what public key to expect to find in the session transcript.
     *
     * @return result is OK on success or FAILED if an error occurred.
     *
     * @return keyPair contains the unencrypted key-pair in PKCS#8 format.
     */
    @entry
    @callflow(next = {"startRetrieval"})
    createEphemeralKeyPair() generates (Result result, vec<uint8_t> keyPair);

    /**
     * Start an entry retrieval process.  This must be called after createEphemeralKeyPair() and
     * before startRetrieveEntry().
     *
     * If the provided authToken is not valid this method fails with INVALID_AUTH_TOKEN.
     *
     * Each of the provided accessControlProfiles is checked in this call. If a profile
     * requires a specific readerCertificate and the provided readerSignature does
     * not match, this call fails with READER_SIGNATURE_CHECK_FAILED. If a profile requires
     * user authentication and the provided authToken doesn't the needed authorization, the
     * call fails with ACCESS_DENIED.
     *
     * @param args is the arguments for the call, see StartRetrievalArguments.
     *
     * @return result is OK on success, INVALID_DATA, READER_SIGNATURE_CHECK_FAILED,
     *     ACCESS_DENIED or FAILED if an error occurred.
     */
    @entry
    @callflow(next = {"startRetrieveEntryValue"})
    startRetrieval(StartRetrievalArguments args) generates(Result result);

    /**
     * Starts retrieving an entry, subject to access control requirements.  Entries must be
     * retrieved in namespace groups as specified in the requestCounts element in
     * StartRetrievalArguments, and in lexicographic order, to canonicalize AuthenticatedData (see
     * finishRetrieval(), and section 3.9 of RFC 7049). If this is not done, the
     * call fails with INVALID_DATA.
     *
     * If StartRetrievalArguments.requestData as passed to startRetrieval() was non-empty
     * this method must only be called with entries specified in that field. If this
     * requirement is not met, the call fails with INVALID_DATA.
     *
     * If nameSpace or name is empty this call fails with INVALID_DATA.
     *
     * @param nameSpace is the namespace of the element, e.g. "org.iso.18013"
     *
     * @param name is the name of the element.
     *
     * @param entrySize is the size of the entry value, if it's a text string or a byte string.
     *     It must be zero if the entry value is an integer or boolean. If this requirement
     *     is not met the call fails with INVALID_DATA.
     *
     * @param accessControlProfileIds specifies the set of access control profiles that can
     *     authorize access to the provisioned element. If an identifier of a profile
     *     is given and this profile wasn't passed to startRetrieval() this call fails
     *     with ACCESS_DENIED.
     *
     * @return result is OK on success, INVALID_DATA, ACCESS_DENIED or FAILED if
     *     an error occurred.
     */
    @callflow(next = {"retrieveEntryValue"})
    startRetrieveEntryValue(string nameSpace, string name, uint32_t entrySize,
                            vec<AccessControlProfileId> accessControlProfileIds)
        generates (Result result);


    /**
     * Retrieves an entry value, or part of one, if the entry value is larger than gcmChunkSize.
     * May only be called after startRetrieveEntry().
     *
     * If the passed in data is not authentic, can't be decrypted, is of the wrong size, or can't
     * be decoded, this call fails with INVALID_DATA.
     *
     * @param encryptedContent contains the encrypted and MACed content.
     *
     * @return result is OK on success, INVALID_DATA, or FAILED if an error occurred.
     *
     * @return value is the entry value, or part of the entry value in the case of a byte string
     *     or a text string that exceeds gcmChunkSize in length.
     */
    @callflow(next = {"startRetrieveEntry", "retrieveEntryValue", "finishRetrieval"})
    retrieveEntryValue(vec<uint8_t> encryptedContent)
        generates (Result result, EntryValue value);


    /**
     * End retrieval of data, optionally returning a signature over the returned data.
     *
     * @param signingKeyblob is either empty or a signingKeyBlob (see generateSigningKeyPair(),
     *    below) containing the signing key to use to sign the data retrieved. If this
     *    is not in the right format the call fails with INVALID_DATA.
     *
     * @param previousAuditSignatureHash must contain SHA-256(credentialData) the first time
     *    credential data is retrieved and SHA-256(previousAuditLogEntry.signature) for every
     *    subsequent retrieval, where previousAuditLogEntry is the AuditLogEntry returned by the
     *    previous finishRetrieval() call. If this is not the size of a SHA-256 the call
     *    fails with INVALID_DATA.
     *
     * @return result is OK on success, INVALID_DATA or FAILED if an error occurred.
     *
     * @return is empty if signingKeyBlob is empty. Otherwise it is ECDSA(signingKey,
     *    AuthenticatedData), where
     *
     *        AuthenticatedData = {
     *            "SessionTranscript" : any,
     *            "Response" : {
     *                DocType => {
     *                    + Namespace => DataItems
     *                }
     *            }
     *        }
     *        DocType = tstr              ; Value is docType param to createCredential()
     *        Namespace = tstr
     *        DataItems = {
     *            + Name => Value
     *        }
     *        Name = tstr
     *        Value = tstr / bstr / int / bool
     *
     * @return auditLogEntry is a cryptographically-authenticated record that a credential
     *     presentation occurred.
     */
    @callflow(next = {"generateSigningKeyPair"})
    finishRetrieval(vec<uint8_t> signingKeyBlob, vec<uint8_t> previousAuditSignatureHash)
        generates(Result result, vec<uint8_t> signature, AuditLogEntry auditLogEntry);


    /**
     * Generate a key pair to be used for signing session data and retrieved data items.
     *
     * @return result is OK on success or FAILED if an error occurred.
     *
     * @return signingKeyBlob contains an encrypted copy of the newly-generated private signing key.
     *
     * @return signingKeyCertificate contains an X.509 certificate for the new signing key, signed
     *     by the credential key.
     */
    @entry
    generateSigningKeyPair()
        generates(Result result, vec<uint8_t> signingKeyBlob,
                  vec<uint8_t> signingKeyCertificate);

    /**
     * Provision a signing key pair to secure environment for "direct access" authentication.  This
     * is needed if and only if the secure environment can support direct access for one or more
     * data entries for this credential.
     *
     * @param signingKeyBlob is the blob returned by generateSigningKeyPair() which is to be
     *     provisioned for direct access use.  May be empty if the caller merely wishes to query for
     *     the number of keys needed. Call fails with INVALID_DATA if a non-empty blob which isn't
     *     valid is passed.
     *
     * @param signingKeyData is application-specific data provided by the issuer that authenticates
     *     the signing key and, possibly, the data entries as well.
     *
     * @return result is OK on success, UNSUPPORTED_OPERATION if direct access is not
     *     supported, INVALID_DATA or FAILED if the operation fails.
     */
    @entry
    provisionDirectAccessSigningKeyPair(vec<uint8_t> signingKeyBlob,
                                        vec<vec<uint8_t>> signingKeyData)
        generates(Result result);

    /**
     * Get direct-access signing key statuses.  The secure environment must use direct-access
     * signing keys, provisioned with provisionDirectAccessSigningKeyPair() in rotation, and must
     * count each use.  This method allows the caller to query for the usage counts, to determine
     * which keys need to be replaced.
     *
     * @return result is OK on success, UNSUPPORTED_OPERATION if direct access is not
     *     supported, INVALID_DATA or FAILED if the operation fails.
     *
     * @return statuses is a vector of signing key statuses.  Must contain an entry for each
     *     direct-access key stored for the credential.
     *
     * @return keysNeeded is the number of additional direct access signing key pairs the secure
     *     environment can store.  The caller may make its own determination of how many keys to
     *     provision, and should provision as many as it believes are needed for direct access
     *     operation.
     */
    @entry
    getDirectAccessSigningKeyPairStatus()
        generates (Result result, vec<DirectAccessSigningKeyStatus> statuses,
                   uint8_t keysNeeded);

    /**
     * Deprovision direct-access signing keys.  Deletes the specified direct-access signing keys and
     * associated certificate chain.
     *
     * @param signingKeyBlob is the blob returned by generateSigningKeyPair() which is to be
     *     provisioned for direct access use.
     *
     * @return result is OK on success, UNSUPPORTED_OPERATION if direct access is not
     *     supported, INVALID_DATA or FAILED if the operation fails.
     */
    @entry
    deprovisionDirectAccessSigningKeyPair(vec<uint8_t> signingKeyBlob)
        generates (Result result);

    /**
     * Configure discretionary direct access.
     *
     * In the non-direct access case, it is recommended that the app that owns and provisions a
     * credential give the user some control over what data is presented to readers.  Apps can do
     * this by prompting users with a list of the data items requested by the reader and allowing
     * the user to indicate through the UI which items they wish to allow.  Then the app calls
     * retrieveEntryValue() only for the requested items the user authorizes.  Of course, the
     * IdentityCredential then applies the issuer-configured access control profiles, restrictions
     * the user cannot override.
     *
     * But in the direct access case the app is not running and cannot exercise control.  This
     * method allows the caller to pre-configure the set of data items that the user wishes to allow
     * to be retrieved.
     *
     * @return result is OK on success, UNSUPPORTED_OPERATION if direct access is not
     *     supported, INVALID_DATA or FAILED if the operation fails.
     */
    @entry
    configureDirectAccessPermissions(vec<string> itemsAllowedForDirectAccess)
        generates (Result result);
};
