    {
      "unresolved": true,
      "key": {
        "uuid": "1373a60c_8d99e5fd",
        "filename": "security/keymint/aidl/android/hardware/security/keymint/IRemotelyProvisionedComponent.aidl",
        "patchSetId": 1
      },
      "lineNbr": 422,
