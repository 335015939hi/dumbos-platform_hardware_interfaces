      },
      "writtenOn": "2023-09-12T09:34:30Z",
      "side": 1,
      "message": "WithDevicePortConnectedState needs to holds an instance of moduleConfig.",
      "parentUuid": "1b2eb2e3_c23225bf",
      "range": {
        "startLine": 506,
        "startChar": 0,
        "endLine": 506,
