      "writtenOn": "2020-11-11T23:52:12Z",
      "side": 1,
      "message": "We allowed it in 1_1 so I figured we might as well leave it.\n (https://source.corp.google.com/android/hardware/interfaces/radio/1.1/vts/functional/radio_hidl_hal_api.cpp;l\u003d37?q\u003dsetSimCardPower_1_1%20file:vts\u0026sq\u003dpackage:android%5Cb)",
      "parentUuid": "2b2e41ec_4421fd16",
      "range": {
        "startLine": 315,
        "startChar": 76,
        "endLine": 315,
