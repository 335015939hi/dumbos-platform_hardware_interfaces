        "id": 1074459
      },
      "writtenOn": "2017-02-09T17:47:05Z",
      "side": 1,
      "message": "Done",
      "parentUuid": "6f0db68b_d8e4cf73",
      "range": {
        "startLine": 23,
        "startChar": 38,
        "endLine": 23,
        "endChar": 45
      },
      "revId": "606831693522173ab1bc472e4f12e80b28f28646",
