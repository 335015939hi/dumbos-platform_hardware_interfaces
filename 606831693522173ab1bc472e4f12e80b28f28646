    {
      "key": {
        "uuid": "7043724a_e0c017da",
        "filename": "wifi/1.0/default/hidl_callback_util.h",
        "patchSetId": 11
      },
      "lineNbr": 59,
      "author": {
        "id": 1081399
      },
      "writtenOn": "2017-02-09T01:41:58Z",
      "side": 1,
      "message": "|const| feels out of place here, given that unlinkToDeath() modifies externally observable state of the CallbackType object. (And, in fact, unlinkToDeath() is not a const method.)\n\nThis might be a case where |auto| makes the code more obscure, rather than more clear. Consider spelling out the type, to make it clear that it\u0027s the android::sp that\u0027s const, and not the callback.",
      "range": {
        "startLine": 59,
        "startChar": 6,
        "endLine": 59,
        "endChar": 11
      },
      "revId": "606831693522173ab1bc472e4f12e80b28f28646",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
