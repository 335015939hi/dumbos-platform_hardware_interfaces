package android.hardware.tests.safeunion@1.0;

interface ISafeUnion {
    newLargeSafeUnion() generates (LargeSafeUnion myUnion);
    setA(LargeSafeUnion myUnion, TypeA a) generates (LargeSafeUnion myUnion);
    setB(LargeSafeUnion myUnion, TypeB b) generates (LargeSafeUnion myUnion);
    setC(LargeSafeUnion myUnion, TypeC c) generates (LargeSafeUnion myUnion);
    setD(LargeSafeUnion myUnion, TypeD d) generates (LargeSafeUnion myUnion);
    setE(LargeSafeUnion myUnion, TypeE e) generates (LargeSafeUnion myUnion);
    setF(LargeSafeUnion myUnion, TypeF f) generates (LargeSafeUnion myUnion);
    setG(LargeSafeUnion myUnion, TypeG g) generates (LargeSafeUnion myUnion);
    setH(LargeSafeUnion myUnion, TypeH h) generates (LargeSafeUnion myUnion);
    setI(LargeSafeUnion myUnion, TypeI i) generates (LargeSafeUnion myUnion);
};
