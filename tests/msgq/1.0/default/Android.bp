cc_defaults {
    name: "fmq_test_defaults",
    defaults: ["hidl_defaults"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "libhidltransport",
        "libhwbinder",
        "liblog",
        "libutils",
    ],
    static_libs: ["android.hardware.tests.msgq@1.0"],
}

cc_library_shared {
    name: "android.hardware.tests.msgq@1.0-impl",
    defaults: ["fmq_test_defaults"],
    relative_install_path: "hw",
    srcs: [
        "TestMsgQ.cpp",
        "BenchmarkMsgQ.cpp"
    ],
    shared_libs: ["libfmq"],
}

cc_test {
    name: "android.hardware.tests.msgq@1.0-service-benchmark",
    defaults: ["fmq_test_defaults"],
    srcs: ["mq_benchmark_service.cpp"],
    gtest: false,
}

cc_test {
    name: "android.hardware.tests.msgq@1.0-service-test",
    defaults: ["fmq_test_defaults"],
    srcs: ["mq_test_service.cpp"],
    gtest: false,
}
