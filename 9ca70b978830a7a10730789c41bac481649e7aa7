      "writtenOn": "2023-02-13T23:40:50Z",
      "side": 1,
      "message": "Hmm, what if just one preset in the middle of the list is not supported? That does not seem to be possible to express in the Ranges array considering that each variant tag may only appear once. Perhaps, the situation when the effect supports all presets is a must, not \"an example.\"",
      "range": {
        "startLine": 83,
        "startChar": 22,
        "endLine": 83,
        "endChar": 68
      },
      "revId": "9ca70b978830a7a10730789c41bac481649e7aa7",
