cc_binary {
    name: "android.hardware.atrace-service.example",
    relative_install_path: "hw",
    init_rc: ["atrace-default.rc"],
    vintf_fragments: ["atrace-default.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.atrace-ndk_platform",

    ],
    srcs: [
        "main.cpp",
        "AtraceDevice.cpp",
        "include/include/atrace-impl/AtraceDevice.h",
    ],

}
