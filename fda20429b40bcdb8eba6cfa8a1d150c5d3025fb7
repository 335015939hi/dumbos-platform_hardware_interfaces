    },
    {
      "unresolved": false,
      "key": {
        "uuid": "39ef014f_6dac3c9e",
        "filename": "audio/7.0/IStreamIn.hal",
        "patchSetId": 1
      },
      "lineNbr": 118,
      "author": {
        "id": 1042638
      },
      "writtenOn": "2020-11-20T19:39:43Z",
      "side": 1,
      "message": "It\u0027s the caller (a framework service). HAL doesn\u0027t have enough privileges to adjust the priority.\n\nI think races are unlikely here. The thread that the HAL starts does not exit by itself until the framework service tells it so, via a call to \u0027close\u0027 method. A call to \u0027prepareForReading\u0027 will not be successful if the thread couldn\u0027t be started. So there is a guarantee that the TID isn\u0027t get reused until the call to \u0027close\u0027. The only possibility to create a race is to make calls to \u0027prepareForReading\u0027 and \u0027close\u0027 from different threads on the caller side, but that would lead to other problems, so the audio service doesn\u0027t do that.",
      "parentUuid": "9c706f53_bce2eb45",
      "range": {
        "startLine": 118,
        "startChar": 73,
        "endLine": 118,
        "endChar": 79
      },
      "revId": "fda20429b40bcdb8eba6cfa8a1d150c5d3025fb7",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
