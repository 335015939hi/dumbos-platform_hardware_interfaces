      "writtenOn": "2020-11-20T02:35:37Z",
      "side": 1,
      "message": "should this say callee?\n\nIf so - how does it avoid a race, if something else starts using that TID?",
      "range": {
        "startLine": 118,
        "startChar": 73,
        "endLine": 118,
        "endChar": 79
      },
      "revId": "fda20429b40bcdb8eba6cfa8a1d150c5d3025fb7",
