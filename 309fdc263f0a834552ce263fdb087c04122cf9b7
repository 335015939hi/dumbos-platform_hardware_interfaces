    {
      "key": {
        "uuid": "940badfa_e113ce7a",
        "filename": "radio/1.5/IRadio.hal",
        "patchSetId": 6
      },
      "lineNbr": 314,
      "author": {
        "id": 1054648
      },
      "writtenOn": "2020-03-09T20:34:28Z",
      "side": 1,
      "message": "Change it to IRadioIndication.phonebookRecordsReceived() since generally it is expected that response will come through IRadioResponse.",
      "range": {
        "startLine": 314,
        "startChar": 46,
        "endLine": 314,
