      },
      "writtenOn": "2023-05-16T17:12:36Z",
      "side": 1,
      "message": "I don\u0027t think we should have a default here, users should think about what security properties are required.",
      "revId": "4cf89cea4cd22a460d9d08cc21ed434c3092b63d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
