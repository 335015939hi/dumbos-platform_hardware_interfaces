package {
    default_applicable_licenses: ["hardware_interfaces_license"],
}

filegroup {
	name: "android/hardware/tv/earc",
}

aidl_interface {
    name: "android.hardware.tv.earc",

	vendor_available: true,

    srcs: ["android/hardware/tv/earc/*.aidl"],

    stability: "vintf",

    backend: {
        java: {
            sdk_version: "module_current",
        },

        cpp: {
            enabled: false,
        },

        ndk: {
            vndk: {
                enabled: true,
            },
        },
    },
    versions: [ "1" ],
}

