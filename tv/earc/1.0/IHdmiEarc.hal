package android.hardware.tv.earc@1.0;

import IHdmiEarcCallback;

/**
 * HDMI-EARC HAL interface definition.
 */
interface IHdmiEarc {
    /**
     * Sets a callback that HDMI-EARC HAL must later use for incoming EARC
     * messages or internal HDMI events.
     *
     * @param callback Callback object to pass hdmi events to the system. The
     *        previously registered callback must be replaced with this one.
     */
    @callflow(next={"*"})
    @entry
    setCallback(IHdmiEarcCallback callback);

    /**
     * Gets the state of earc state Diagram of the specified port.
     *
     * @param portId Port id to be inspected for the connection status.
     * @return HDMI_EARC_NOT_ENABLED if earc device is not connected,
     *         or HDMI_EARC_WAITING if earc connection is establishing,
     *         or HDMI_EARC_ENABLED if earc device is connected.
     */
    @callflow(next="*")
    get_earc_status(int32_t portId) generates (EarcStatus status);
};
