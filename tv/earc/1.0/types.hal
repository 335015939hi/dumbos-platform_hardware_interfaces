package android.hardware.tv.earc@1.0;

/*
 * HDMI earc event type. Used when the event
 * type is HDMI_EVENT_EARC_STATUS.
 */
enum EarcStatus : uint32_t{
    HDMI_EARC_NOT_ENABLED = 0,
    HDMI_EARC_WAITING  = 1,
    HDMI_EARC_ENABLED  = 2,
};

struct EarcEvent {
    EarcStatus status;
    uint32_t portId;
};
