package android.hardware.graphics.mapper@4.0;

/**
 * Error values that may be returned by a method of IAllocator or IMapper.
 */
enum Error : int32_t {
    /**
     * No error.
     */
    NONE            = 0,
    /**
     * Invalid BufferDescriptor.
     */
    BAD_DESCRIPTOR  = 1,
    /**
     * Invalid buffer handle.
     */
    BAD_BUFFER      = 2,
    /**
     * Invalid HardwareBufferDescription.
     */
    BAD_VALUE       = 3,
    /**
     * Resource unavailable.
     */
    NO_RESOURCES    = 5,
    /**
     * Permanent failure.
     */
    UNSUPPORTED     = 7,
};

/**
 * A buffer descriptor is an implementation-defined opaque data returned by
 * createDescriptor(). It describes the properties of a buffer and is consumed
 * by the allocator.
 */
typedef vec<uint8_t> BufferDescriptor;

struct BufferDescriptorInfo {
    /**
     * The name of the buffer. Useful for debugging/tracing.
     */
    string name;

    /**
     * The width specifies how many columns of pixels must be in the
     * allocated buffer, but does not necessarily represent the offset in
     * columns between the same column in adjacent rows. The rows may be
     * padded.
     */
    uint32_t width;

    /**
     * The height specifies how many rows of pixels must be in the
     * allocated buffer.
     */
    uint32_t height;

    /**
     * The number of image layers that must be in the allocated buffer.
     */
    uint32_t layerCount;

    /**
     * Buffer pixel format.
     */
    PixelFormat format;

    /**
     * Buffer usage mask; valid flags can be found in the definition of
     * BufferUsage.
     */
    bitfield<BufferUsage> usage;
};

struct Rect {
    int32_t left;
    int32_t top;
    int32_t width;
    int32_t height;
};

/**
 * Enum that describes if the format and layout of the buffer can be understood by generic Android
 * software
 */
enum SoftwareUnderstandableHint : uint32_t {
    NOT_UNDERSTANDABLE,
    UNDERSTANDABLE,
};

/**
 * Enum that describes the compression strategy of the buffer. This enum will contain
 * standard compression strategies. This enum should be extended by devices that use
 * a proprietary or non-standard compression strategy.
 */
enum CompressionStrategy : uint64_t {
    /* Represents all uncompressed buffers */
    UNCOMPRESSED,

    /* VESA Display Stream Compression (DSC) */
    DISPLAY_STREAM_COMPRESSION,
};

/**
 * Bitfield that describes the Components in a given PlaneLayout.
 *
 * For example, a CbCr plane is represented by PLANE_LAYOUT_COMPONENT_Cb | PLANE_LAYOUT_COMPONENT_Cr
 */
enum PlaneLayoutComponent : uint64_t {
    /* Luma */
    PLANE_LAYOUT_COMPONENT_Y = 1 << 0,
    /* Chroma blue */
    PLANE_LAYOUT_COMPONENT_Cb = 1 << 1,
    /* Chroma red */
    PLANE_LAYOUT_COMPONENT_Cr = 1 << 2,

    /* Bits 3-10 must be 0 and are reserved for future versions */

    /* Red */
    PLANE_LAYOUT_COMPONENT_R = 1 << 10,
    /* Green */
    PLANE_LAYOUT_COMPONENT_G = 1 << 11,
    /* Blue */
    PLANE_LAYOUT_COMPONENT_B = 1 << 12,

    /* Bits 13-19 must be 0 and are reserved for future versions */

    /* Metadata */
    PLANE_LAYOUT_COMPONENT_METADATA = 1 << 20,
    /* Raw */
    PLANE_LAYOUT_COMPONENT_RAW = 1 << 21,

    /* Bits 22-29 must be 0 and are reserved for future versions */

    /* Alpha */
    PLANE_LAYOUT_COMPONENT_A = 1 << 30,

    /* Bit 31 must be 0 and is reserved for future versions */
};

/*
 * Plane information of a buffer.
 * Multiple planes can be described as a vector (e.g. vec<PlaneLayout>)
 */
struct PlaneLayout {
    /**
     * Offset to plane (in bytes), from the start of the allocation.
     */
    uint32_t offset;

    /**
     * A bitfield containing PlaneLayoutComponent(s) that describe the component(s)
     * in this PlaneLayout.
     */
    uint64_t components;

    /**
     * The number of bits used per component in the plane.
     *
     * If the plane cannot be described using bitsPerComponent, this should be set to -1.
     * For example, if the plane has multiple components with different number of bits per
     * component (eg. RGB_565), return -1.
     *
     */
    int32_t bitsPerComponent;

    /**
     * Bytes per pixel increment (aka column increment or vertical stride): describes the distance
     * in bytes from one pixel to the next pixel (to the right) on the same row for the
     * the component plane.
     *
     * This can be negative.
     */
    uint32_t bytesPerPixelIncrement;

    /**
     * Bytes per Stride: number of bytes between two vertically adjacent
     * pixels in given plane. This can be mathematically described by:
     *
     * bytesPerStride = ALIGN(allocWidth * bpp / 8, alignment)
     *
     * where,
     *
     * allocWidth: width of plane in pixels
     * bpp: average bits per pixel
     * alignment (in bytes): dependent upon pixel format and usage
     *
     * For uncompressed allocations, bytesPerStride might contain additional
     * padding beyond the allocWidth.
     *
     * This can be negative.
     */
    uint32_t bytesPerStride;

    /**
     * Dimensions of plane (in pixels).
     *
     * For single plane formats, pixels equates to luma samples.
     * For multi-plane formats, pixels equates to the number of sample sites
     * for the corresponding plane, even if subsampled.
     *
     * See 'byteStride' for relationship between byteStride and allocWidth.
     */
    uint32_t allocWidth;
    uint32_t allocHeight;

    /**
     * Can be used to get the total size in bytes of any memory used by the plane
     * including metadata and extra padding.
     */
    uint64_t allocationSize

    /**
     * Horizontal and vertical subsampling. Must be a positive power of 2.
     */
    int32_t horizontalSubsampling;
    int32_t verticalSubsampling;
};

/**
 * BufferMetadata is an enum used to in getting and setting buffer metadata.
 * The comments for each enum type include a description of the metadata
 * that can be get or set with the enum.
 */
enum BufferMetadata : uint32_t {
    /**
     * Can be used to get the random ID of the buffer.
     *
     * This ID should only be used for debugging purposes. It cannot be used as a basis for any
     * control flows (eg. caching).
     *
     * The buffer ID is a uint64_t.
     */
    BUFFER_ID,

    /**
     * Can be used to get the name passed in by the client at allocation time in the
     * BufferDescriptorInfo.
     *
     * The buffer name is a C style string. It is an array of chars followed by a null terminator.
     */
    NAME,

    /**
     * Can be used to get the number of elements per buffer row requested at allocation time in
     * the BufferDescriptorInfo.
     *
     * The width is a uint32_t.
     */
    WIDTH,

    /**
     * Can be used to get the number of elements per buffer column requested at allocation time in
     * the BufferDescriptorInfo.
     *
     * The height is a uint32_t.
     */
    HEIGHT,

    /**
     * Can be used to get the number of layers requested at allocation time in the
     * BufferDescriptorInfo.
     *
     * The layer count is a uint32_t.
     */
    LAYER_COUNT,

    /**
     * Can be used to get the buffer format requested at allocation time in the
     * BufferDescriptorInfo.
     *
     * The requested pixel format is a uint32_t.
     */
    PIXEL_FORMAT_REQUESTED,

    /**
     * Can be used to get the fourcc code for the format. Fourcc codes are standard across all
     * devices of the same kernel version. Fourcc codes must follow the Linux definition of a
     * modifier found in: include/uapi/drm/drm_fourcc.h.
     *
     * The pixel format fourcc code is represented by a uint32_t.
     */
    PIXEL_FORMAT_FOURCC,

    /**
     * Can be used to get the modifier for the format. Together fourcc and modifier describe the real
     * pixel format. Each fourcc and modifier pair is unique and must fully define the format and
     * layout of the buffer. Modifiers can change any property of the buffer. Modifiers must follow
     * the Linux definiton of a modifier found in: include/uapi/drm/drm_fourcc.h.
     *
     * The pixel format modifier is represented by a uint64_t.
     */
    PIXEL_FORMAT_MODIFIER,

    /**
     * Can be used to get the usage requested at allocation time in the BufferDescriptorInfo.
     *
     * The usage is a uint64_t bit field of android.hardware.graphics.common@1.2::BufferUsage.
     */
    USAGE,

    /**
     * Can be used to get the total size in bytes of any memory used by the buffer including its
     * metadata and extra padding. This is the total number of bytes used by the buffer allocation.
     *
     * The allocation size is a uint64_t.
     */
    ALLOCATION_SIZE,

    /**
     * Can be used to get a hint that the buffer can be understood by software. This hint
     * will be used to help decide if this buffer should be manipulated by generic Android code
     * running on the CPU such as a software codec.
     *
     * It is too difficult to adequately describe the layout and format of all buffers on all
     * Android devices. If buffer is compressed, swizzled, packed, tiled, etc. in a way
     * that isn't currently defined by or expressible through IMapper, generic Android code will
     * likely not be able to understand or modify the contents of the buffer.
     *
     * This field is necessary because the presence of a PIXEL_FORMAT_MODIFIER does not mean that
     * the buffer cannot be understood by software. For example, it is possible that there are
     * different PIXEL_FORMAT_MODIFIERS that represent different stride lengths. Since the stride
     * can be expressed through the PlaneLayout, the buffer could still be understood by software.
     *
     * This field is only a hint. If the buffer was allocated with CPU usage bits, it can be
     * be accessed by the CPU according to those bits regardless of this hint.
     *
     * The software understandable hint is a SoftwareUnderstandableHint.
     */
    SOFTWARE_UNDERSTANDABLE_HINT

    /**
     * Can be used to get the compression strategy of the buffer. A value of 0 is used to represent
     * an uncompressed buffer. A value of > 0 is used to represent a compressed buffer. If the
     * implementer of IMapper has more than one compression strategy, they should different unique
     * values for each compression strategy.
     *
     * The compression strategy is a CompressionStrategy.
     */
    COMPRESSION_STRATEGY,

    /**
     * ?
     */
    PROTECTED_CONTENT,

    /**
     * ?
     */
    TILED,

    /**
     * ?
     */
    INTERLEAVED,

    /**
     * ?
     */
    CHROMA_SITING,

    /**
     * Can be used to get the PlaneLayout(s) of the buffer. There should be one PlaneLayout per
     * plane in the buffer. For example if the buffer only has one plance, only one PlaneLayout
     * should be returned.
     *
     * The plane layout is an array of uint8_t's. The first byte is a uint8_t that represents the
     * number of PlaneLayout structs. The second byte begins the array of word-aligned PlaneLayout
     * structs.
     */
    PLANE_LAYOUTS,

    /**
     * Can be used to get or set the dataspace of the buffer. The default dataspace is
     * Dataspace::UNKNOWN.
     *
     * The dataspace is android.hardware.graphics.common@1.2::Dataspace.
     */
    DATASPACE,

    /**
     * Can be used to get or set the PerFrameMetadataBlob.
     *
     * The per frame metadata blob is android.hardware.graphics.composer@2.3::PerFrameMetadataBlob.
     */
    PER_FRAME_METADATA,

    /**
     * Can be used to get or set the BlendMode.
     *
     * The blend mode is android.hardware.graphics.composer@2.1::BlendMode.
     */
    BLEND_MODE,

    /**
     * Can be used to get or set the crop Rectangle.
     *
     * The Rectangle is android.hardware.graphics.mapper@4.0::Rect.
     *
     * Some buffer producers require extra padding to their output buffer; therefore the
     * physical size of the native buffer will be larger than its logical size.
     * The crop rectangle determines the offset and logical size of the buffer that should be
     * read by consumers.
     */
    CROP_RECTANGLE,
};
