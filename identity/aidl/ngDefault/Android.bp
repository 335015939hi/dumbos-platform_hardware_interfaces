cc_library_static {
    name: "android.hardware.identity-hal-common",
    vendor_available: true,
    srcs: [
        "common/IdentityCredential.cpp",
        "common/IdentityCredentialStore.cpp",
        "common/WritableIdentityCredential.cpp",
        "common/Util.cpp",
    ],
    export_include_dirs: [
        "common",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcppbor",
        "libcrypto",
        "liblog",
        "libutils",
        "android.hardware.identity-support-lib",
        "android.hardware.identity-ndk_platform",
        "android.hardware.keymaster-ndk_platform",
    ],
}

cc_library_static {
    name: "android.hardware.identity-libeic",
    vendor_available: true,
    srcs: [
        "libeic/EicCbor.c",
        "libeic/EicPresentation.c",
        "libeic/EicProvisioning.c",
        "EicOpsImpl.cc",
    ],
    export_include_dirs: [
        "libeic",
    ],
    cflags: [
        "-DEIC_COMPILATION",
        "-Wall",
        "-Wextra",
        // TODO: remove:
        "-Wno-unused-parameter",
        "-Wno-shift-count-overflow",
    ],
    shared_libs: [
        "libbase",
        "libcrypto",
        "android.hardware.identity-support-lib",
    ],
}

cc_binary {
    name: "android.hardware.identity-service.ngExample",
    relative_install_path: "hw",
    init_rc: ["identity-ngDefault.rc"],
    vintf_fragments: ["identity-ngDefault.xml"],
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcppbor",
        "libcrypto",
        "liblog",
        "libutils",
        "android.hardware.identity-support-lib",
        "android.hardware.identity-ndk_platform",
        "android.hardware.keymaster-ndk_platform",
    ],
    static_libs: [
        "android.hardware.identity-hal-common",
        "android.hardware.identity-libeic",
    ],
    srcs: [
        "service.cpp",
        "FakeSecureHardwareProxy.cpp",
    ],
}
