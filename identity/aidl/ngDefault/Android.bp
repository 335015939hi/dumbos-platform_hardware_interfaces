cc_binary {
    name: "android.hardware.identity-service.ngExample",
    relative_install_path: "hw",
    init_rc: ["identity-ngDefault.rc"],
    vintf_fragments: ["identity-ngDefault.xml"],
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcppbor",
        "libcrypto",
        "liblog",
        "libutils",
        "android.hardware.identity-support-lib",
        "android.hardware.identity-ndk_platform",
        "android.hardware.keymaster-ndk_platform",
    ],
    srcs: [
        "IdentityCredential.cpp",
        "IdentityCredentialStore.cpp",
        "WritableIdentityCredential.cpp",
        "Util.cpp",
        "service.cpp",
        "EmbeddedIc.c",
        "FakeSecureHardwareProxy.cpp",
    ],
}
