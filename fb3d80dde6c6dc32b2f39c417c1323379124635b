    {
      "unresolved": true,
      "key": {
        "uuid": "1117c626_535da44d",
        "filename": "bluetooth/audio/aidl/android/hardware/bluetooth/audio/AptxAdaptiveConfiguration.aidl",
        "patchSetId": 6
      },
      "lineNbr": 32,
      "author": {
        "id": 1312909
      },
      "writtenOn": "2022-01-18T14:25:37Z",
      "side": 1,
      "message": "Both are different as per spec:\n\nMinSinkBufferingXX represents the minimum buffering from reception of the packet by the sink to the rendering of the first audio sample of that packet. Each bit represents 1ms of audio. This value applies to any supported channel mode\n\nMaxSinkBufferingXX represents the maximum buffering from reception of the packet by the sink to the rendering of the first audio sample of that packet. Each bit represents 4ms of audio. This value applies to any supported channel mode\n\nTTP:\nTTP Offset Targets for low latency mode and high quality mode can be programmed by the host. Unless set by the host, the default values are used. Some implementation ignores those values.",
      "parentUuid": "4fe1658c_3f0aec13",
      "range": {
        "startLine": 31,
        "startChar": 2,
        "endLine": 32,
        "endChar": 17
      },
      "revId": "fb3d80dde6c6dc32b2f39c417c1323379124635b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
