      "writtenOn": "2022-01-18T02:46:23Z",
      "side": 1,
      "message": "What is the difference between AptxSinkBuffering and AptxAdaptiveTTP since they have very similar definitions?",
      "range": {
        "startLine": 31,
        "startChar": 2,
        "endLine": 32,
        "endChar": 17
      },
      "revId": "fb3d80dde6c6dc32b2f39c417c1323379124635b",
