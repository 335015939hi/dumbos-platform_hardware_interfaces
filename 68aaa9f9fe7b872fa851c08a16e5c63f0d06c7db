    },
    {
      "unresolved": true,
      "key": {
        "uuid": "061d108e_c0d59f1a",
        "filename": "security/authgraph/aidl/android/hardware/security/authgraph/KESignature.cddl",
        "patchSetId": 1
      },
      "lineNbr": 18,
      "author": {
        "id": 1678423
      },
      "writtenOn": "2023-09-14T16:47:29Z",
      "side": 1,
      "message": "Yes, in the key agreement protocol, the only thing signed is the session id. Therefore, we can rename it as you suggested. Thank you!",
      "parentUuid": "dc954cdf_d072a723",
      "range": {
        "startLine": 18,
        "startChar": 27,
        "endLine": 18,
        "endChar": 46
      },
