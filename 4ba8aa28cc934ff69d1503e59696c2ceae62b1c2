      "writtenOn": "2024-10-24T20:20:50Z",
      "side": 1,
      "message": "What is the kind of setup failure that you expect from the offload stack ?\nWhich part of the sequence do you find problematic exactly ?",
      "parentUuid": "18d03c39_26effab1",
      "range": {
        "startLine": 29,
        "startChar": 9,
