package android.hardware.fastboot@1.0;

enum Result : uint32_t {
    SUCCESS, // Operation completed without errors.
    NOT_SUPPORTED, // Unsupported argument or operation.
    FAILURE_UNKNOWN, // Operation failed due to unknown reason.
};

enum BootloaderVariable : uint32_t {
    VERSION_BASEBAND,
    VERSION_BOOTLOADER,
    PRODUCT_NAME,
    SERIAL_NUMBER,
    HW_REVISION,
    IS_SECURE,
    IS_UNLOCKED,
    OFF_CHARGE_MODE,
    VARIANT,
    BATTERY_VOLTAGE,
    BATTERY_SOC_OK,
    PARTITION_SIZE,
    PARTITION_TYPE,
    MAX_DOWNLOAD_SIZE,
    ERASE_BLOCK_SIZE,
    LOGICAL_BLOCK_SIZE,
    HAS_SLOT,
    CURRENT_SLOT,
    SLOT_COUNT,
};
