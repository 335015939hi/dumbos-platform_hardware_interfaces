package android.hardware.fastboot@1.0;

/**
 * IFastboot interface implements vendor specific fastboot commands.
 */

interface IFastboot {
    /**
     *  Return a bootloader variable, or all variables.
     *
     * @param variableName Name of the variable whose value will be returned.
     * @return value Value of the bootloader variable 'variableName'
     * @return result SUCCESS on success
     *                NOT_SUPPORTED if the variable is not supported
     */
    getBootloaderVariable(BootLoaderVariable variableName) generates(string value, Result result);

    /**
     * Sets the slot that will be booted on in the next boot attempt.
     * @param slot Slot that will be booted from the next boot attempt.
     * @return result SUCCESS on success
     *                NOT_SUPPORTED if the slot is invalid.
     */
    setActiveSlot(string slot) generates (Result result);

    /**
     * Reboots the device into fastboot mode.
     *
     */
    oneway rebootBootloader();

    /**
     * Sets the device into a flashable state.
     *
     * @return result Returns SUCCESS or FAILURE depending on the status of the
     * operation
     */
    setFlashingUnlock() generates (Result result);

    /**
     * Sets the device into a flashable state.
     *
     * @return result Returns SUCCESS or FAILURE depending on the status of the
     * operation
     */
    setFlashingLock() generates (Result result);

    /**
     * Set the device into a state where critical partitions(the ones needed to
     * boot to the bootloader) can be flashed. If a reboot is required to
     * accomplish this, the device will reboot back to fastboot.
     */
    oneway setFlashingUnlockCritical();

    /**
     * Sets the device into a state where critical partitions cannot be flashed.
     * If a reboot is required to accomplish this, it will reboot back into
     * fastboot
     */
    oneway setFlashingLockCritical();
};
