package android.hardware.fastboot@1.0;

import IFastbootCallback;
/**
 * IFastboot interface implements vendor specific fastboot commands.
 */

interface IFastboot {
    /**
     * Returns a bool indicating whether the bootloader is enforcing security
     * policies like boot verification.
     *
     * @return secureStatus True if the bootloader is enforcing security and
     * False otherwise.
     */
    getSecureStatus() generates (bool secureStatus);

    /**
     * Returns a bool indicating whether the device has been unlocked for
     * flashing using the fastboot command "flashing unlocked"
     *
     * @return unlockStatus True if the device has been unlocked for flashing
     * and False otherwise.
     */
    getFlashUnlockStatus() generates (bool unlockStatus);

    /**
     * Returns a bool indicating the off-mode-charge setting. If off-mode
     * charging is enabled, the device autoboots into a special mode when
     * power is applied.
     *
     * @return offModeChargeSetting True if the setting is enabled and False if
     * not.
     */
    getOffModeChargeSetting() generates (bool offModeChargeSetting);

    /**
     * Returns the current battery voltage.
     *
     * @return batteryVoltage Battery Voltage in mV.
     */
    getBatteryVoltage() generates (int32_t batteryVoltage);

    /**
     * Return a bool indicating if the battery voltage is sufficient
     * for flashing.
     *
     * @return status True if the battery voltage is acceptable
     * for flashing and false otherwise.
     */
    getBatteryFlashStatus() generates (bool status);

    /**
     * Returns the slot name that will be booted from next.
     *
     * @return slot SlotName that will be booted next.
     */
    getActiveSlot() generates (SlotName slot);

    /**
     * Returns the number of supported slots.
     *
     * @return slotCount Integer returning number of supported slots.
     */
    getSlotCount() generates (uint8_t slotCount);

    /**
     * Reboots the device into fastboot mode.
     *
     */
    rebootBootloader();

    /**
     * Lock/unlock the ability to flash the device.
     *
     * @param lockState Locks device flashing if set to true, unlocks if false.
     *
     * @return result Returns SUCCESS if the operation is successful,
     *                        FAILURE if unsuccessful,
     *                        NOT_SUPPORTED if the operation is not supported.
     */
    setFlashingLockState(bool lockState ) generates (Result result);

    /**
     * Lock or unlock flashing of critical partitions(the ones needed to boot to
     * the bootloader. If a reboot is required to
     * accomplish this, the device will reboot back to fastboot.
     *
     * @param lockState Locks the flashing of critical partitions if true,
     * unlocks if false.
     *
     * @return result Returns SUCCESS if the operation is successful,
     *                        FALIURE if unsuccessful,
     *                        NOT_SUPPORTED if the operation is not supported.
     */
    setCriticalFlashingLockState(bool lockState) generates (Result result);

    /**
     * Flash a partition with vendor logic or check vendor specific conditions
     * before flashing a partition. The HAL would have received the image to be
     * flashed by an earlier downloadImage() command.
     *
     * @param partitionName Name of the partition to be flashed.
     *
     * @return result Returns SUCCESS if the operation was successful,
     *                        INVALID_ARGUMENT if 'partitionName' is invalid,
     *                        FAILURE if the flash failed.
     */
    flashPartition(string partitionName) generates (Result result);

    /**
     * Erase a partion with vendor logic or check vendor specific conditions
     * before erasing a partition.
     *
     * @param partitionName Name of the partition to be erased.
     *
     * @return result Returns SUCCESS if the operation was successful,
     *                        INVALID_ARGUMENT if 'partitionName' is invalid,
     *                        FAILURE if the erase failed.
     */
    erasePartition(string partitionName) generates (Result result);

    /**
     * Enables/disables serial console for the device.
     *
     * @param uartState Enables serial console if True and disables it
     * otherwise.
     *
     * @return result Returns SUCCESS if the operation was successful,
     *                        FAILURE if unsuccessful,
     *                        NOT_SUPPORTED if the method is not supported.
     */
    setSerialConsoleState(bool uartState) generates (Result result);

    /**
     *
     * Returns the image that was last staged by a downloadImage() command.
     *
     * @return image Data that was last staged by a downloadImage() command
     * for eg. as a result of an 'oem stage' fastboot command.
     * @return result returns SUCCESS if the operation is successful,
     *                        FAILURE if unsuccessful,
     *                        NOT_SUPPORTED if the method is not supported.
     */
    uploadImage() generates (vec<uint8_t> image, Result result);

    /**
     *
     * Downloads an image file to be used for a succeeding command, for
     * eg. flashPartition()
     *
     * @return image Data to be used in a future operation like flashing.
     * @return result returns SUCCESS if the operation is successful,
     *                        FAILURE if unsuccessful,
     *                        NOT_SUPPORTED if the method is not supported.
     */
    downloadImage() generates (vec<uint8_t> image, Result result);

    /**
     * Opens the interface and provides the callback routines
     * to the implementation of this interface.
     *
     * @param callback Callback interface for IFastboot.
     * @return result returns SUCCESS if the operation is successful,
     *                        INVALID_ARGUMENT if 'callback' is invalid
     *                        FAILURE for other errors.
     */
    setCallback(IFastbootCallback callback) generates (Result result);
};
