package android.hardware.fastboot@1.0;

import IFastbootLogger;

/**
 * IFastboot interface implements vendor specific fastboot commands.
 */
interface IFastboot {
    /**
     * Returns a bool indicating whether the bootloader is enforcing verified
     * boot.
     *
     * @return secureStatus True if the bootloader is enforcing verified boot and
     *                      False otherwise.
     */
    isVerifiedBootEnabled() generates (bool verifiedBootState);

    /**
     * Returns a bool indicating the off-mode-charge setting. If off-mode
     * charging is enabled, the device autoboots into a special mode when
     * power is applied.
     *
     * @return offModeChargeState True if the setting is enabled and False if
     *                            not.
     */
    isOffModeChargeEnabled() generates (bool offModeChargeState);

    /**
     * Returns the minimum battery voltage required for flashing in mV.
     *
     * @return batteryVoltage Minimum batterery voltage (in mV) required for
     *                        flashing to be successful.
     */
    getBatteryVoltageFlashingThreshold() generates (uint32_t batteryVoltage);

    /**
     * Returns a bool indicating whether the device has been unlocked for
     * flashing using the fastboot command "flashing unlocked".
     *
     * @return lockStatus True if the device is locked for flashing
     *                    and False otherwise.
     */
    getFlashingLockState() generates (bool lockStatus);


    /**
     * Lock/unlock the ability to flash the device.
     *
     * @param lockState Locks device flashing if set to True, unlocks if False.
     *
     * @return result SUCCESS if the operation is successful,
     *                FAILURE if unsuccessful,
     *                NOT_SUPPORTED if the operation is not supported.
     */
    setFlashingLockState(bool lockState) generates (Result result);

    /**
     * Returns a bool indicating whether the critical partitions of the device
     * (needed to boot bootloader) are unlocked for flashing.
     *
     * @return lockStatus True if the critical partitions are locked
     *                    for flashing and False otherwise.
     */
    getCriticalFlashingLockState() generates (bool lockStatus);

    /**
     * Lock or unlock flashing of critical partitions needed to boot to
     * the bootloader. If a reboot is required to
     * accomplish this, the device must reboot back to fastboot.
     *
     * @param lockState Locks the flashing of critical partitions if true,
     *                  unlocks if false.
     *
     * @return result SUCCESS if the operation is successful,
     *                FALIURE if unsuccessful,
     *                NOT_SUPPORTED if the operation is not supported.
     */
    setCriticalFlashingLockState(bool lockState) generates (Result result);

    /**
     * Flash a partition with vendor logic or check vendor specific conditions
     * before flashing a partition.
     *
     * @param partitionName Name of the partition to be flashed.
     * @param image A native handle with one file descriptor to pass image
     *              data to be flashed.
     *
     * @return result SUCCESS if the operation was successful,
     *                INVALID_ARGUMENT if 'partitionName' is invalid,
     *                FAILURE if the flash failed.
     */
    flashPartition(string partitionName, handle image)
        generates (Result result);

    /**
     * Erase a partion with vendor logic or check vendor specific conditions
     * before erasing a partition.
     *
     * @param partitionName Name of the partition to be erased.
     *
     * @return result SUCCESS if the operation was successful,
     *                INVALID_ARGUMENT if 'partitionName' is invalid,
     *                FAILURE if the erase failed.
     */
    erasePartition(string partitionName) generates (Result result);

    /**
     * Enables/disables serial console for the device.
     *
     * @param uartState Enables serial console if True and disables it
     *                  otherwise.
     *
     * @return result SUCCESS if the operation was successful,
     *                FAILURE if unsuccessful,
     *                NOT_SUPPORTED if the method is not supported.
     */
    setSerialConsoleState(bool uartState) generates (Result result);

    /**
     * Opens the interface and provides the logger routines.
     * The previously registered callback must be replaced with
     * 'logger'.
     *
     * @param logger Logger interface for IFastboot.
     * @return result SUCCESS if the operation is successful,
     *                INVALID_ARGUMENT if 'logger' is invalid
     *                FAILURE for other errors.
     */
    setLogger(IFastbootLogger logger) generates (Result result);
};
