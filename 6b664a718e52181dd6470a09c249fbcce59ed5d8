    {
      "key": {
        "uuid": "2fe770ce_f47d3492",
        "filename": "identity/aidl/android/hardware/identity/HardwareInformation.aidl",
        "patchSetId": 3
      },
      "lineNbr": 45,
      "author": {
        "id": 1076971
      },
      "writtenOn": "2020-02-13T16:43:05Z",
      "side": 1,
      "message": "Document types are an ISO 18013-5 thing (and will be a ISO 23220-[1-5] thing too) and they\u0027re strings there. They\u0027re meant to be free-form and such that any organization (including companies or standards bodies) can define document types... for this, these ISO standards suggest to use reverse-DNS so IANA serves as the registrar to avoid collisions. For example, if I use Identity Credential for loyalty cards, I\u0027d use e.g. com.mycompany.super-savings-card as the document type. For Mobile Driving Licenses the document is (unsurprisingly) \"org.iso.18013.5.1.mDL\".\n\nWe\u0027re planning for docs at both s.a.c and d.a.c to highlight this.",
      "parentUuid": "65c37c0c_98ce9b28",
      "range": {
        "startLine": 45,
        "startChar": 20,
        "endLine": 45,
        "endChar": 34
      },
      "revId": "6b664a718e52181dd6470a09c249fbcce59ed5d8",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
