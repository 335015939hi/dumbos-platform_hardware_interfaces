      "side": 1,
      "message": "What is this?",
      "range": {
        "startLine": 230,
        "startChar": 44,
        "endLine": 230,
        "endChar": 74
      },
      "revId": "45cae2c1268eb98ab8a1a529a2b6a612817ca7a7",
