      "writtenOn": "2023-09-05T11:37:29Z",
      "side": 1,
      "message": "When we send burst command after closing the stream, it stops responding and test fails due to timeout.",
      "range": {
        "startLine": 4247,
        "startChar": 0,
        "endLine": 4251,
        "endChar": 0
      },
      "revId": "a9e240b3e26d62d9cfc0a5b930eb9a595393ab68",
