    },
    {
      "unresolved": true,
      "key": {
        "uuid": "f68c1525_f9a159d7",
        "filename": "audio/aidl/vts/VtsHalAudioCoreModuleTargetTest.cpp",
        "patchSetId": 1
      },
      "lineNbr": 4251,
      "author": {
        "id": 1042638
      },
      "writtenOn": "2023-09-05T23:29:16Z",
      "side": 1,
      "message": "This test does not make sense for the AIDL implementation. In the legacy (C API) implementation, the HAL was in the same process as the audioserver, thus the \"read\" and \"write\" methods were usual in-process method calls, and we could expect them to return an error after the stream was closed. Starting with HIDL, reads and writes are implemented via FMQ and a separate thread. When we close the stream, the thread exits, and the FMQ is released on the HAL side. However, it remains valid on the audioserver side (unfortunately, there is no ability in the FMQ to \"invalidate\" itself), so it can write into it and try to read from it, there just will be no response.",
      "parentUuid": "eb89ae82_55cc1867",
      "range": {
        "startLine": 4247,
        "startChar": 0,
        "endLine": 4251,
        "endChar": 0
      },
      "revId": "a9e240b3e26d62d9cfc0a5b930eb9a595393ab68",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
