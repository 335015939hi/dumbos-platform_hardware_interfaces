      },
      "writtenOn": "2019-08-30T22:33:54Z",
      "side": 1,
      "message": "nit: we have a similar variable called bytesPerStride in Mapper 3.0. It would be consistent to call this bytesPerStride as well.",
      "revId": "fd57a8232f51b61dc62ec447eb8302d79d7b8980",
