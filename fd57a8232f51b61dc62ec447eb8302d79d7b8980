        "id": 1073546
      },
      "writtenOn": "2019-08-30T22:33:54Z",
      "side": 1,
      "message": "We would like a field for the bits per element in the plane",
      "revId": "fd57a8232f51b61dc62ec447eb8302d79d7b8980",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
