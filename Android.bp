subdirs = [
    "*"
]

cc_defaults {
    name: "hidl_defaults",
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_defaults {
    name: "VtsHalTargetTestDefaults",
    defaults: ["hidl_defaults"],
    whole_static_libs: [
        "VtsHalHidlTargetTestBase",
        "libbase",
        "libcutils",
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libnativehelper",
        "libutils",
    ],
    shared_libs: [
        "libhwbinder",
    ],
    cflags: [
        "-O0",
        "-g",
    ],

}
