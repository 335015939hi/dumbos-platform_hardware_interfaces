      "writtenOn": "2023-01-25T21:06:43Z",
      "side": 1,
      "message": "Should this be `maxCompressionGainDb`? Does `peak` and `maximum` mean the same thing here? Maybe we can have both of these fields(compressionGain and targetLevel) named in a similar way.",
      "range": {
        "startLine": 75,
        "startChar": 8,
        "endLine": 75,
