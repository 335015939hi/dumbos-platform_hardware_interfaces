      "lineNbr": 174,
      "author": {
        "id": 1060151
      },
      "writtenOn": "2017-05-31T18:00:15Z",
      "side": 1,
      "message": "The field *must* be ignored, but shall we require it to be 0x7FFFFFFF? That would be consistent. It looks like I already added a comment to that effect in ril.h, so I\u0027ll add the same here. Done.",
      "parentUuid": "6edab384_00544fa7",
