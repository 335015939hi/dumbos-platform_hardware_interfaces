      "lineNbr": 178,
      "author": {
        "id": 1062130
      },
      "writtenOn": "2017-05-27T21:19:41Z",
      "side": 1,
      "message": "does this imply that a data call should be established for that APN if it isn\u0027t already?",
      "range": {
        "startLine": 178,
        "startChar": 47,
        "endLine": 178,
        "endChar": 90
      },
      "revId": "285644a6d7f111b626e4dd7d95e7fdbfaa505e5e",
