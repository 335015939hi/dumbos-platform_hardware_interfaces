      },
      "writtenOn": "2016-09-21T16:14:46Z",
      "side": 1,
      "message": "All of these constants are just used in this interface. Even though SSID \u0026 BSSID are passed on in other interfaces, this length declaration only needs to be here. This is only place where the setters for these exist and we only need these size checks in the setter.",
      "parentUuid": "70d83709_b02df103",
      "range": {
        "startLine": 20,
        "startChar": 7,
