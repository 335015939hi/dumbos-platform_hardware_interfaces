      "lineNbr": 41,
      "author": {
        "id": 1120458
      },
      "writtenOn": "2016-09-20T17:24:50Z",
      "side": 1,
      "message": "Are there a finite number of these?\n\nWould make sense to bake into the interface what possibilities there are (i.e. enum).",
      "range": {
        "startLine": 41,
        "startChar": 51,
        "endLine": 41,
        "endChar": 63
      },
      "revId": "4fdc07ca388482d26679d10104b19a070799b25c",
