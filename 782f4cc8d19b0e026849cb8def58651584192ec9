      "lineNbr": 79,
      "author": {
        "id": 1491204
      },
      "writtenOn": "2021-02-08T13:15:20Z",
      "side": 1,
      "message": "BTW, this remark gives full meaning to have the IAudioGain being merged in AudioHAL, handled by core framework and proposing registration API in java side (AudioManager) and native (AudioSystem)",
      "parentUuid": "749139ed_1e0c9d4f",
