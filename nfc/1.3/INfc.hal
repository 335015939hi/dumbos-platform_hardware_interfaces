package android.hardware.nfc@1.3;

import @1.0::NfcData;
import @1.2::INfc;

interface INfc extends @1.2::INfc {
    /**
     * Assign a vendor specific configuration name.
     *     assign the name of specific configs
     */
    setVendorConfigFileName(string name);
};
