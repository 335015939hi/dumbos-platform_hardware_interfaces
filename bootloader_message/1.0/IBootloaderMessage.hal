package android.hardware.bootloader_message@1.0;

interface IBootloaderMessage {

@callflow(next={"*"})
@entry
@exit
ReadBootloaderMessage() generates (MessageStatus status, Message message);

WriteBootloaderMessage(Message message) generates(MessageStatus status);

UpdateBootloaderMessageWithRecoveryOptions(vec<string> options, bool clear_fields) generates (MessageStatus status);

ReadWipePackage(uint32_t package_size) generates (MessageStatus status, vec<uint8_t> package_data);

WriteWipePackage(vec<uint8_t> package_data) generates (MessageStatus status);

};
