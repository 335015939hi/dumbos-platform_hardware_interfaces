      "side": 1,
      "message": "Can we clarify which pubkey would be used to validate the signature?  Is it the leaf of the identity?",
      "revId": "e1b88a4e2ed36b3f4a294982359f7253c88b9776",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
