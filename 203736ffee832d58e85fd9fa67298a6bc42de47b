        "id": 1678423
      },
      "writtenOn": "2024-11-07T20:27:15Z",
      "side": 1,
      "message": "I am resolving this assuming that you are okay to have it as it is, given that we have other AIDL interfaces which distinguish OOM errors from InternalError type. Please feel free to reopen if you have further concerns.",
      "parentUuid": "a4e3a546_d68f6377",
      "revId": "203736ffee832d58e85fd9fa67298a6bc42de47b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
