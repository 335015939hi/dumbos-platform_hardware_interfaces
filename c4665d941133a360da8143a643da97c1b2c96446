      },
      "writtenOn": "2023-05-04T08:19:14Z",
      "side": 1,
      "message": "e.g.,\n\n\nro.boot.vbmeta.digest\nro.boot.vbmeta.hash_alg: sha256\nro.boot.vbmeta.size",
      "parentUuid": "fbe39a96_4c6d83e9",
      "range": {
