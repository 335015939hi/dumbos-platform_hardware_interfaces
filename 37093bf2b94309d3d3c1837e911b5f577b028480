      },
      "lineNbr": 111,
      "author": {
        "id": 2016000
      },
      "writtenOn": "2024-02-01T21:54:15Z",
      "side": 1,
      "message": "Thanks for letting me know. My two cents for my intended use case is that it would be simpler and perhaps more flexible to have `calculateSharedKey` with a new key unwrap method instead.",
      "parentUuid": "abf56a5e_462b54c2",
      "range": {
        "startLine": 111,
        "startChar": 34,
        "endLine": 111,
        "endChar": 70
      },
