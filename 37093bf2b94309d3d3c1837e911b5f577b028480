      "writtenOn": "2024-01-02T22:17:15Z",
      "side": 1,
      "message": "Is some sort of key policy needed to prevent using `calculateSharedSecret` to re-derive the shared key externally? It seems like this issue might also affect the wrapping keys calculated by `secureKeyImport`.",
      "range": {
        "startLine": 102,
        "startChar": 0,
        "endLine": 103,
        "endChar": 85
      },
      "revId": "37093bf2b94309d3d3c1837e911b5f577b028480",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
