        "filename": "staging/security/see/hwcrypto/aidl/android/hardware/security/see/hwcrypto/IOpaqueKey.aidl",
        "patchSetId": 7
      },
      "lineNbr": 103,
      "author": {
        "id": 2016000
      },
      "writtenOn": "2024-01-02T23:00:37Z",
      "side": 1,
      "message": "I noticed this might already be controlled by `KeyPermissions.KEY_MANAGEMENT_KEY`.",
      "parentUuid": "3449ef85_d00faaa0",
      "range": {
        "startLine": 102,
        "startChar": 0,
        "endLine": 103,
        "endChar": 85
      },
      "revId": "37093bf2b94309d3d3c1837e911b5f577b028480",
