        "id": 2016000
      },
      "writtenOn": "2024-01-02T22:17:15Z",
      "side": 1,
      "message": "How is the encapsulated shared secret calculated? Do you think it would be simpler to pass the public key instead?",
      "range": {
        "startLine": 111,
        "startChar": 34,
        "endLine": 111,
        "endChar": 70
      },
      "revId": "37093bf2b94309d3d3c1837e911b5f577b028480",
