      },
      "lineNbr": 111,
      "author": {
        "id": 2016000
      },
      "writtenOn": "2024-01-10T20:12:33Z",
      "side": 1,
      "message": "Okay, I see what you mean. Are you planning to use a KEM with `secureKeyImport` as well?",
      "parentUuid": "474ed44c_c95581cb",
      "range": {
        "startLine": 111,
        "startChar": 34,
        "endLine": 111,
        "endChar": 70
      },
      "revId": "37093bf2b94309d3d3c1837e911b5f577b028480",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
