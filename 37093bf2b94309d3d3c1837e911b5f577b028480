        "id": 1942645
      },
      "writtenOn": "2024-01-31T20:43:35Z",
      "side": 1,
      "message": "Sorry for the delay on the response. Originally that was the plan, although after some internal discussion on the team we are trying to figure out if `secureKeyImport` as it is written is needed, or if it would be better to use a combination of `CalculateSharedKey`,with a new method that just symmetrically wraps the keys with this shared key.",
      "parentUuid": "13be5da7_0e9e39ec",
      "range": {
        "startLine": 111,
        "startChar": 34,
        "endLine": 111,
        "endChar": 70
      },
      "revId": "37093bf2b94309d3d3c1837e911b5f577b028480",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "5b7252a5_30cb6b7d",
        "filename": "staging/security/see/hwcrypto/aidl/android/hardware/security/see/hwcrypto/IOpaqueKey.aidl",
