        "id": 1942645
      },
      "writtenOn": "2024-01-31T20:43:35Z",
      "side": 1,
      "message": "more like the opaque key policy can be used to restrict which operations it can be used on.",
      "parentUuid": "814c6f65_f4b5060a",
      "range": {
        "startLine": 102,
        "startChar": 0,
        "endLine": 103,
        "endChar": 85
