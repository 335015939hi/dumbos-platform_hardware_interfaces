package android.hardware.bluetooth@1.0;

/* Implement a callback for HCI Events. */
import IBluetoothHciEvent;

/*
 * The Host Controller Interface (HCI) is the layer defined by the Bluetooth
 * specification between the software that runs on the host and the Bluetooth
 * controller chip.  This boundary is the natural choice for a Hardware
 * Abstraction Layer (HAL).  Dealing only in HCI packets and events simplifies
 * the stack and abstracts away power management, initialization, and other
 * implementation-specific details related to the hardware.
 */

interface IBluetoothHci {
    /*
     * Send an HCI packet.
     *
     * This method may queue packets and return immediately. The only
     * requirement is that the packets are executed in order.
     * @param packet is the HCI packet to be sent
     */
    sendHci(HciPacket packet);

    /*
     * Register the callback for sending HCI events.
     * It should only be called when the stack is initialized.  Calling this
     * function a second time will replace the previous callback.
     *
     * @param cb is an implementation of IBluetoothHciEvent
     */
    oneway registerEventCb(IBluetoothHciEvent cb);
};
