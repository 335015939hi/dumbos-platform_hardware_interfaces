package android.hardware.bluetooth.audio@2.0;

import IBluetoothAudioProvider;

/**
 * This factory allows a HAL implementation to be split in multiple
 * independent providers.
 *
 * When the HAL client is ready to create an audio session, first it
 * must obtain the IBluetoothAudioProvider provider for that session
 * by calling openProvider().
 * After that it can call IBluetoothAudioProvider.startSession() to
 * configure and start the actual session.
 */
interface IBluetoothAudioProvidersFactory {

    /**
     * Opens an audio provider for an audio session as specified by
     * the session type and the codec configuration as negotiated with the
     * remote device. To close the provider, it is necessary to release
     * references to the returned provider object.
     *
     * @param sessionType the session type (e.g., A2DP Software Encoding
     *    Datapath, A2DP Hardware Encoding Datapath, Hearing Aid Software
     *    Encoding Datapath).
     *
     * @return status one of the following
     *    SUCCESS if HAL server successfully opens the provider with the
     *        given session type and codec configuration
     *    UNSUPPORTED_CODEC_CONFIGURATION if HAL server cannot open the
     *        provider with the given session type and codec configuration
     *    FAILURE if HAL server cannot open the provider for any other
     *        reason
     * @return provider the provider of specified session type
     */
    openProvider(SessionType sessionType)
        generates (Status status, IBluetoothAudioProvider provider);
};
