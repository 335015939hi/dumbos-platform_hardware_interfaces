      "writtenOn": "2018-11-12T23:10:45Z",
      "side": 1,
      "message": "these are all synchronous, but they return results via a callback. Why not return the results in the return packet from this call directly?",
      "range": {
        "startLine": 43,
        "startChar": 4,
        "endLine": 43,
        "endChar": 15
