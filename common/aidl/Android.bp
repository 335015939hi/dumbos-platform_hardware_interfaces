aidl_interface {
    name: "android.hardware.common",
    host_supported: true,
    // TODO vendor_available needs to be false to be able to build -ndk interfaces?
    vendor_available: false,
    srcs: [
        "android/hardware/common/*.aidl",
    ],
    stability: "vintf",
    backend: {
        java: {
            enabled: false,
        },
        ndk: {
            apex_available: [
                "//apex_available:platform",
                "com.android.media.swcodec",
            ],
            min_sdk_version: "29",
            vndk: {
                enabled: true,
                support_system_process: true,
            },
        },
    },
}
